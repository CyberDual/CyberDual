        run = Path(run).resolve()
        rec = next((json.loads(l) for l in runs_file(run).read_text().splitlines()
                    if json.loads(l).get('command') == 'attack'), None) if runs_file(run).is_file() else None
        if rec is None:
            sys.exit(f'{run}: not a library attack run made by cyberdual attack (no attack record in cyberdual_runs.jsonl)')
        sources.append(dict(run=str(run), setup=rec['setup'], attacker=rec['attacker'], repo_commit=rec.get('repo_commit')))
        for cell in selected_valid(run):
            info = cell_info(cell)
            row = dict(cell=str(cell), setup=SETUP_NAME[rec['setup']], attacker=rec['attacker'], project=info['unit'].split('__')[0],
                       reviews={(rec.get('reviewer') or 'in-run') if k == 'in-run' else k: v for k, v in info['reviews'].items()})
            kind = 'multi' if rec['setup'] == 'split' else 'single'
            try:
                arec = ensure_record(cell)
                meta = exporter.export(cell, row, out / kind / cell.name, urls.get(row['project'], ''), labels_key='labels')
                shutil.copytree(cell / 'attack_record', out / kind / cell.name / 'attack_record', dirs_exist_ok=True)
                meta['attack_hash'] = arec['attack_hash']
                (out / kind / cell.name / 'meta.json').write_text(json.dumps(meta, indent=1) + '\n')
            except (RuntimeError, OSError, subprocess.CalledProcessError) as exc:
                failed.append(dict(cell=str(cell), error=str(exc)[:200]))
                continue
            index.append({k: meta[k] for k in ('id', 'kind', 'setup', 'attacker_model', 'project', 'labels', 'attack_hash')})
    out.mkdir(parents=True, exist_ok=True)
    (out / 'INDEX.jsonl').write_text(''.join(json.dumps(m) + '\n' for m in sorted(index, key=lambda m: m['id'])))
    counts = collections.Counter(f"{m['setup']}|{m['attacker_model']}" for m in index)
    (out / 'COUNTS.json').write_text(json.dumps(dict(total=len(index), by_setup_attacker=dict(sorted(counts.items())),
                                                     failed=failed), indent=1) + '\n')
    (out / 'BANK.json').write_text(json.dumps(dict(uid=uid, created_utc=datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).isoformat(timespec='seconds') + 'Z',
                                                   sources=sources, repo_commit=git_commit(), attacks=len(index)), indent=1) + '\n')
    print(f'bank {uid}: {len(index)} valid attacks -> {out}' + (f'; {len(failed)} failed' if failed else ''))
    return 1 if failed else 0


