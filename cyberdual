def base_env(args):
    """Protocol values always come from PROTOCOL; an inherited variable never changes them silently.
    Change one only with --set KEY=VALUE, which the run manifest records."""
    env = dict(os.environ)
    for k in PROTOCOL_KEYS:
        env[k] = PROTOCOL[k]
    env.setdefault('IMAGE', local_image(AGENT_IMAGE))
    env.setdefault('KEY_FILE', str(HOME_CFG / 'claude.key'))
    # cyberdual runs use their own egress firewall (network + proxy) with this repo's allow-list; the drivers
    # start it under NET/PROXY and attach agents through EGRESS_NET/EGRESS_PROXY, so keep the pairs equal.
    env.setdefault('EGRESS_NET', 'cyberdual_egress'); env.setdefault('EGRESS_PROXY', 'cyberdual_proxy')
    env['NET'], env['PROXY'] = env['EGRESS_NET'], env['EGRESS_PROXY']
    env['PAR'] = str(getattr(args, 'par', 1))
    env.setdefault('WINDOW_SNAPSHOT_DIR', str(ROOT / 'attack-bank' / 'windows'))
    env.setdefault('CYBERDUAL_TASKS_DIR', str(ROOT / 'attack-bank' / 'tasks'))   # host-side answer material (golden fix SHAs)   # frozen windows live in the checkout, not in _code
    # grading runs inside the grader image (harness/Dockerfile.grader) unless --host-grade is given
    env['GRADE_INDOCKER'] = '0' if getattr(args, 'host_grade', False) else '1'
    env['GRADE_IMAGE'] = getattr(args, 'grader_image', None) or env.get('GRADE_IMAGE') or local_image(GRADER_IMAGE)
    # gpac grades run in the agent image (harness/gpac_run.sh)
    env.setdefault('GPAC_IMAGE', env['IMAGE'])
    keys_from_env(env)
    for item in getattr(args, 'set', None) or []:
        k, _, v = item.partition('=')
        if not v:
            sys.exit(f'--set expects KEY=VALUE, got {item!r}')
        print(f'protocol override: {k}={v}', file=sys.stderr)
        env[k] = v
    return env


# key file variable -> (default file name, environment variables that may hold the key instead)
KEY_ENV = {'KEY_FILE': ('claude.key', ('ANTHROPIC_API_KEY', 'CLAUDE_CODE_OAUTH_TOKEN')),
           'KIMI_KEY_FILE': ('kimi.key', ('KIMI_API_KEY',)), 'ZAI_KEY_FILE': ('zai.key', ('ZAI_API_KEY',)),
           'GATEWAY_KEY_FILE': ('gateway.key', ('GATEWAY_API_KEY',))}
_KEY_TMP = []


def _key_tmpdir():
    """a private directory for keys taken from the environment (memory-backed when /dev/shm exists), removed at exit"""
    if not _KEY_TMP:
        import atexit
        import tempfile
        d = tempfile.mkdtemp(prefix='cyberdual-keys-', dir='/dev/shm' if os.path.isdir('/dev/shm') else None)
        atexit.register(shutil.rmtree, d, True)
        _KEY_TMP.append(Path(d))
    return _KEY_TMP[0]


def keys_from_env(env):
    """A key may come from an environment variable instead of a key file. The harness reads keys from files, so a key
    given only in the environment is written to a mode-600 file in a private temporary directory (never into the
    repo, an image, a log or the run manifest), and the file variable points at it. An existing key file wins."""
    for var, (name, sources) in KEY_ENV.items():
        f = Path(env.get(var, str(HOME_CFG / name)))
        val = next((env[s] for s in sources if env.get(s)), '')
        if val and not (f.is_file() and f.stat().st_size):
            f = _key_tmpdir() / name
            fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            os.write(fd, val.strip().encode()); os.close(fd)
            env[var] = str(f)
    codex = Path(env.get('CODEX_HOME_SRC', str(Path.home() / '.codex')))
    if env.get('OPENAI_API_KEY') and not (codex / 'auth.json').is_file():   # Codex API-key login, same format as `codex login --with-api-key`
        d = _key_tmpdir() / 'codex'
        d.mkdir(mode=0o700, exist_ok=True)
        fd = os.open(d / 'auth.json', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.write(fd, json.dumps({'auth_mode': 'apikey', 'OPENAI_API_KEY': env['OPENAI_API_KEY'].strip()}).encode()); os.close(fd)
        env['CODEX_HOME_SRC'] = str(d)


def review_key_file(env):
    """the credential a Claude reviewer uses: REVIEW_KEY_FILE (default ~/.config/cyberdual/review.key) when it is
    non-empty, else KEY_FILE (harness/review_cred.sh applies the same rule)"""
    f = Path(env.get('REVIEW_KEY_FILE', str(HOME_CFG / 'review.key')))
    return f if f.is_file() and f.stat().st_size else Path(env.get('KEY_FILE', ''))


def key_problem(model, env, role='attack'):
    p = provider(model)
    if p == 'claude':
        f = review_key_file(env) if role == 'review' else Path(env.get('KEY_FILE', ''))
        return None if f.is_file() and f.stat().st_size else f'no Claude credential in KEY_FILE ({f}) or ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN'
    if p == 'codex':
        f = Path(env.get('CODEX_HOME_SRC', str(Path.home() / '.codex'))) / 'auth.json'
        return None if f.is_file() else f'no Codex login at {f} (run `codex login`, set CODEX_HOME_SRC or OPENAI_API_KEY)'
    if p == 'grok' or (p == 'glm' and env.get('GLM_VIA') == 'gateway'):
        var, default = 'GATEWAY_KEY_FILE', 'gateway.key'
    else:
        var, default = ('KIMI_KEY_FILE', 'kimi.key') if p == 'kimi' else ('ZAI_KEY_FILE', 'zai.key')
    f = Path(env.get(var, str(HOME_CFG / default)))
    return None if f.is_file() and f.stat().st_size else f'no {p} key in {var} ({f}) or ' + {'KIMI_KEY_FILE': 'KIMI_API_KEY', 'ZAI_KEY_FILE': 'ZAI_API_KEY'}.get(var, 'GATEWAY_API_KEY')


CODE_DIRS = ('harness', 'roles', 'cyberdual-single')
CODE = None   # the frozen code snapshot this command runs from (set by freeze_code)


def freeze_code(out):
    """Run from a frozen copy of the code, so editing, pulling or mirroring the repo cannot change a job that is
    already running (bash reads a script while it runs). The copy lives in <out>/_code/<commit>-<content hash>/ and
    is shared by every command on that run folder with the same code. CYBERDUAL_NO_FREEZE=1 runs from the repo."""
    global H, CODE
    if os.environ.get('CYBERDUAL_NO_FREEZE') == '1':
        return None
    import hashlib
    skip = lambda p: '__pycache__' in p.parts or (len(p.parts) > 2 and p.parts[:2] == ('harness', 'tasks') and '__' in p.parts[2])
    files = sorted(p.relative_to(ROOT) for d in CODE_DIRS for p in (ROOT / d).rglob('*') if p.is_file())
    files = [f for f in files if not skip(f)]
    h = hashlib.sha256()
    for f in files:
        h.update(str(f).encode() + b'\0' + (ROOT / f).read_bytes())
    tag = f"{git_commit()[:12]}-{h.hexdigest()[:10]}"
    dest = Path(out).resolve() / '_code' / tag
    if not (dest / 'harness').is_dir():
        tmp = dest.parent / f'.{tag}.{os.getpid()}'
        for f in files:
            (tmp / f).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(ROOT / f, tmp / f)
        try:
            tmp.rename(dest)
        except OSError:          # another command froze the same code first
            shutil.rmtree(tmp, ignore_errors=True)
    H = dest / 'harness';     CODE = dict(snapshot=str(dest), tag=tag, files=len(files))
    print(f'code: frozen snapshot {dest} ({len(files)} files)')
    return CODE


def write_manifest(out, record):
    if CODE:
        record = dict(record, code=CODE)
    out.mkdir(parents=True, exist_ok=True)
    path = out / 'cyberdual_runs.jsonl'
    with path.open('a') as fh:
        fh.write(json.dumps(record) + '\n')


