                 'sm': ('ghcr.io/cyberdual/engine-sm-base:20260917', 'cyberdual-sm-base:latest')}


def cmd_engine(args):
    """the V8 / SpiderMonkey study (harness/engine/README.md)"""
    py = lambda script, *rest: subprocess.call([sys.executable, str(ENGINE_DIR / script), *rest])
    c = args.engine_cmd
    if c == 'score':
        return py('engine_score.py', *(['--json', args.json] if args.json else []))
    if c == 'verify-bank':
        return subprocess.call([sys.executable, str(H / 'bank_manifest.py'), 'check', str(ROOT / 'attack-bank' / 'engines')])
    if c == 'list':
        return py('engine_bank.py', 'list', *(['--engine', args.engine] if args.engine else []),
                  *(['--setup', 'multi_required' if args.setup == 'window' else args.setup] if args.setup else []))
    if c in ('verify', 'review'):
        out = ['--out', str(args.out or WORK / 'engine' / 'bank')]
        return py('engine_bank.py', c, *args.ids, *out, *(['--reviewer', args.reviewer] if c == 'review' else []),
                  *(['--keep-images'] if args.keep_images else []))
    if c == 'images':
        rc = 0
        for engine in (['v8', 'sm'] if args.engine in (None, 'both') else [args.engine]):
            published, local = ENGINE_IMAGES[engine]
            if args.pull:
                steps = [['docker', 'pull', published], ['docker', 'tag', published, local]]
            elif args.build:
                steps = [['bash', str(ENGINE_DIR / 'build_engine_base.sh'), engine]]
            else:
                steps = []
            steps.append(['bash', str(ENGINE_DIR / 'window_ops.sh'), 'substrate', engine])   # the frozen window image
            for cmd in steps:
                print(' '.join(cmd))
                if not args.dry_run and subprocess.call(cmd):
                    print(f'cyberdual engine images: {engine} failed at: {" ".join(cmd)}', file=sys.stderr)
                    rc = 1
                    break
        return rc
    if c == 'attack':
        env = dict(os.environ, VIPER_ENGINE_ATTACKER=args.attacker, VIPER_ENGINE_SETUPS=args.setup)
        if args.setup == 'window':
            cmd = [sys.executable, str(ENGINE_DIR / 'run_multi_quota.py'), '--engine', args.engine,
                   '--attacker', args.attacker, '--target', str(args.target)] + (['--outbase', str(args.out)] if args.out else [])
        else:
            claude = args.attacker.startswith('claude-') or os.environ.get('GLM_AGENT', 'claude-code') != 'codex' and \
                args.attacker.startswith(('glm-', 'kimi-', 'grok-'))
            cmd = [sys.executable, str(ENGINE_DIR / ('run_engine_single_claude.py' if claude else 'run_engine_single_topup.py')),
                   '--engine', args.engine]
            if args.out:
                env['CYBERDUAL_ENGINE_OUT'] = str(args.out)
        print(' '.join(cmd))
        return 0 if args.dry_run else subprocess.call(cmd, env=env, cwd=ROOT)
    return 2


