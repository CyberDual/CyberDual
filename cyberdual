def provider(model):
    m = model.lower()
    if re.match(r'(gpt-|gpt\d|o\d|codex)', m):
        return 'codex'
    if m.startswith('kimi-'):
        return 'kimi'
    if m.startswith(('glm-', 'glm', 'zai-')):
        return 'glm'
    if m.startswith('grok-'):
        return 'grok'
    return 'claude'


def suffix(model):
    return re.sub(r'[/:.]', '_', model)


def project_repos():
    out = {}
    for line in (H / 'per_commit_sizes.sh').read_text().splitlines():
        m = re.match(r'^([a-z][a-z0-9_-]*)\|(https?://[^|]+)\|([^|]+)\|', line)
        if m:
            out[m.group(1)] = m.group(2)
    return out


