def cmd_doctor(args):
    ok = True

    def check(name, good, detail=''):
        nonlocal ok
        ok &= bool(good)
        print(f"  [{'ok' if good else 'MISSING'}] {name}{(' - ' + detail) if detail else ''}")

    print('host tools:')
    for tool in ('docker', 'git', 'python3'):
        check(tool, shutil.which(tool))
    print('host build tools (only for --host-grade; grading otherwise runs in the grader image):')
    for tool in ('clang', 'cmake', 'meson', 'ninja', 'pkg-config', 'gdb', 'autoreconf'):
        print(f"  [{'ok' if shutil.which(tool) else '--'}] {tool}")
    print('docker image:')
    image = os.environ.get('IMAGE') or local_image(AGENT_IMAGE)
    iid = image_info(image)
    check(image, iid, iid[:19] if iid else 'run ./cyberdual build')
    if iid:
        v = subprocess.run(['docker', 'run', '--rm', '--network', 'none', image, 'sh', '-c',
                            'claude --version; codex --version'], capture_output=True, text=True).stdout.split('\n')
        cc = v[0].split()[0] if v and v[0] else '?'
        check(f'Claude Code {cc}', cc == PROTOCOL['PINNED_CLAUDE_CODE'],
              '' if cc == PROTOCOL['PINNED_CLAUDE_CODE'] else f"the protocol pins {PROTOCOL['PINNED_CLAUDE_CODE']}")
    gimg = os.environ.get('GRADE_IMAGE') or local_image(GRADER_IMAGE)
    gid = image_info(gimg)
    print('grader image (grading runs in it unless --host-grade):')
    check(gimg, gid, gid[:19] if gid else 'run ./cyberdual build --grader')
    env = base_env(argparse.Namespace(par=1))
    if args.models:
        print('credentials:')
        for m in args.models:
            prob = key_problem(m, env)
            check(f'{m} ({provider(m)})', prob is None, prob or '')
    if args.selftest:
        print('grader self-test (offline):')
        selftest = [str(H / 'attested' / 'selftest.py')]   # needs clang + gdb: in the grader image unless --host-grade setup
        if gid and os.environ.get('GRADE_INDOCKER', '1') == '1':
            r = subprocess.run(['docker', 'run', '--rm', '--network', 'none', '-v', f'{ROOT}:{ROOT}:ro', '-w', str(ROOT),
                                '-e', 'HOME=/tmp', gimg, 'python3', *selftest], capture_output=True, text=True)
        else:
            r = subprocess.run([sys.executable, *selftest], capture_output=True, text=True)
        tail = (r.stdout.strip().splitlines() or ['no output'])[-1]
        check('attested crash channel', r.returncode == 0 and 'passed' in tail, tail.strip())
        for where, tests in ((H, ['test_refusal', 'test_reviewer_diff_audit', 'test_agent_run_argv', 'test_cell_info', 'test_provider_quota']),
                             (H / 'engine', ['test_engine_protocol', 'test_engine_verdicts'])):
            r = subprocess.run([sys.executable, '-m', 'unittest', '-q', *tests], cwd=where, capture_output=True, text=True)
            last = (r.stderr.strip().splitlines() or ['no output'])[-1]
            check(f'unit tests in {where.relative_to(ROOT)}', r.returncode == 0, last)
    print('ready' if ok else 'fix the MISSING items above')
    return 0 if ok else 1


# ---------------------------------------------------------------------------------------------- build
def cmd_build(args):
    if args.pull:   # the published grader image instead of a local build, tagged with the local name cyberdual-grader
        image = args.image or PUBLISHED_GRADER
        rc = 0
        for cmd in (['docker', 'pull', image], ['docker', 'tag', image, args.tag or 'cyberdual-grader']):
            print(' '.join(cmd))
            rc = rc or (0 if args.dry_run else subprocess.call(cmd))
        return rc
    if args.runner:
        cmd = ['docker', 'build', '-t', args.tag or 'cyberdual-runner', '-f', str(H / 'Dockerfile.runner'), str(H)]
    elif args.grader:
        cmd = ['docker', 'build', '-t', args.tag or 'cyberdual-grader', '-f', str(H / 'Dockerfile.grader'), str(H)]
    else:
        cmd = ['docker', 'build', '-t', args.tag or AGENT_IMAGE, '--build-arg', f"CLAUDE_CODE_VERSION={PROTOCOL['PINNED_CLAUDE_CODE']}",
               '--build-arg', f"CODEX_VERSION={PROTOCOL['PINNED_CODEX']}", '-f', str(H / 'Dockerfile.agent'), str(H)]
    print(' '.join(cmd))
    return 0 if args.dry_run else subprocess.call(cmd)


def cmd_clean(args):
    """Remove what runs leave behind on this host: the egress proxy and token-meter containers (they restart with
    Docker until removed), the egress network, and this user's /tmp/cyberdual_* scratch. --images also removes the
    three images. Run outputs (--out folders, cyberdual-work/) are kept."""
    proxy = os.environ.get('EGRESS_PROXY', 'cyberdual_proxy')
    images = [AGENT_IMAGE, GRADER_IMAGE, 'cyberdual-runner']
    busy = []
    for img in images:
        r = subprocess.run(['docker', 'ps', '-q', '--filter', f'ancestor={img}'], capture_output=True, text=True)
        busy += r.stdout.split()
    if busy and not args.force:
        print(f'{len(busy)} CyberDual container(s) still running (docker ps --filter ancestor=...); '
              'stop the run first or pass --force', file=sys.stderr)
        return 1
    steps = [['docker', 'rm', '-f', *busy]] if busy else []
    gw_proxy = os.environ.get('GW_EGRESS_PROXY', 'cyberdual_gw_proxy')   # the gateway egress of grok-* / GLM_VIA=gateway
    steps += [['docker', 'rm', '-f', proxy, proxy + '_meter', gw_proxy, gw_proxy + '_meter'],
              ['docker', 'network', 'rm', os.environ.get('EGRESS_NET', 'cyberdual_egress')],
              ['docker', 'network', 'rm', os.environ.get('GW_EGRESS_NET', 'cyberdual_gw_egress')]]
    if args.images:
        steps.append(['docker', 'rmi', *images])
    for cmd in steps:
        print(' '.join(cmd))
        if not args.dry_run:
            subprocess.run(cmd, capture_output=True)
    uid = os.getuid()
    for t in sorted(Path('/tmp').glob('cyberdual_*')):
        try:
            if t.lstat().st_uid != uid:
                continue
        except OSError:
            continue
        print('rm -rf', t)
        if not args.dry_run:
            shutil.rmtree(t, ignore_errors=True) if t.is_dir() and not t.is_symlink() else t.unlink(missing_ok=True)
    return 0


# ---------------------------------------------------------------------------------------------- attack
def cmd_attack(args):
    setup = SETUPS[args.setup]
    if not args.dry_run:
        freeze_code(args.out)
    env = base_env(args)
    env.update(setup['env'])
    # attacks and reviews are separate steps by default: the in-run reviewer arm runs only with --with-review
    env.update(ATT_MODEL=args.attacker, REV=args.reviewer, OUTBASE=str(args.out), ARMS='shell' if args.with_review else '')
    for model in (args.attacker,) + ((args.reviewer,) if args.with_review else ()):
        prob = key_problem(model, env)
        if prob and not args.dry_run:
            sys.exit(f'cyberdual attack: {prob}')
    only = list(args.only or [])
    if not only and setup['kind'] == 'single':
        # every task, always: without a list the top-up only revisits tasks that already have a cell in --out
        only = sorted(f.stem for f in (ROOT / env.get('SEEDS_DIR', 'cyberdual-single/seeds')).glob('*.json'))
    if setup['kind'] == 'window' and not args.dry_run and env.get('WINDOW_SNAPSHOT') != 'none':
        # the frozen windows are release assets, not in git: fetch (or rebuild) the ones this run needs first
        wins = only or sorted(p.parent.name for p in Path(env['WINDOW_SNAPSHOT_DIR']).glob('*/window.json'))
        if subprocess.call([sys.executable, str(ROOT / 'harness' / 'window_snapshot.py'), 'ensure', *wins],
                           env=dict(os.environ, WINDOW_SNAPSHOT_DIR=env['WINDOW_SNAPSHOT_DIR'])):
            sys.exit('cyberdual attack: a window snapshot is missing; see above (./cyberdual window fetch <project>)')
    cmd = ['bash', str(H / setup['driver'])] + only
    for item in args.set or []:                    # --set may also override a setup value (e.g. TARGET)
        k, _, v = item.partition('=')
        env[k] = v
    shown = {k: env[k] for k in sorted(set(setup['env']) | set(PROTOCOL_KEYS) | {'ATT_MODEL', 'ARMS', 'OUTBASE', 'PAR', 'IMAGE'})}
    if args.with_review:
        shown['REV'] = env['REV']
    shown['grading'] = 'docker:' + env['GRADE_IMAGE'] if env.get('GRADE_INDOCKER') == '1' else 'host'
    print('plan:', json.dumps(dict(setup=args.setup, **shown), indent=1))
    print('command:', ' '.join(cmd))
    if args.dry_run:
        return 0
    write_manifest(args.out, dict(
        command='attack', setup=args.setup, kind=setup['kind'], attacker=args.attacker,
        reviewer=args.reviewer if args.with_review else None,
        only=args.only, overrides=args.set or [], env=shown, repo_commit=git_commit(), image_id=image_info(env['IMAGE']),
        started_utc=datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).isoformat(timespec='seconds') + 'Z'))
    rc = subprocess.call(cmd, env=env, cwd=ROOT)
    build_records(args.out)
    return rc


