    """the benchmark's attack bank: CYBERDUAL_BANK when set (another copy), else attack-bank/attacks"""
    return Path(os.environ.get('CYBERDUAL_BANK') or ROOT / 'attack-bank' / 'attacks').resolve()


BANK_DEFAULT = '@default'   # `--bank` given without a folder: the benchmark's attack bank


def bank_root(name=None):
    """the benchmark's attack bank (no name), or a bank folder (e.g. one written by `bank export`)."""
    if not name or name == BANK_DEFAULT:
        root = default_bank()
        if not (root / 'INDEX.jsonl').is_file():
            sys.exit(f'cyberdual: no attack bank at {root}: attack-bank/attacks/ ships with the repository '
                     '(check out the full repository, or set CYBERDUAL_BANK to a copy)')
        return root
    root = Path(name).resolve()
    if not (root / 'INDEX.jsonl').is_file():
        sys.exit(f'{root} is not a bank (no INDEX.jsonl)')
    return root


def bank_items(kinds, only, bank_set=None):
    """Library attacks of a bank."""
    root = bank_root(bank_set)
    rows = [json.loads(line) for line in (root / 'INDEX.jsonl').read_text().splitlines() if line.strip()]
    rows = [dict(r, root=str(root)) for r in rows if r['kind'] in kinds]
    if only:
        rows = [r for r in rows if r['id'] in set(only)]
    return rows


def bank_project(item_id):
    m = re.match(r'^(?:month|single|golden)_([a-z0-9_-]+?)(?:_vB_|__)', item_id)
    return m.group(1) if m else ''


CACHE = Path(os.environ.get('CYBERDUAL_CACHE') or Path.home() / '.cache' / 'cyberdual') / 'upstream'


def upstream_cache(project, repo_url, shas):
    """A bare clone of the project's upstream, fetched up to the given commits (shared by all cells)."""
    path = CACHE / f'{project}.git'
    if not path.is_dir():
        path.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(['git', 'clone', '-q', '--bare', repo_url, str(path)], check=True)
    for sha in shas:
        if subprocess.run(['git', '-C', str(path), 'cat-file', '-e', f'{sha}^{{commit}}'], capture_output=True).returncode:
            subprocess.run(['git', '-C', str(path), 'fetch', '-q', 'origin', sha], check=True)
    return path


def record_base_repo(cell, rec, repo_url):
    """Per-cell base repo for attack_record.py materialize: one branch (the record's base branch) at base_sha,
    objects borrowed from the shared upstream cache via alternates (materialize copies them out)."""
    cache = upstream_cache(rec['project'], repo_url, [rec['base_sha']])
    b = cell / '_base.git'
    if not b.is_dir():
        subprocess.run(['git', 'init', '-q', '--bare', str(b)], check=True)
        (b / 'objects' / 'info' / 'alternates').write_text(str(cache / 'objects') + '\n')
    subprocess.run(['git', '-C', str(b), 'update-ref', f"refs/heads/{rec['branches']['base']}", rec['base_sha']], check=True)
    return b


def materialize(row, out):
    """Turn one attack-bank instance into a run cell that rereview_any.sh can review and grade. An entry with an
    attack record becomes a records cell (the reviewer repo is materialized from the record at review time)."""
    src = Path(row['root']) / row['kind'] / row['id']
    meta = json.loads((src / 'meta.json').read_text())
    cell = out / row['id']
    if (src / 'attack_record' / 'record.json').is_file():
        rec = json.loads((src / 'attack_record' / 'record.json').read_text())
        if not (cell / 'attack_record' / 'record.json').is_file():
            cell.mkdir(parents=True, exist_ok=True)
            shutil.copytree(src / 'attack_record', cell / 'attack_record', dirs_exist_ok=True)
            shutil.copytree(src / 'oracle', cell / 'oracle', dirs_exist_ok=True)
            sg = dict(rec.get('series_grade') or {}, project=rec['project'], source='attack-bank', bank_id=row['id'],
                      attack_hash=rec['attack_hash'])
            (cell / 'series_grade_v3.json').write_text(json.dumps(sg, indent=1) + '\n')
        repo_url = meta.get('upstream_repo') or project_repos().get(rec['project'], '')
        record_base_repo(cell, rec, repo_url)
        return cell
    ho = cell / 'handoff'
    if (cell / 'series_grade_v3.json').is_file() and (ho / '.git').is_dir() and (cell / 'oracle').is_dir():
        return cell
    project = meta.get('project') if meta.get('setup') else bank_project(row['id'])   # older entries mislabel it
    repo = meta.get('upstream_repo') or project_repos().get(project)
    if not repo:
        raise RuntimeError(f"{row['id']}: unknown upstream repo for project {project!r}")
    base = meta.get('grade_base') or meta.get('base') or meta.get('parent')
    shutil.rmtree(cell, ignore_errors=True)
    ho.mkdir(parents=True)
    g = lambda *a: subprocess.run(['git', '-C', str(ho), *a], check=True, capture_output=True, text=True)
    g('init', '-q')
    g('fetch', '-q', repo, base)
    g('branch', '-f', meta['base_branch'], base)
    g('fetch', '-q', str(src / 'window.bundle'), 'refs/heads/*:refs/heads/*')
    g('checkout', '-q', meta['review_branch'])
    for b in g('for-each-ref', '--format=%(refname:short)', 'refs/heads').stdout.split():
        if b not in (meta['base_branch'], meta['review_branch']):
            g('branch', '-D', b)
    for p in ('FETCH_HEAD', 'logs', 'ORIG_HEAD'):
        shutil.rmtree(ho / '.git' / p, ignore_errors=True) if (ho / '.git' / p).is_dir() else (ho / '.git' / p).unlink(missing_ok=True)
    g('gc', '-q', '--prune=now')
    (cell / 'pocs').mkdir()
    if (src / 'oracle' / 'pocs').is_dir():
        # all of the attacker's PoC files; selection.json names the credited one, as in the original cell
        for f in (src / 'oracle' / 'pocs').iterdir():
            shutil.copy2(f, cell / 'pocs' / f.name)
        name = Path(meta['credited_poc']).name
        (cell / 'selection.json').write_text(json.dumps({'pocs': [{'input': f'pocs/{name}'}]}) + '\n')
    else:
        shutil.copy2(src / 'oracle' / 'poc.c', cell / 'pocs' / ('residual.c' if row['kind'] == 'single' else 'probe.c'))
    # host-side answer key for `cyberdual verify`; a reviewer only ever receives a copy of handoff/
    shutil.copytree(src / 'oracle', cell / 'oracle')
    grade = dict(outcome='VALID_SERIES', project=project, source='attack-bank', bank_id=row['id'],
                 attacker_model=meta.get('attacker_model'), setup=meta.get('setup') or meta.get('arm'),
                 labels=meta.get('labels'))
    grade['parent' if row['kind'] == 'single' else 'base'] = base
    (cell / 'series_grade_v3.json').write_text(json.dumps(grade, indent=1) + '\n')
    return cell



# ---------------------------------------------------------------------------------------------- review
SUBSETS = {'windows': 'multi_required', 'fix-in-hand': 'single_golden_given', 'task-only': 'single_from_scratch'}


def pick_rows(rows, subset, limit):
    """--subset keeps one setup of the bank (INDEX.jsonl `setup`); --limit N keeps N attacks, stratified and
    deterministic: attacks sorted by id within each (setup, project) group, then taken round-robin over the groups,
    alternating setups (each setup's projects in name order), so a small N still covers every setup and library."""
    if subset and subset != 'all':
        rows = [r for r in rows if r.get('setup') == SUBSETS[subset]]
    if not limit:
        return rows
    groups = {}
    for r in sorted(rows, key=lambda r: r['id']):
        groups.setdefault((r.get('setup', ''), r.get('project', '')), []).append(r)
    rank = {k: sorted(p for s, p in groups if s == k[0]).index(k[1]) for k in groups}
    order = [groups[k] for k in sorted(groups, key=lambda k: (rank[k], k[0]))]
    picked = []
    while len(picked) < limit and any(order):
        for g in order:
            if g and len(picked) < limit:
                picked.append(g.pop(0))
    return sorted(picked, key=lambda r: r['id'])


def reviewer_setup(args, env):
    """--reviewer is a model id (harness inferred from it, as in the reference runs), or a harness: claude-code / codex
    with --model, or custom with --cmd. Sets args.reviewer to the reviewer's name (the grade-file suffix)."""
    h = args.reviewer
    if h in ('claude-code', 'codex'):
        if not args.model:
            sys.exit(f'cyberdual review --reviewer {h} needs --model <model id>')
        if (provider(args.model) == 'codex') != (h == 'codex'):
            sys.exit(f'cyberdual review: model {args.model} runs under {"codex" if provider(args.model) == "codex" else "claude-code"}, not {h}')
        args.reviewer = args.model
    elif h == 'custom':
        if not args.custom_cmd:
            sys.exit("cyberdual review --reviewer custom needs --cmd '<shell command>'")
        args.reviewer = 'custom' + (f'-{args.model}' if args.model else '')
        env.update(CYBERDUAL_REVIEW_CMD=args.custom_cmd, EGRESS='0', CYBERDUAL_CUSTOM_NETWORK='1' if args.allow_network else '0',
                   CYBERDUAL_CUSTOM_ENV=' '.join(args.custom_env or []))
        if args.custom_mount:
            env['CYBERDUAL_CUSTOM_MOUNT'] = str(Path(args.custom_mount).resolve())
        if args.custom_image:
            env['CYBERDUAL_CUSTOM_IMAGE'] = args.custom_image
    elif args.model or args.custom_cmd:
        sys.exit('cyberdual review: --model / --cmd go with --reviewer claude-code|codex|custom')
    if h != 'custom' and (args.allow_network or args.custom_env or args.custom_mount or args.custom_image):
        sys.exit('cyberdual review: --allow-network / --custom-* go with --reviewer custom')
    env['REV'] = args.reviewer
    return h


def cmd_review(args):
    if not args.run and not args.bank:
        args.bank = BANK_DEFAULT  # default: the benchmark's attack bank
    env = base_env(args)
    harness = reviewer_setup(args, env)
    if args.bank:
        bank_root(args.bank)   # stops early when the bank is missing
    if args.bank and not args.out:
        args.out = WORK / f'review_{suffix(args.reviewer)}'   # fixed per reviewer, so re-running resumes
    if not args.dry_run:
        freeze_code(args.out or args.run)
    prob = None if harness == 'custom' else key_problem(args.reviewer, env, role='review')
    if prob and not args.dry_run:
        sys.exit(f'cyberdual review: {prob}')
    if args.bank:
        out = Path(args.out)
        if not args.dry_run:
            out.mkdir(parents=True, exist_ok=True)
        rows = pick_rows(bank_items(args.kinds, args.only, args.bank), args.subset, args.limit)
        cells = [] if args.dry_run else [(r, out / r['id']) for r in rows]   # rebuilt lazily by each worker
        names = [r['id'] for r in rows]
    else:
        cells = [(None, c) for c in selected_valid(args.run) if not args.only or c.name in set(args.only)]
        names = [c.name for _, c in cells]
        out = Path(args.run)
    suf = suffix(args.reviewer)

    def reviewed(c):   # a grader failure or a provider quota stop is not a review: run it again
        g = c / f'review_grade_{suf}_shell.json'
        try:
            return g.is_file() and json.loads(g.read_text()).get('outcome') not in ('GRADER_ERROR', 'UNGRADED', 'REVIEWER_INFRA_FAILURE', 'PROVIDER_QUOTA')
        except ValueError:
            return False
    todo = [(r, c) for r, c in cells if not reviewed(c)]
    print(f"reviewer {args.reviewer} ({'custom command' if harness == 'custom' else provider(args.reviewer)}): {len(names)} valid attacks, "
          f'{len(names) - len(todo) if cells else 0} already reviewed')
    if args.dry_run:
        print('would review:', *names[:20], '...' if len(names) > 20 else '', sep='\n  ')
        return 0
    write_manifest(out, dict(command='review', reviewer=args.reviewer, source='bank' if args.bank else str(args.run),
                             harness=harness if harness in ('claude-code', 'codex', 'custom') else None,
                             bank=str(bank_root(args.bank)) if args.bank else None, subset=args.subset, limit=args.limit,
                             custom=dict(cmd=args.custom_cmd, allow_network=args.allow_network, mount=env.get('CYBERDUAL_CUSTOM_MOUNT'),
                                         env_names=args.custom_env or [], image=env.get('CYBERDUAL_CUSTOM_IMAGE') or env['IMAGE'])
                             if harness == 'custom' else None,
                             n=len(todo), overrides=args.set or [], env={k: env[k] for k in PROTOCOL_KEYS + ('IMAGE',)},
                             grading='docker:' + env['GRADE_IMAGE'] if env.get('GRADE_INDOCKER') == '1' else 'host',
                             credential_file=str(review_key_file(env)) if provider(args.reviewer) == 'claude' and harness != 'custom' else None,
                             repo_commit=git_commit(), image_id=image_info(env['IMAGE']),
                             started_utc=datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None).isoformat(timespec='seconds') + 'Z'))

    quota = threading.Event()   # set once a review stops on a long provider limit: start no more reviews

    def one(item):
        row, cell = item
        if quota.is_set():
            return cell.name, 0, 'NOT_STARTED (provider quota)'
        if row is not None:
            try:
                cell = materialize(row, out)
            except (RuntimeError, OSError, subprocess.CalledProcessError) as exc:
                return cell.name, 3, f'MATERIALIZE_FAILED: {exc}'[:200]
        log = cell / f'review_{suf}.log'
        cenv = dict(env)
        if (cell / 'attack_record' / 'record.json').is_file():
            # the one artifact contract: reviewer repo materialized from the record, grade from its trees
            cenv['RECORDS'] = '1'
            if (cell / '_base.git').is_dir():
                cenv['RECORD_BASE_REPO'] = str(cell / '_base.git')
        cmd = ['bash', str(H / 'rereview_any.sh'), str(cell)]
        with log.open('w') as fh:
            rc = subprocess.call(cmd, env=cenv, cwd=ROOT, stdout=fh, stderr=subprocess.STDOUT)
        g = cell / f'review_grade_{suf}_shell.json'
        outcome = json.loads(g.read_text()).get('outcome') if g.is_file() else 'NO_GRADE'
        if outcome == 'PROVIDER_QUOTA':
            quota.set()
        return cell.name, rc, outcome

    failed = []
    with cf.ThreadPoolExecutor(max_workers=args.par) as pool:
        for name, rc, outcome in pool.map(one, todo):
            print(f'  {name}: {outcome} (rc={rc})')
            if outcome in ('REVIEWER_INFRA_FAILURE', 'GRADER_ERROR', 'UNGRADED', 'NO_GRADE') or str(outcome).startswith('MATERIALIZE_FAILED'):
                failed.append(name)
    if quota.is_set():
        print('stopped on a provider usage limit (the reset time is in the cell logs); re-run the same command after the reset to resume')
        return 75
    if failed:
        print(f'{len(failed)} review(s) did not run or could not be graded (unscored); see {out}/<id>/review_{suf}.log, '
              'fix the cause, and re-run the same command to retry them', file=sys.stderr)
        return 3
    return 0


