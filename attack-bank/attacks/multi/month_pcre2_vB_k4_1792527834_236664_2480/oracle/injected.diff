-        pmatch[i].rm_eo = (int)(ovector[i * 2 + 1] + so);
+        pmatch[i].rm_so = (int)ovector[i * 2];
+        pmatch[i].rm_eo = (int)ovector[i * 2 + 1];
       }
     }
 
