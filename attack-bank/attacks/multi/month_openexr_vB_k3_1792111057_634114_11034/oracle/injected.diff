+//
+// read one frequency-rank and turn it into an index in the string table
+//
+size_t
+mappedStringIndex (
+    const vector<int>& mapping,
+    size_t             indexLimit,
+    const char*&       readPtr,
+    const char*        endPtr)
+{
+    uint64_t rank = readVariableLengthInteger (readPtr, endPtr);
+
+    if (rank >= indexLimit)
+    {
+        throw IEX_NAMESPACE::InputExc ("Bad string index in IDManifest");
+    }
+
+    return (size_t) mapping[(size_t) rank];
+}
+
