diff --git a/src/knownhost.c b/src/knownhost.c
index c9851b5..eca39a0 100644
--- a/src/knownhost.c
+++ b/src/knownhost.c
@@ -541,6 +541,11 @@ static int knownhost_ipv6_part(const char *host, const char **address,
         *suffix = host + *address_len;
     }
 
+    /* reject absurdly long literals early; no valid IPv6 address needs
+       anywhere close to this many characters */
+    if(*address_len > 64)
+        return 0;
+
     return 1;
 }
 
@@ -552,6 +557,8 @@ static int knownhost_plain_match(const char *host, const char *known)
     const char *known_suffix;
     size_t host_len;
     size_t known_len;
+    char host_buf[46];
+    char known_buf[46];
     unsigned char host_binary[16];
     unsigned char known_binary[16];
 
@@ -567,8 +574,15 @@ static int knownhost_plain_match(const char *host, const char *known)
        strcmp(host_suffix, known_suffix))
         return 0;
 
-    if(!knownhost_parse_ipv6(host_address, host_len, host_binary) ||
-       !knownhost_parse_ipv6(known_address, known_len, known_binary))
+    /* parse from a local null-terminated copy rather than threading an
+       explicit length through the helpers below */
+    memcpy(host_buf, host_address, host_len);
+    host_buf[host_len] = '\0';
+    memcpy(known_buf, known_address, known_len);
+    known_buf[known_len] = '\0';
+
+    if(!knownhost_parse_ipv6(host_buf, host_len, host_binary) ||
+       !knownhost_parse_ipv6(known_buf, known_len, known_binary))
         return 0;
 
     return !memcmp(host_binary, known_binary, sizeof(host_binary));
