diff --git a/lib/mprintf.c b/lib/mprintf.c
index 571c417..83b0c54 100644
--- a/lib/mprintf.c
+++ b/lib/mprintf.c
@@ -673,7 +673,7 @@ static bool stream_run(void *userp,
                        mp_streamn streamn,
                        const unsigned char *buf, size_t len, int *donep)
 {
-  if(!len)
