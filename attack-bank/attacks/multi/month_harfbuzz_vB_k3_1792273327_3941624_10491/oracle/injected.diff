diff --git a/src/hb-gpu-paint.hh b/src/hb-gpu-paint.hh
index 554a1159c..ab563d242 100644
--- a/src/hb-gpu-paint.hh
+++ b/src/hb-gpu-paint.hh
@@ -280,6 +280,18 @@ struct hb_gpu_paint_t
     return true;
   }
 
+  bool push_gradient_sub_blob (hb_blob_t *blob,
+			       unsigned header_words,
+			       unsigned stop_count)
+  {
+    unsigned len = (header_words + stop_count * 8) * sizeof (int16_t);
+    if (unlikely (len > HB_GPU_PAINT_MAX_SUB_BYTES - sub_bytes ||
+		  !sub_blobs.push_or_fail (blob)))
+      return false;
+    sub_bytes += len;
+    return true;
+  }
+
   /* Nesting depth of push_group / pop_group.  We bail (set
    * `unsupported`) if it exceeds HB_GPU_PAINT_MAX_GROUP_DEPTH,
    * which matches HB_GPU_PAINT_GROUP_DEPTH in the fragment shader. */
