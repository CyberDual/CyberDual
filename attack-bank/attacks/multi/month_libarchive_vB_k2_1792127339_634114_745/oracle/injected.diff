 			*p = '\0';
@@ -548,8 +605,13 @@ ar_parse_gnu_filename_table(struct archive_read *a)
 	if (p != ar->strtab + size && *p != '\n' && *p != '`' && *p != '\0')
 		goto bad_string_table;
 
-	/* Enforce zero termination. */
-	ar->strtab[size - 1] = '\0';
+	/*
+	 * GNU ar overwrites the pad so the image is terminated.
+	 * Windows tables are already NUL-separated; overwriting
+	 * the pad would replace a byte lib.exe keeps.
+	 */
+	if (!windows || memchr(ar->strtab, '\0', size) == NULL)
+		ar->strtab[size - 1] = '\0';
 
 	return (ARCHIVE_OK);
 
