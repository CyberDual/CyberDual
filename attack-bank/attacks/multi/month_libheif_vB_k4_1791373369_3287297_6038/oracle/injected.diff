+  // A Cb/Cr plane must have the chroma-subsampled size of the logical image (round_up),
+  // the invariant has_standard_plane_sizes() and check_plane_layout() enforce elsewhere.
+  // Building one at a smaller size makes the plane's actual allocation disagree with the
+  // size that code derives from the logical image dimensions, which caused out-of-bounds
+  // reads during RGB conversion (issue #1796). Reject an undersized plane at construction
+  // so the inconsistent image cannot be built in the first place. A plane padded up to the
+  // next even width/height is still accepted: some producers round chroma planes up to an
+  // even stride for SIMD-friendly access, one row/column past the subsampled size. Only
   // Cb/Cr are constrained; alpha, depth, disparity and other auxiliary planes may
   // legitimately have a size that differs from the colour planes.
   if (channel == heif_channel_Cb || channel == heif_channel_Cr) {
     uint32_t expected_width, expected_height;
     get_subsampled_size(m_width, m_height, channel, m_chroma, &expected_width, &expected_height);
 
-    if (width != expected_width || height != expected_height) {
+    uint32_t max_width = (expected_width + 1) & ~static_cast<uint32_t>(1);
+    uint32_t max_height = (expected_height + 1) & ~static_cast<uint32_t>(1);
+
+    if (width < expected_width || width > max_width ||
+        height < expected_height || height > max_height) {
