+TEST_CASE("extend_to_size_with_zero rejects a plane taller than the new target") {
+  auto* limits = heif_get_global_security_limits();
+
+  // 4:2:0 chroma subsamples the Cb/Cr plane height by two; build a Cb plane
+  // that is already taller than any subsampled height the target below implies.
+  auto image = std::make_shared<HeifPixelImage>();
+  image->create(12, 8, heif_colorspace_YCbCr, heif_chroma_420);
+  REQUIRE(image->add_channel(heif_channel_Y, 12, 8, 8, limits).error_code == heif_error_Ok);
+  REQUIRE(image->add_channel(heif_channel_Cb, 6, 40, 8, limits).error_code == heif_error_Ok);
+
+  // The logical width grows and the height is unchanged, so the whole-image
+  // guard above does not reject this call; the Cb plane's subsampled height
+  // (4) is still far smaller than its actual height (40).
+  Error err = image->extend_to_size_with_zero(24, 8, limits);
+  REQUIRE(err.error_code == heif_error_Usage_error);
+  REQUIRE(err.sub_error_code == heif_suberror_Invalid_parameter_value);
+}
