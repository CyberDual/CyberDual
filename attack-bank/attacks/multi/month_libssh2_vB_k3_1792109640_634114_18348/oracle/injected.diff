@@ -419,12 +419,21 @@ static int knownhost_parse_ipv4(const char *src, const char *end,
     return 1;
 }
 
+/* 128-bit address, optional zone identifier and a trailing NUL.
+   Zone ids longer than KNOWNHOST_IPV6_ZONE_MAX are rejected. */
+#define KNOWNHOST_IPV6_ADDRLEN  16
+#define KNOWNHOST_IPV6_ZONE_MAX 32
+#define KNOWNHOST_IPV6_BINLEN \
+    (KNOWNHOST_IPV6_ADDRLEN + KNOWNHOST_IPV6_ZONE_MAX + 1)
+
 static int knownhost_parse_ipv6(const char *src, size_t len,
-                                unsigned char result[16])
+                                unsigned char *result)
 {
     unsigned short words[8];
     const char *p = src;
     const char *end = src + len;
+    const char *zone = NULL;
+    size_t zone_len = 0;
     size_t count = 0;
     int compressed = -1;
     size_t i;
@@ -475,6 +484,12 @@ static int knownhost_parse_ipv6(const char *src, size_t len,
 
         if(p == end)
             break;
+        /* RFC 4007 zone id, e.g. fe80::1%eth0 */
+        if(*p == '%') {
+            zone = p + 1;
+            zone_len = (size_t)(end - zone);
+            break;
+        }
         if(*p != ':')
             return 0;
 
@@ -511,6 +526,13 @@ static int knownhost_parse_ipv6(const char *src, size_t len,
         result[i * 2 + 1] = (unsigned char)words[i];
     }
 
+    if(zone) {
+        if(zone_len > KNOWNHOST_IPV6_ZONE_MAX)
+            return 0;
+        memcpy(result + KNOWNHOST_IPV6_ADDRLEN, zone, zone_len);
+        result[KNOWNHOST_IPV6_ADDRLEN + zone_len] = '\0';
+    }
+
     return 1;
 }
 
@@ -552,8 +574,8 @@ static int knownhost_plain_match(const char *host, const char *known)
     const char *known_suffix;
     size_t host_len;
     size_t known_len;
-    unsigned char host_binary[16];
-    unsigned char known_binary[16];
+    unsigned char host_binary[KNOWNHOST_IPV6_BINLEN];
+    unsigned char known_binary[KNOWNHOST_IPV6_BINLEN];
 
     if(!strcmp(host, known))
         return 1;
@@ -567,6 +589,9 @@ static int knownhost_plain_match(const char *host, const char *known)
        strcmp(host_suffix, known_suffix))
         return 0;
 
+    memset(host_binary, 0, sizeof(host_binary));
+    memset(known_binary, 0, sizeof(known_binary));
+
     if(!knownhost_parse_ipv6(host_address, host_len, host_binary) ||
