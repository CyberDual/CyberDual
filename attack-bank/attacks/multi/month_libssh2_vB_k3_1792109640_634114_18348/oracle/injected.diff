@@ -878,6 +903,26 @@ static int knownhost_line_legacy(LIBSSH2_KNOWNHOSTS *hosts,
             memcpy(hostbuf, name, namelen);
             hostbuf[namelen] = '\0';
 
+            /* '%' introduces an IPv6 zone id (RFC 4007). Keep it only when
+               the name is a real IPv6 literal; anything else is rejected. */
+            if(memchr(hostbuf, '%', namelen)) {
+                unsigned char *parsed;
+
+                parsed = SSH2_ALLOC(hosts->session, 16);
+                if(!parsed)
