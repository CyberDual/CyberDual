+/* Parse from a private copy of the address bytes so a bracket, port or
+   comma that follows the token cannot be consumed as part of the literal. */
+static int knownhost_parse_ipv6_span(LIBSSH2_SESSION *session,
+                                     const char *address, size_t len,
+                                     unsigned char result[16])
+{
+    char *span;
+    int rc;
+
+    if(!len)
+        return 0;
+
+    span = SSH2_ALLOC(session, len);
+    if(!span)
+        return 0;
+
+    memcpy(span, address, len);
+    rc = knownhost_parse_ipv6(span, len, result);
+    SSH2_FREE(session, span);
+    return rc;
+}
