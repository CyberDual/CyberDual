+/* cell_add() without the reject.  The unclipped walk has already kept
+ * the column inside the scratch row, which is one past the logical
+ * width so an edge ending on the right pixel boundary does not take
+ * the clip path.  That extra column is not painted. */
+template <typename Area, typename Cover>
+static HB_ALWAYS_INLINE void
+cell_add_fast (Area *area, Cover *cover, unsigned width, int col,
+	       int32_t fx0, int32_t fy0, int32_t fx1, int32_t fy1, int32_t wind,
+	       unsigned &x_min, unsigned &x_max)
+{
+  int32_t dy = fy1 - fy0;
+  area[col]  += (Area) (fx0 + fx1) * dy * wind;
+  cover[col] += (Cover) (dy * wind);
+  if ((unsigned) col < width)
+  {
+    x_min = hb_min (x_min, (unsigned) col);
+    x_max = hb_max (x_max, (unsigned) col);
+  }
+}
+
+/* Columns the unclipped sweep may visit.  The image row is stored
+ * stride-aligned ((width + 3) & ~3, see hb_raster_draw_render), and
+ * cell_add() rejects anything past the logical width, so walking the
+ * padding columns does not change coverage — it only avoids the clip
+ * setup when an edge merely touches that alignment. */
+static inline unsigned
+raster_unclipped_columns (unsigned width)
+{
+  return (width + 3u) & ~3u;
+}
