diff --git a/src/liblzma/common/alone_decoder.c b/src/liblzma/common/alone_decoder.c
index 174b3b1..d331421 100644
--- a/src/liblzma/common/alone_decoder.c
+++ b/src/liblzma/common/alone_decoder.c
@@ -155,7 +155,15 @@ alone_decode(void *coder_ptr, const lzma_allocator *allocator,
 		const lzma_ret ret = lzma_next_filter_init(&coder->next,
 				allocator, filters);
 		if (ret != LZMA_OK) {
-			lzma_next_end(&coder->next, allocator);
+			// An allocation failure leaves the sub-coder in a
+			// reusable state and the application may retry the
+			// initialization after more memory is available, so
+			// the cleanup isn't needed in that case. Any other
+			// failure means that the sub-coder may be in an
+			// unknown state and thus it must be freed.
+			if (ret != LZMA_MEM_ERROR)
+				lzma_next_end(&coder->next, allocator);
+
 			return ret;
 		}
 
