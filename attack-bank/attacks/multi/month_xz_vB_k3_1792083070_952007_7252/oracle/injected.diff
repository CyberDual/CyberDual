+		uint8_t *dict_buf = lzma_alloc(alloc_size + LZ_DICT_EXTRA,
+				allocator);
+		if (dict_buf == NULL) {
+			// Store the new size already now. This way a reinit
+			// attempt with this same dictionary size won't
+			// repeat an allocation that is known to fail.
+			coder->dict.size = alloc_size;
+			return LZMA_MEM_ERROR;
