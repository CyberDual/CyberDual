diff --git a/src/dec/alpha_dec.c b/src/dec/alpha_dec.c
index 9fb1448..832861b 100644
--- a/src/dec/alpha_dec.c
+++ b/src/dec/alpha_dec.c
@@ -140,9 +140,17 @@ int WebPGetAlphaWindowRows(const VP8Decoder* const dec, const VP8Io* const io) {
   // pixel rows held back from the previous macroblock row plus all 16 pixel
   // rows of the last macroblock row (24 pixel rows total), while retaining 1
   // preceding row (row - 1) for spatial unfiltering and fancy upsampling.
-  return (dec->alpha_dithering > 0)
-             ? height
-             : VP8LGetWindowRows(width, height, /*max_history_rows=*/25);
+  if (dec->alpha_dithering > 0) return height;
+  // VP8LGetWindowRows() sizes a lossless pixel buffer: on top of the history
+  // rows it adds an ARGB cache queue and LZ77 copy headroom. The alpha plane
+  // is shifted directly from min_needed_row and does not use either.
+  {
+    const int max_length_rows = (MAX_LENGTH + width) / width + 1;
+    const int lossless_pad = NUM_ARGB_CACHE_ROWS + max_length_rows + 2;
+    int rows = VP8LGetWindowRows(width, height, /*max_history_rows=*/25);
+    if (rows > lossless_pad) rows -= lossless_pad;
+    return (rows < height) ? rows : height;
+  }
 }
 
