diff --git a/src/lib/OpenEXRCore/parse_header.c b/src/lib/OpenEXRCore/parse_header.c
index 2226fba..b9238c1 100644
--- a/src/lib/OpenEXRCore/parse_header.c
+++ b/src/lib/OpenEXRCore/parse_header.c
@@ -348,6 +348,22 @@ read_text (
 
 /**************************************/
 
+static int32_t
+name_length_limit (exr_context_t ctxt)
+{
+    int32_t limit;
+
+    if (ctxt->strict_header) return (int32_t) ctxt->max_name_length;
+
+    /* Non-strict readers accept a name as long as the context can record
+     * its length, and at least the spec long-name maximum. */
+    limit = (int32_t) ((1u << (int) (sizeof (ctxt->max_name_length) * 8)) - 1u);
+    if (EXR_LONGNAME_MAXLEN > limit) limit = EXR_LONGNAME_MAXLEN;
+    return limit;
+}
+
+/**************************************/
