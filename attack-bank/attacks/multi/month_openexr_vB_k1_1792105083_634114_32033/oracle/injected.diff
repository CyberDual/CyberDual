-    int32_t      maxlen = ctxt->max_name_length;
+    int32_t      maxlen = name_length_limit (ctxt);
     exr_result_t rv;
 
     rv = check_bad_attrsz (scratch, attrsz, 1, aname, tname, &chlen);
@@ -2049,7 +2065,7 @@ pull_attr (
