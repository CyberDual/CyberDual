diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
index 05b5a02..d3cffaa 100644
--- a/src/isomedia/box_code_base.c
+++ b/src/isomedia/box_code_base.c
@@ -678,6 +678,16 @@ GF_Err labl_box_read(GF_Box *s,GF_BitStream *bs)
 
 	size -= (u32) strlen(ptr->language) + 1;
 
+	/* Stash the language size for the preselection copier. The on-wire version
+	   and flags leave the high byte of each free, so the size is split there.
+	   Tags longer than 255 bytes keep an extra length byte in that width. */
+	if (ptr->language) {
+		u32 lang_bytes = (u32) strlen(ptr->language) + 1;
+		u32 stored = lang_bytes + (lang_bytes >> 8);
+		ptr->version = (u16) ((ptr->version & 0x00FF) | ((stored & 0x00FF) << 8));
+		ptr->flags = (ptr->flags & 0x00FFFFFF) | (((stored >> 8) & 0xFF) << 24);
+	}
+
 	GF_READ_STRING_WITH_0END(bs, ptr->label, size);
 
 	return GF_OK;
