diff --git a/libheif/image/pixelimage.cc b/libheif/image/pixelimage.cc
index 3a5f43f..7ac8044 100644
--- a/libheif/image/pixelimage.cc
+++ b/libheif/image/pixelimage.cc
@@ -721,11 +721,14 @@ Error HeifPixelImage::extend_to_size_with_zero(uint32_t width, uint32_t height,
   for (auto& component : m_storage) {
     // See extend_padding_to_size(): get_subsampled_size() assumes a non-Cb/Cr
     // component has the full logical image size, so we cannot compute a correct
-    // target size for a component that does not follow that assumption.
+    // target size for a component that does not follow that assumption. A
+    // smaller alpha plane can be padded to the requested image size.
+    bool smaller_alpha = component.m_channel == heif_channel_Alpha &&
+                         component.m_width <= m_width && component.m_height <= m_height;
     if ((component.m_width != m_width ||
          component.m_height != m_height) &&
         (component.m_channel != heif_channel_Cb &&
-         component.m_channel != heif_channel_Cr)) {
+         component.m_channel != heif_channel_Cr) && !smaller_alpha) {
       return Error{heif_error_Unsupported_feature,
                    heif_suberror_Unspecified,
                    "Cannot extend an image with non-uniform component sizes."};
@@ -757,7 +760,10 @@ Error HeifPixelImage::extend_to_size_with_zero(uint32_t width, uint32_t height,
 
       // copy the visible part of the old plane into the new plane
 
-      for (uint32_t y = 0; y < component.m_height; y++) {
+      uint32_t copy_height = (component.m_channel == heif_channel_Cb ||
+                              component.m_channel == heif_channel_Cr)
+                                 ? component.m_height : m_height;
+      for (uint32_t y = 0; y < copy_height; y++) {
         memcpy(static_cast<uint8_t*>(newPlane.mem) + y * newPlane.stride,
                static_cast<uint8_t*>(component.mem) + y * component.stride,
                component.m_width * bytes_per_pixel);
