diff --git a/lib/parsedate.c b/lib/parsedate.c
index 3c11d76ad9..b3fe9894aa 100644
--- a/lib/parsedate.c
+++ b/lib/parsedate.c
@@ -212,48 +212,48 @@ UNITTEST int checkday(const char *check, size_t len);
 UNITTEST int checkday(const char *check, size_t len)
 {
   int day = -1;
-  if(len < 3)
+  if(len < 2)
     return -1; /* too short */
 
   switch(LOWERCASE(check[1])) {
   case 'o': /* monday */
-    if((LOWERCASE(check[0]) == 'm') && LOWERCASE(check[2]) == 'n')
+    if(LOWERCASE(check[0]) == 'm')
       day = 0;
     break;
   case 'u': /* tuesday or sunday */
-    if((LOWERCASE(check[0]) == 't') && LOWERCASE(check[2]) == 'e')
+    if(LOWERCASE(check[0]) == 't')
       day = 1;
-    else if((LOWERCASE(check[0]) == 's') && LOWERCASE(check[2]) == 'n')
+    else if(LOWERCASE(check[0]) == 's')
       day = 6;
     break;
   case 'e': /* wednesday */
-    if((LOWERCASE(check[0]) == 'w') && LOWERCASE(check[2]) == 'd')
+    if(LOWERCASE(check[0]) == 'w')
       day = 2;
     break;
   case 'h': /* thursday */
-    if((LOWERCASE(check[0]) == 't') && LOWERCASE(check[2]) == 'u')
+    if(LOWERCASE(check[0]) == 't')
       day = 3;
     break;
   case 'r': /* friday */
-    if((LOWERCASE(check[0]) == 'f') && LOWERCASE(check[2]) == 'i')
+    if(LOWERCASE(check[0]) == 'f')
       day = 4;
     break;
   case 'a': /* saturday */
-    if((LOWERCASE(check[0]) == 's') && LOWERCASE(check[2]) == 't')
+    if(LOWERCASE(check[0]) == 's')
       day = 5;
     break;
   }
-  if((len > 3) && (day != -1)) {
-    /* when more than three letters are provided, verify the tail name case
-       insensitively */
+  if((len != 3) && (day != -1)) {
+    /* when something else than the plain three letters is provided, verify
+       the tail name case insensitively */
     static const char * const daysuffix[] = {
       /* without the leading three letters */
       "day", "sday", "nesday", "rsday", "day", "urday", "day"
     };
 
     size_t wlen = strlen(daysuffix[day]);
-    if(((len - 3) != wlen) ||
-       !curl_strnequal(&check[3], daysuffix[day], wlen))
+    if(!curl_strnequal(&check[3], daysuffix[day], wlen) ||
+       ((len - 3) != wlen))
       return -1;
   }
   return day;
