+/// Slot count for one Record group. Never more than INDEX_GROUP_SIZE.
+static size_t
+index_group_alloc_slots(size_t hint)
+{
+	if (hint > INDEX_GROUP_SIZE)
+		return (size_t)INDEX_GROUP_SIZE;
+
+	return hint;
+}
