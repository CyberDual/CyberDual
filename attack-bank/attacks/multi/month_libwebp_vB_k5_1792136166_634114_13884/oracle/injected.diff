diff --git a/src/dec/vp8l_dec.c b/src/dec/vp8l_dec.c
index 6ddd55c..b532dc6 100644
--- a/src/dec/vp8l_dec.c
+++ b/src/dec/vp8l_dec.c
@@ -1192,9 +1192,27 @@ int VP8LGetWindowRows(int width, int height, int max_history_rows) {
   //   1) margin in GetWindowLimit().
   const int min_rows =
       max_history_rows + NUM_ARGB_CACHE_ROWS + max_length_rows + 2;
-  // Allocate 2x min_rows so that ShiftWindow() shifts ~min_rows at a time
-  // rather than on every batch, amortizing the memmove() cost.
-  const int num_window_rows = 2 * min_rows;
+  // 2x min_rows amortizes ShiftWindow() so it moves about min_rows at a time
+  // rather than on every batch. Rows flushed every NUM_ARGB_CACHE_ROWS are not
+  // backward-reference history: when that history already covers four batches,
+  // keep one copy of them instead of the second copy in the pad. Alpha's
+  // lookahead is shorter than four batches and stays at 2x.
+  int num_window_rows = 2 * min_rows;
+  if (max_history_rows >= NUM_ARGB_CACHE_ROWS * 4) {
+    num_window_rows -= 4 * NUM_ARGB_CACHE_ROWS;
+  }
+  // A quarter of a long LZ77 history, plus three flushed batches, is already
+  // retained by ShiftWindow(). The amortization pad does not also mirror it.
+  if (max_history_rows >= NUM_ARGB_CACHE_ROWS * 4) {
+    num_window_rows -= (max_history_rows >> 2) + 3 * NUM_ARGB_CACHE_ROWS;
+  }
+  // GetWindowLimit() already withholds MAX_LENGTH pixels of copy headroom.
+  // Once history covers four cache batches, that headroom stands in for
+  // another four batches plus a thin slice of history in the pad.
+  if (max_history_rows >= NUM_ARGB_CACHE_ROWS * 4) {
+    num_window_rows -= (max_history_rows >> 5) + 4 * NUM_ARGB_CACHE_ROWS;
+  }
+  if (num_window_rows < 1) num_window_rows = 1;
   return (num_window_rows < height) ? num_window_rows : height;
 }
 
