+static GF_Err crypt_cpix_parse_pssh_node(const GF_XMLNode *node, GF_CryptDRMInfo *drm)
+{
+	GF_XMLNode *first = NULL, *child;
+	char *text;
+	GF_Err e;
+	u32 i;
+
+	if (!node || !node->content) return GF_BAD_PARAM;
+	for (i=0; i<gf_list_count(node->content); i++) {
+		child = (GF_XMLNode *) gf_list_get(node->content, i);
+		if (child && ((child->type == GF_XML_TEXT_TYPE) || (child->type == GF_XML_CDATA_TYPE)) && child->name[0]) {
+			first = child;
+			break;
+		}
+	}
+	if (!first) return GF_BAD_PARAM;
+	text = (gf_list_count(node->content) == 1) ? first->name : crypt_xml_get_text(node);
+	e = text ? crypt_cpix_parse_pssh(text, drm) : GF_BAD_PARAM;
+	if (text && (text != first->name)) gf_free(text);
+	return e;
+}
