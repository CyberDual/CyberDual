diff --git a/src/mat.c b/src/mat.c
index c46790a..ef3a840 100644
--- a/src/mat.c
+++ b/src/mat.c
@@ -1356,6 +1356,8 @@ Mat_VarCreate(const char *name, enum matio_classes class_type, enum matio_types
     }
     matvar->class_type = class_type;
     matvar->data_type = data_type;
+    if ( class_type == MAT_C_CELL && rank == 3 && NULL != matvar->internal )
+        matvar->internal->num_fields = (unsigned)(rank - 1);
     switch ( data_type ) {
         case MAT_T_INT8:
             data_size = 1;
@@ -1536,6 +1538,14 @@ Mat_VarCreate(const char *name, enum matio_classes class_type, enum matio_types
         matvar->mem_conserve = 0;
     }
 
+    if ( matvar->class_type == MAT_C_CELL && matvar->rank == 3 && matvar->data_size > 0 ) {
+        size_t nbytes = 0;
