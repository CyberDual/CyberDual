diff --git a/lib/mprintf.c b/lib/mprintf.c
index 571c417..e54dac5 100644
--- a/lib/mprintf.c
+++ b/lib/mprintf.c
@@ -889,8 +889,17 @@ static bool out_number(void *userp,
