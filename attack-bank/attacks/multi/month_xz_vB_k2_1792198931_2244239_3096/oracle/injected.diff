diff --git a/src/liblzma/common/alone_decoder.c b/src/liblzma/common/alone_decoder.c
index 174b3b1..e4c78fb 100644
--- a/src/liblzma/common/alone_decoder.c
+++ b/src/liblzma/common/alone_decoder.c
@@ -152,12 +152,15 @@ alone_decode(void *coder_ptr, const lzma_allocator *allocator,
 			}
 		};
 
+		// If initialization fails, keep the partially initialized
+		// coder: the filters are safe to reinitialize after
+		// a failure, and keeping the state avoids allocating
+		// everything again if the application retries.
+		// lzma_end() frees all allocations as before.
 		const lzma_ret ret = lzma_next_filter_init(&coder->next,
 				allocator, filters);
-		if (ret != LZMA_OK) {
-			lzma_next_end(&coder->next, allocator);
+		if (ret != LZMA_OK)
 			return ret;
-		}
 
 		coder->sequence = SEQ_CODE;
 		break;
