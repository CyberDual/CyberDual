diff --git a/src/truetype/ttvarc.c b/src/truetype/ttvarc.c
index 50d08bc..35afa9d 100644
--- a/src/truetype/ttvarc.c
+++ b/src/truetype/ttvarc.c
@@ -3623,6 +3623,12 @@
         tt_varc_set_normalized_coords( face,
                                        context->font_coords,
                                        context->num_font_coords );
+
+      /* A private blend created for static component axes carries */
+      /* no user state; drop it together with the load context,    */
+      /* to be re-created lazily by the next load that needs it.   */
+      if ( static_axes )
+        tt_done_blend( (FT_Face)face );
 #endif
       if ( context->font_coords )
         FT_FREE( context->font_coords );
