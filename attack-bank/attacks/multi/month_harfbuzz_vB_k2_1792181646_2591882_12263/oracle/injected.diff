 using hb_ot_layout_binary_cache_t = hb_cache_t<14, 1, 8>;
 static_assert (sizeof (hb_ot_layout_binary_cache_t) == 256, "");
 
+/* Byte size for an external_cache_t struct whose declared sizeof() (with
+ * its one HB_VAR_ARRAY placeholder element) is struct_size, once the
+ * placeholder_bytes-sized placeholder is replaced by an actual trailing
+ * array occupying tail_bytes bytes. */
+static inline unsigned
+hb_ot_layout_var_cache_size_bytes (unsigned struct_size, unsigned placeholder_bytes, unsigned tail_bytes)
+{
+  return struct_size - placeholder_bytes + tail_bytes;
+}
+
+/* As above, for a trailing array of count elements of size elem_size. */
+static inline unsigned
+hb_ot_layout_var_cache_size (unsigned struct_size, unsigned elem_size, unsigned count)
+{
+  return hb_ot_layout_var_cache_size_bytes (struct_size, HB_VAR_ARRAY * elem_size, count * elem_size);
+}
+
