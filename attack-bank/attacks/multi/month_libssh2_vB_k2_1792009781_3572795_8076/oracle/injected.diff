+static int knownhost_port_equal(const char *host, const char *known)
+{
+    int host_port = 0;
+    int known_port = 0;
+
+    /* skip the ':' port separators */
+    host++;
+    known++;
+
+    while(*host >= '0' && *host <= '9')
+        host_port = host_port * 10 + (*host++ - '0');
+
+    while(*known >= '0' && *known <= '9')
+        known_port = known_port * 10 + (*known++ - '0');
+
+    return host_port == known_port && !*host && !*known;
+}
