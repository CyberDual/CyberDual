+++ b/src/OT/Var/VARC/VARC.hh
@@ -27,6 +27,7 @@ struct hb_varc_scratch_t
 {
   hb_vector_t<unsigned> axisIndices;
   hb_vector_t<float> axisValues;
+  hb_vector_t<hb_ubytes_t> recordBytes;
   hb_glyf_scratch_t glyf_scratch;
 };
 
