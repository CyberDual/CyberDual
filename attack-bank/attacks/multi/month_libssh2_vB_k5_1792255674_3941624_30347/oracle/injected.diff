+                    "rsa-sha2-512-cert-v01@openssh.com"))
             key_type = LIBSSH2_KNOWNHOST_KEY_SSHRSA;
 #if LIBSSH2_DSA && !defined(LIBSSH2_NO_DEPRECATED)
