--- a/src/knownhost.c
+++ b/src/knownhost.c
@@ -33,6 +33,8 @@
 
 #include "libssh2_priv.h"
 
+#include <ctype.h>
+
 /* https://man.openbsd.org/sshd.8#SSH_KNOWN_HOSTS_FILE_FORMAT */
 
 struct known_host {
@@ -122,6 +124,7 @@ static struct libssh2_knownhost *knownhost_to_external(struct known_host *node)
 }
 
 #define KNOWNHOST_MAX_LEN  (1024 * 1024)
+#define KNOWNHOST_KEY_TYPE_MAX_LEN 40
 
 static int knownhost_add(LIBSSH2_KNOWNHOSTS *hosts,
                          const char *host, const char *salt,
@@ -955,6 +958,22 @@ static int knownhost_line_hashed(LIBSSH2_KNOWNHOSTS *hosts,
         return 0; /* XXX: This should be an error, should it not? */
 }
 
+static int knownhost_key_type_equal(const char *name, size_t len,
+                                    const char *expected)
+{
+    char normalized[KNOWNHOST_KEY_TYPE_MAX_LEN];
+    size_t i;
+
+    if(len > KNOWNHOST_KEY_TYPE_MAX_LEN || len != strlen(expected))
+        return 0;
+
+    for(i = 0; i < len; i++)
+        normalized[i] = (char)tolower((unsigned char)name[i]);
+    normalized[len] = '\0';
+
+    return !strcmp(normalized, expected);
+}
+
 /*
  * Parse a single known_host line pre-split into host and key.
  *
@@ -1003,18 +1022,48 @@ static int knownhost_line(LIBSSH2_KNOWNHOSTS *hosts,
         }
         key_type_len = key - key_type_name;
 
