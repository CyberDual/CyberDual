+            key_type = LIBSSH2_KNOWNHOST_KEY_SSHRSA;
+        else if(knownhost_key_type_equal(
+                    key_type_name, key_type_len,
+                    "rsa-sha2-256-cert-v01@openssh.com"))
+            key_type = LIBSSH2_KNOWNHOST_KEY_SSHRSA;
+        else if(knownhost_key_type_equal(
