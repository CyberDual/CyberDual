+
+// True when the per-row fill in extend_to_size_with_zero() would shrink this plane.
+// Cb/Cr are measured on the subsampled grid: a logical target that is not smaller
+// than the image can still map to a chroma size below a plane added larger than
+// that grid (GHSA-j2rv-58fh-w8pw). Every other channel stores full-resolution
+// samples, so the logical-size guard is the shrink check for it. A non-chroma
+// plane whose size is not the logical image size never reaches the fill (the
+// non-uniform check rejects it), and is therefore not reported here.
+static bool extend_target_shrinks_plane(heif_channel channel,
+                                        uint32_t plane_width, uint32_t plane_height,
+                                        uint32_t width, uint32_t height,
+                                        heif_chroma chroma)
+{
+  if (channel != heif_channel_Cb &&
+      channel != heif_channel_Cr) {
+    return false;
+  }
+
+  uint32_t subsampled_width, subsampled_height;
+  get_subsampled_size(width, height, channel, chroma,
+                      &subsampled_width, &subsampled_height);
+  return subsampled_width < plane_width || subsampled_height < plane_height;
+}
+
