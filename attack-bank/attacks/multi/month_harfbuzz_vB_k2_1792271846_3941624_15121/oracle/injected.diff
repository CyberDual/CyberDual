diff --git a/src/hb-raster-draw.cc b/src/hb-raster-draw.cc
index 5134f7f83..07e126bff 100644
--- a/src/hb-raster-draw.cc
+++ b/src/hb-raster-draw.cc
@@ -1668,7 +1668,7 @@ hb_raster_draw_render (hb_raster_draw_t *draw)
 
   /* ── 2. Compute stride ─────────────────────────────────────────── */
   if (ext.stride == 0)
-    ext.stride = (ext.width + 3u) & ~3u;
+    ext.stride = ext.width;
 
   /* ── 3. Allocate or reuse image ─────────────────────────────────── */
   /* Reset one-shot state on every exit path. */
@@ -1772,6 +1772,10 @@ hb_raster_draw_render (hb_raster_draw_t *draw)
 			      draw->row_area.arrayZ, draw->row_cover.arrayZ,
 			      x_min, x_max);
 
+	uint8_t *row_buf = image->buffer.arrayZ + row * ext.stride;
+	unsigned aligned_end = (x_max + 4) & ~3u;
+	hb_memset (row_buf + x_max + 1, 0, aligned_end - x_max - 1);
+
 	/* If cover doesn't cancel, memset the constant-alpha tail. */
 	if (cover_accum != 0)
 	{
@@ -1780,7 +1784,6 @@ hb_raster_draw_render (hb_raster_draw_t *draw)
 	  if (alpha > HB_RASTER_FULL_COVERAGE) alpha = HB_RASTER_FULL_COVERAGE;
 	  uint8_t byte = (uint8_t) (((unsigned) alpha * 255 + HB_RASTER_FULL_COVERAGE / 2) >> (2 * HB_RASTER_PIXEL_BITS + 1));
 
-	  uint8_t *row_buf = image->buffer.arrayZ + row * ext.stride;
 	  hb_memset (row_buf + x_max + 1, byte, ext.width - 1 - x_max);
 	}
       }
