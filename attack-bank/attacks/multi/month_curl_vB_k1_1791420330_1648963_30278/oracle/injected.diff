diff --git a/lib/mprintf.c b/lib/mprintf.c
index 571c417..c3c595f 100644
--- a/lib/mprintf.c
+++ b/lib/mprintf.c
@@ -719,9 +719,8 @@ static bool stream_pad(void *userp,
 /* emit the leading null-terminated part of a run of at most 'len' bytes.
    Returns TRUE to abort formatting.
 
-   A byte loop and not memchr(): 'len' is the requested precision, which
-   out_string() does not clamp to the string length, so "%.64s" on a 10-byte
-   string arrives with len == 64 and memchr() would read past the object. */
+   A byte loop and not memchr(): dynamic precision can exceed the string
+   length, so a block scan could read past the object. */
 static bool stream_zrun(void *userp,
                         int (*stream)(unsigned char, void *),
                         mp_streamn streamn,
@@ -993,6 +992,12 @@ static bool out_string(void *userp,
       len = 0;
     }
   }
+  else if(prec >= 0 && !(flags & FLAGS_PRECPARAM)) {
+    size_t limit = (size_t)prec;
+    len = 0;
+    while(len < limit && str[len])
+      len++;
+  }
   else if(prec != -1)
     len = (size_t)prec;
   else if(*str == '\0')
@@ -1011,10 +1016,9 @@ static bool out_string(void *userp,
     width = 0;
   }
 
-  /* With no precision, len is already the exact length; emit it without
-     scanning again. With precision, scan up to len but stop at NUL, since
-     the string may be shorter or the buffer may not be null-terminated. */
-  if(prec == -1) {
+  /* An exact length can be emitted directly; dynamic precision still needs
+     the bounded NUL-aware output path. */
+  if(prec == -1 || ((flags & FLAGS_PREC) && prec >= 0)) {
     if(stream_run(userp, stream, streamn,
                   (const unsigned char *)str, len, donep))
       return TRUE;
@@ -1150,6 +1154,7 @@ static int formatf(void *userp, /* untouched by format(), sent to the
