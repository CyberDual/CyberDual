+/* Longest plain host token accepted from a legacy known_hosts line. */
+#define KNOWNHOST_LEGACY_NAME_MAX 255
+
+static int knownhost_copy_legacy_name(char *dst, const char *name,
+                                      size_t namelen)
+{
+    if(namelen > KNOWNHOST_LEGACY_NAME_MAX)
+        return -1;
+
+    memcpy(dst, name, namelen);
+    dst[namelen] = '\0';
+    return 0;
+}
