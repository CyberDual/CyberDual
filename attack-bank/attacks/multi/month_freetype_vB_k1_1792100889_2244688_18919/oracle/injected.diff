@@ -3628,6 +3628,15 @@
         FT_FREE( context->font_coords );
       FT_FREE( context );
       face->varc_context = NULL;
+
+#ifdef TT_CONFIG_OPTION_GX_VAR_SUPPORT
+      /* A static face's private blend exists only to service VARC    */
