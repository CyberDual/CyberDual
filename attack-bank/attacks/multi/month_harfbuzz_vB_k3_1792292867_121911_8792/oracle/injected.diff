     unsigned size = sizeof (external_cache_t) -
 		    HB_VAR_ARRAY * sizeof (hb_ot_layout_ruleset_digest_t) +
 		    count * sizeof (hb_ot_layout_ruleset_digest_t);
@@ -5521,7 +5530,7 @@ struct ChainContextFormat2_5
   };
