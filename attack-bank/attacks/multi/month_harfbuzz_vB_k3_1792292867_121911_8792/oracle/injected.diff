+/* Number of per-RuleSet digests a format-2 contextual subtable stores in
+ * its external cache.  Capped: rule sets past the cap keep the uncached
+ * rule walk, so fonts with pathological class counts do not grow the
+ * external cache without bound at face load. */
+static constexpr unsigned HB_CACHED_RULE_SET_COUNT = 512;
+
+static inline unsigned cached_rule_set_count (unsigned rule_set_len)
+{ return hb_min (rule_set_len, HB_CACHED_RULE_SET_COUNT); }
+
