diff --git a/src/scene_manager/loader_xmt.c b/src/scene_manager/loader_xmt.c
index a3fe7b0..30a8650 100644
--- a/src/scene_manager/loader_xmt.c
+++ b/src/scene_manager/loader_xmt.c
@@ -2550,12 +2550,20 @@ static void xmt_parse_command(GF_XMTParser *parser, const char *name, const GF_X
 			au_is_rap = 1;
 
 			if (parser->parsing_proto) {
-				while (gf_list_count(parser->od_links)) {
-					XMT_ODLink* odl = (XMT_ODLink*)gf_list_get(parser->od_links, 0);
+				u32 nb_links = gf_list_count(parser->od_links);
+				while (nb_links) {
+					XMT_ODLink* odl = (XMT_ODLink*)gf_list_get(parser->od_links, nb_links - 1);
+					/*an already assigned OD may be shared with URLs of the outer scene:
+					only links still waiting for their descriptor go away with the sub-graph*/
+					if (odl->od) {
+						nb_links--;
+						continue;
+					}
 					if (odl->desc_name) gf_free(odl->desc_name);
 					gf_list_del(odl->mf_urls);
 					gf_free(odl);
-					gf_list_rem(parser->od_links, 0);
+					gf_list_rem(parser->od_links, nb_links - 1);
+					nb_links--;
 				}
 			}
 
@@ -2582,6 +2590,10 @@ static void xmt_parse_command(GF_XMTParser *parser, const char *name, const GF_X
 				u32 i, num_defs = gf_list_count(parser->def_nodes);
 				for (i = 0; i < num_defs; i++) {
 					GF_Node *n = (GF_Node *)gf_list_get(parser->def_nodes, i);
+					/*a DEF node of the main graph drops its OD links when detached from the
+					tree; only sub-graphs owned by a proto instance can outlive their nodes*/
+					if (!n->sgprivate->scenegraph->pOwningProto)
+						continue;
 					if (n->sgprivate->num_instances == 1)
 						xmt_remove_od_links_recursive(parser, n, 0);
 				}
