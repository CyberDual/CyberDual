+// Shortest Huffman code the format can emit: the simple-code path with one
+// 1-bit symbol (simple flag, symbol count, length flag, symbol).
+#define MIN_HUFFMAN_CODE_BITS 4
+
+// Bits still available in 'br', not counting bits already consumed from the
+// prefetched window. Returns 0 once the reader has gone past the buffer.
+static uint64_t VP8LBitsLeft(const VP8LBitReader* const br) {
+  const uint64_t total_bits = (uint64_t)br->len << 3;
+  // Init loads min(len, sizeof(val)) bytes and sets bit_pos to 0. Every later
+  // refill keeps (bit_pos + 8 * pos) equal to bits_consumed plus that preload.
+  const size_t prefetch =
+      (br->len < sizeof(br->val)) ? br->len : sizeof(br->val);
+  int64_t consumed;
+  if (br->eos || total_bits == 0) return 0;
+  consumed = (int64_t)br->bit_pos +
+             ((int64_t)br->pos - (int64_t)prefetch) * 8;
+  if (consumed <= 0) return total_bits;
+  if ((uint64_t)consumed >= total_bits) return 0;
+  return total_bits - (uint64_t)consumed;
+}
+
+// A truncated Huffman-table section must not force allocations proportional to
+// the declared group count. 'num_groups' counts every meta-code ReadHuffmanCode
+// will actually parse, including gaps that are validated and discarded.
+static int HuffmanCodesFit(const VP8LBitReader* const br, int num_groups) {
+  const uint64_t per_group =
+      (uint64_t)HUFFMAN_CODES_PER_META_CODE * MIN_HUFFMAN_CODE_BITS;
+  const uint64_t bits_left = VP8LBitsLeft(br);
+  if (num_groups <= 0) return 0;
+  return (uint64_t)num_groups <= bits_left / per_group;
+}
