+static int
+dwa_ptr_range_ok (const uint8_t* base, size_t alloc, const uint8_t* p, size_t n)
+{
+    size_t off;
+
+    if (!base || p < base) return 0;
+    off = (size_t) (p - base);
+    if (off > alloc) return 0;
+    if (n > alloc - off) return 0;
+    return 1;
+}
+
+static exr_result_t
+DwaCompressor_validateStreamSizes (
+    const DwaCompressor* me,
+    uint64_t             rleRawSize,
+    uint64_t             unknownUncompressedSize)
+{
+    uint64_t needRle = 0;
+    uint64_t needUnk = 0;
+
+    for (int c = 0; c < me->_numChannels; ++c)
+    {
+        const ChannelData*               cd   = me->_channelData + c;
+        const exr_coding_channel_info_t* chan = cd->chan;
+        uint64_t                         rows = 0;
+        uint64_t                         nbytes;
+
+        if (chan->width <= 0 || chan->height <= 0) continue;
+        if (cd->compression != RLE && cd->compression != UNKNOWN) continue;
+        if (chan->y_samples <= 0) return EXR_ERR_CORRUPT_CHUNK;
+
+        for (int y = me->_min[1]; y <= me->_max[1]; ++y)
+        {
+            if ((y % chan->y_samples) == 0) ++rows;
+        }
+
+        if (rows > UINT64_MAX / (uint64_t) chan->width)
+            return EXR_ERR_CORRUPT_CHUNK;
+        nbytes = rows * (uint64_t) chan->width;
+        if (nbytes > UINT64_MAX / (uint64_t) chan->bytes_per_element)
+            return EXR_ERR_CORRUPT_CHUNK;
+        nbytes *= (uint64_t) chan->bytes_per_element;
+
+        if (cd->compression == RLE)
+        {
+            if (needRle > UINT64_MAX - nbytes) return EXR_ERR_CORRUPT_CHUNK;
+            needRle += nbytes;
+        }
+        else
+        {
+            if (needUnk > UINT64_MAX - nbytes) return EXR_ERR_CORRUPT_CHUNK;
+            needUnk += nbytes;
+        }
+    }
+
+    if (needRle > rleRawSize || needUnk > unknownUncompressedSize)
+        return EXR_ERR_CORRUPT_CHUNK;
+    return EXR_ERR_SUCCESS;
+}
+
