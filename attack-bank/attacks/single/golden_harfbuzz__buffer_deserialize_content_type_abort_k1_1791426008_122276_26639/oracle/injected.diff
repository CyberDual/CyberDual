diff --git a/src/hb-buffer-serialize.cc b/src/hb-buffer-serialize.cc
index 923524d708ae23146b27b637f87c179d988b2b44..03133c88ad84dce6191a1671e88dbc39c79afb03 100644
--- a/src/hb-buffer-serialize.cc
+++ b/src/hb-buffer-serialize.cc
@@ -796,7 +796,9 @@ hb_buffer_deserialize_glyphs (hb_buffer_t *buffer,
     return false;
   }
 
-  hb_buffer_set_content_type (buffer, HB_BUFFER_CONTENT_TYPE_GLYPHS);
+  /* Ignore a single trailing newline, if any. */
+  if (buf[buf_len] == '\n')
+    buf_len--;
 
   if (!font)
     font = hb_font_get_empty ();
@@ -804,11 +806,13 @@ hb_buffer_deserialize_glyphs (hb_buffer_t *buffer,
   switch (format)
   {
     case HB_BUFFER_SERIALIZE_FORMAT_TEXT:
