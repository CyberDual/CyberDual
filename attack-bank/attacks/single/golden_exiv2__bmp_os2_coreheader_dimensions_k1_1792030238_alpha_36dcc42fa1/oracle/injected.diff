   byte buf[26];
   if (io_->read(buf, sizeof(buf)) == sizeof(buf)) {
-    pixelWidth_ = getULong(buf + 18, littleEndian);
-    pixelHeight_ = getULong(buf + 22, littleEndian);
+    const uint32_t headerSize = getULong(buf + 14, littleEndian);
+    if (headerSize == 12) {
+      // OS/2 1.x / Windows 2.x BITMAPCOREHEADER: width and height are 16-bit fields.
+      pixelWidth_ = getUShort(buf + 18, littleEndian);
+      pixelHeight_ = getUShort(buf + 20, littleEndian);
+      // Core headers have no color-count field. A paletted bitmap (depth <= 8) is followed by
+      // 2^depth RGBTRIPLE entries; drop the dimensions if that table is truncated.
+      const uint16_t depth = getUShort(buf + 24, littleEndian);
+      if (depth > 0 && depth <= 8) {
+        const uint32_t colors = 1u << depth;
+        DataBuf palette(static_cast<size_t>(colors) * 3);
+        bool truncated = false;
+        for (uint32_t i = 0; i <= colors; ++i) {
+          if (io_->read(palette.data() + static_cast<size_t>(i) * 3, 3) != 3) {
+            truncated = true;
+            break;
+          }
+        }
+        if (truncated) {
+          pixelWidth_ = 0;
+          pixelHeight_ = 0;
+        }
+      }
+    } else {
+      pixelWidth_ = getULong(buf + 18, littleEndian);
+      pixelHeight_ = getULong(buf + 22, littleEndian);
+    }
   }
 }
 
