diff --git a/docs/libssh2_channel_has_exit_status.md b/docs/libssh2_channel_has_exit_status.md
new file mode 100644
index 0000000000000000000000000000000000000000..c40f65ac0a45ef8e6984409bf9d6f2923cc48ef1
--- /dev/null
+++ b/docs/libssh2_channel_has_exit_status.md
@@ -0,0 +1,32 @@
+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+  - libssh2_channel_get_exit_status(3)
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - check whether an exit status was received
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+~~~
+
+# DESCRIPTION
+
+Reports whether the peer sent an exit-status request for *channel*. The
+status may be zero; use libssh2_channel_get_exit_status(3) to retrieve it.
+The result remains available until the channel is freed.
+
+# RETURN VALUE
+
+Returns 1 if an exit status was received, or 0 if none was received or
+*channel* is NULL.
