+// Local build-only shim for a tiny subset of {fmt}, used when neither
+// std::format nor the real fmt library is available in the sandbox.
+#ifndef FMT_FORMAT_H_SHIM_
+#define FMT_FORMAT_H_SHIM_
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <vector>
+
+namespace fmt {
+namespace shim {
+
+struct Spec {
+  char fill = ' ';
+  char align = 0;
+  bool alt = false;
+  bool zero = false;
+  int width = -1;
+  int precision = -1;
+  char type = 0;
+};
+
+inline bool isAlign(char c) {
+  return c == '<' || c == '>' || c == '^';
+}
+
+inline std::string applyAlign(std::string body, const Spec& sp, bool numeric) {
+  if (sp.width < 0 || static_cast<int>(body.size()) >= sp.width)
+    return body;
+  int pad = sp.width - static_cast<int>(body.size());
+  char align = sp.align;
+  if (!align)
+    align = numeric ? '>' : '<';
+  if (sp.zero && numeric && !sp.align) {
+    size_t ins = 0;
+    if (ins < body.size() && (body[ins] == '-' || body[ins] == '+' || body[ins] == ' '))
+      ++ins;
+    if (ins + 1 < body.size() && body[ins] == '0' && (body[ins + 1] == 'x' || body[ins + 1] == 'X'))
+      ins += 2;
+    return body.substr(0, ins) + std::string(pad, '0') + body.substr(ins);
+  }
+  if (align == '>')
+    return std::string(pad, sp.fill) + body;
+  if (align == '^')
+    return std::string(pad / 2, sp.fill) + body + std::string(pad - pad / 2, sp.fill);
+  return body + std::string(pad, sp.fill);
+}
+
+template <typename T>
+std::string renderIntBody(T val, const Spec& sp) {
+  int base = 10;
+  bool upper = false;
+  switch (sp.type) {
+    case 'x':
+      base = 16;
+      break;
+    case 'X':
+      base = 16;
+      upper = true;
+      break;
+    case 'o':
+      base = 8;
+      break;
+    case 'b':
+    case 'B':
+      base = 2;
+      break;
+    case 'c':
+      return std::string(1, static_cast<char>(val));
+    default:
+      base = 10;
+  }
+  bool neg = false;
+  unsigned long long u = 0;
+  if constexpr (std::is_signed_v<T>) {
+    long long s = static_cast<long long>(val);
+    if (s < 0) {
+      neg = true;
+      u = static_cast<unsigned long long>(-(s + 1)) + 1ULL;
+    } else {
+      u = static_cast<unsigned long long>(s);
+    }
+  } else {
+    u = static_cast<unsigned long long>(val);
+  }
+  const char* digs = upper ? "0123456789ABCDEF" : "0123456789abcdef";
+  std::string num;
+  if (u == 0) {
+    num = "0";
+  } else {
+    while (u) {
+      num.push_back(digs[u % static_cast<unsigned>(base)]);
+      u /= static_cast<unsigned>(base);
+    }
+    std::reverse(num.begin(), num.end());
+  }
+  std::string body;
+  if (neg)
+    body += '-';
+  if (sp.alt && base == 16)
+    body += upper ? "0X" : "0x";
+  else if (sp.alt && base == 8)
+    body += "0";
+  else if (sp.alt && base == 2)
+    body += upper ? "0B" : "0b";
+  body += num;
+  return applyAlign(body, sp, true);
+}
+
+inline std::string renderFloatBody(double val, const Spec& sp) {
+  char conv = sp.type;
+  if (conv == 0)
+    conv = (sp.precision < 0) ? 'g' : 'f';
+  int prec = sp.precision;
+  std::string fs = "%";
+  if (sp.alt)
+    fs += '#';
+  fs += '.';
+  fs += std::to_string(prec < 0 ? 6 : prec);
+  fs += conv;
+  char buf[64];
+  std::snprintf(buf, sizeof(buf), fs.c_str(), val);
+  return applyAlign(std::string(buf), sp, true);
+}
+
+inline std::string renderStrBody(std::string body, const Spec& sp) {
+  if (sp.precision >= 0 && static_cast<int>(body.size()) > sp.precision)
+    body.resize(sp.precision);
+  return applyAlign(body, sp, false);
+}
+
+template <typename T>
+std::enable_if_t<std::is_integral_v<T> && !std::is_same_v<T, bool> && !std::is_same_v<T, char>, std::string> renderArg(
+    const Spec& sp, T v) {
+  return renderIntBody(v, sp);
+}
+
+template <typename T>
+std::enable_if_t<std::is_floating_point_v<T>, std::string> renderArg(const Spec& sp, T v) {
+  return renderFloatBody(static_cast<double>(v), sp);
+}
+
+template <typename T>
+std::enable_if_t<std::is_enum_v<T>, std::string> renderArg(const Spec& sp, T v) {
+  return renderIntBody(static_cast<std::underlying_type_t<T>>(v), sp);
+}
+
+inline std::string renderArg(const Spec& sp, bool v) {
+  if (sp.type != 0)
+    return renderIntBody<int>(v ? 1 : 0, sp);
+  return renderStrBody(v ? "true" : "false", sp);
+}
+
+inline std::string renderArg(const Spec& sp, char v) {
+  if (sp.type != 0 && sp.type != 'c')
+    return renderIntBody<int>(static_cast<int>(v), sp);
+  return renderStrBody(std::string(1, v), sp);
+}
+
+inline std::string renderArg(const Spec& sp, const std::string& v) {
+  return renderStrBody(v, sp);
+}
+inline std::string renderArg(const Spec& sp, std::string_view v) {
+  return renderStrBody(std::string(v), sp);
+}
+inline std::string renderArg(const Spec& sp, const char* v) {
+  return renderStrBody(v ? std::string(v) : std::string(), sp);
+}
+
+inline Spec parseSpec(const std::string& s) {
+  Spec sp;
+  size_t p = 0;
+  if (s.size() >= 2 && isAlign(s[1])) {
+    sp.fill = s[0];
+    sp.align = s[1];
+    p = 2;
+  } else if (!s.empty() && isAlign(s[0])) {
+    sp.align = s[0];
+    p = 1;
+  }
+  if (p < s.size() && (s[p] == '+' || s[p] == '-' || s[p] == ' '))
+    ++p;
+  if (p < s.size() && s[p] == '#') {
+    sp.alt = true;
+    ++p;
+  }
+  if (p < s.size() && s[p] == '0') {
+    sp.zero = true;
+    ++p;
+  }
+  int w = 0;
+  bool haveW = false;
+  while (p < s.size() && s[p] >= '0' && s[p] <= '9') {
+    w = w * 10 + (s[p] - '0');
+    haveW = true;
+    ++p;
+  }
+  if (haveW)
+    sp.width = w;
+  if (p < s.size() && s[p] == '.') {
+    ++p;
+    int pr = 0;
+    while (p < s.size() && s[p] >= '0' && s[p] <= '9') {
+      pr = pr * 10 + (s[p] - '0');
+      ++p;
+    }
+    sp.precision = pr;
+  }
+  if (p < s.size())
+    sp.type = s[p];
+  return sp;
+}
+
+template <typename... Args>
+std::string do_format(std::string_view f, Args&&... args) {
+  std::vector<std::function<std::string(const Spec&)>> fns;
+  (fns.emplace_back([a = args](const Spec& sp) { return renderArg(sp, a); }), ...);
+  std::string out;
+  size_t argIdx = 0;
+  for (size_t i = 0; i < f.size(); ++i) {
+    char c = f[i];
+    if (c == '{') {
+      if (i + 1 < f.size() && f[i + 1] == '{') {
+        out += '{';
+        ++i;
+        continue;
+      }
+      size_t j = f.find('}', i);
+      std::string field(f.substr(i + 1, j - (i + 1)));
+      size_t colon = field.find(':');
+      std::string idxPart = (colon == std::string::npos) ? field : field.substr(0, colon);
+      std::string specPart = (colon == std::string::npos) ? std::string() : field.substr(colon + 1);
+      size_t idx;
+      if (!idxPart.empty())
+        idx = static_cast<size_t>(std::stoul(idxPart));
+      else
+        idx = argIdx++;
+      Spec sp = parseSpec(specPart);
+      if (idx < fns.size())
+        out += fns[idx](sp);
+      i = j;
+    } else if (c == '}') {
+      if (i + 1 < f.size() && f[i + 1] == '}') {
+        out += '}';
+        ++i;
+      }
+    } else {
+      out += c;
+    }
+  }
+  return out;
+}
+
+}  // namespace shim
+
+template <typename... Args>
+std::string format(std::string_view f, Args&&... args) {
+  return shim::do_format(f, std::forward<Args>(args)...);
+}
+
+template <typename OutputIt, typename... Args>
+OutputIt format_to(OutputIt out, std::string_view f, Args&&... args) {
+  std::string s = shim::do_format(f, std::forward<Args>(args)...);
+  for (char c : s)
+    *out++ = c;
+  return out;
+}
+
+}  // namespace fmt
+
+#endif
