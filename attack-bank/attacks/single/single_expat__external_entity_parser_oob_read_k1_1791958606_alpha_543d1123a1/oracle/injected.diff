@@ -3893,6 +3893,74 @@ START_TEST(test_attribute_enum_value) {
 }
 END_TEST
 
+struct inherited_default_att_data {
+  const char *entity_text;
+  CharData *storage;
+};
+
+static void XMLCALL
+inherited_default_att_start(void *userData, const XML_Char *name,
+                            const XML_Char **atts) {
+  struct inherited_default_att_data *const data
+      = (struct inherited_default_att_data *)userData;
+
+  UNUSED_P(name);
+  if (atts[0] == NULL)
+    return;
+  /* Accumulate the value of the first attribute we see */
+  CharData_AppendXMLChars(data->storage, atts[1], -1);
+}
+
+static int XMLCALL
+inherited_default_att_loader(XML_Parser parser, const XML_Char *context,
+                              const XML_Char *base, const XML_Char *systemId,
+                              const XML_Char *publicId) {
+  struct inherited_default_att_data *const data
+      = (struct inherited_default_att_data *)XML_GetUserData(parser);
+  XML_Parser ext_parser;
+
+  UNUSED_P(base);
+  UNUSED_P(systemId);
+  UNUSED_P(publicId);
+  ext_parser = XML_ExternalEntityParserCreate(parser, context, NULL);
+  if (ext_parser == NULL)
+    fail("Could not create external entity parser.");
+  if (_XML_Parse_SINGLE_BYTES(ext_parser, data->entity_text,
+                              (int)strlen(data->entity_text), XML_TRUE)
+      == XML_STATUS_ERROR) {
+    xml_failure(ext_parser);
+    return XML_STATUS_ERROR;
+  }
+  XML_ParserFree(ext_parser);
+  return XML_STATUS_OK;
+}
+
+/* Test that attribute declarations of the document are honoured when an
+   external entity is parsed by a parser inheriting that DTD; the tokenized
+   attribute type must still suppress CDATA treatment of the value.
+ */
+START_TEST(test_inherited_default_att_in_ext_entity) {
+  const char *text
+      = "<!DOCTYPE d [\n"
+        "  <!ELEMENT d ANY>\n"
+        "  <!ATTLIST e a NMTOKEN 'dv'>\n"
+        "  <!ENTITY ext SYSTEM 'ext.ent'>\n"
+        "]>\n"
+        "<d>&ext;</d>";
+  CharData storage;
+  struct inherited_default_att_data data = {"<e a=' x'/>", &storage};
+
+  CharData_Init(&storage);
+  XML_SetUserData(g_parser, &data);
+  XML_SetStartElementHandler(g_parser, inherited_default_att_start);
+  XML_SetExternalEntityRefHandler(g_parser, inherited_default_att_loader);
+  if (_XML_Parse_SINGLE_BYTES(g_parser, text, (int)strlen(text), XML_TRUE)
+      == XML_STATUS_ERROR)
+    xml_failure(g_parser);
+  CharData_CheckXMLChars(&storage, XCS("x"));
+}
+END_TEST
