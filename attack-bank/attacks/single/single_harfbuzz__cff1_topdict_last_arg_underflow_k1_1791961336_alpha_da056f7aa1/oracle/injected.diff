index 79f265050fc0cfac2f514576f9468f857f9da267..72551202e108ec13be13c356475e8641bd1c1032 100644
--- a/src/hb-ot-cff1-table.hh
+++ b/src/hb-ot-cff1-table.hh
@@ -773,9 +773,6 @@ struct cff1_top_dict_opset_t : top_dict_opset_t<cff1_top_dict_val_t>
 {
   static void process_op (op_code_t op, cff1_top_dict_interp_env_t& env, cff1_top_dict_values_t& dictval)
   {
-    cff1_top_dict_val_t  val;
-    val.last_arg_offset = (env.last_offset-1) - dictval.opStart;  /* offset to the last argument */
-
     switch (op) {
       case OpCode_version:
       case OpCode_Notice:
@@ -853,6 +850,37 @@ struct cff1_top_dict_opset_t : top_dict_opset_t<cff1_top_dict_val_t>
 
     if (unlikely (env.in_error ())) return;
 
+    cff1_top_dict_val_t  val;
+    /* offset to the last argument; last_offset is one past its first byte */
+    if (env.last_offset > dictval.opStart)
+      val.last_arg_offset = env.last_offset - dictval.opStart - 1;
+    else
+      val.last_arg_offset = 0;
+
+    if (op == OpCode_ROS &&
+	env.last_offset > dictval.opStart)
+    {
+      unsigned span = env.str_ref.get_offset () - dictval.opStart;
+      if (val.last_arg_offset < span)
+      {
+	hb_ubytes_t bytes = env.str_ref.sub_array (dictval.opStart + val.last_arg_offset,
+						   span - val.last_arg_offset);
+	/* Supplement integer sits in front of the two-byte ROS operator. */
+	if (bytes.length > 2 && bytes.arrayZ[0] == OpCode_longintdict)
+	{
+	  unsigned char num[4];
+	  unsigned end = bytes.length - 2;
+	  unsigned acc = 0;
+	  for (unsigned i = 0; i < end; i++)
+	  {
+	    num[i] = bytes.arrayZ[i];
+	    acc = (acc << 8) | num[i];
+	  }
+	  dictval.ros_supplement_offset = acc;
+	}
+      }
+    }
+
     dictval.add_op (op, env.str_ref, val);
   }
 };
