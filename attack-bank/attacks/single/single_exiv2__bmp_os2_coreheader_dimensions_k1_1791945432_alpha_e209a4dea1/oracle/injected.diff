@@ -71,19 +71,44 @@ void BmpImage::readMetadata() {
      6      4 bytes  reserved
     10      4 bytes  bitmap offset
     14      4 bytes  header size
-    18      4 bytes  bitmap width
-    22      4 bytes  bitmap height
+    18      4 bytes  bitmap width           2 bytes in a BITMAPCOREHEADER
+    22      4 bytes  bitmap height          2 bytes, directly after width, in a BITMAPCOREHEADER
     26      2 bytes  plane count
     28      2 bytes  depth
     30      4 bytes  compression            0 = none; 1 = RLE, 8 bits/pixel; 2 = RLE, 4 bits/pixel; 3 = bitfield;
     4 = JPEG; 5 = PNG 34      4 bytes  image size             size of the raw bitmap data, in bytes 38      4
     bytes  horizontal resolution  (in pixels per meter) 42      4 bytes  vertical resolution    (in pixels per
     meter) 46      4 bytes  color count 50      4 bytes  important colors       number of "important" colors
+
+    A header size of 12 is a BITMAPCOREHEADER (OS/2 1.x / Windows 2.x). Its width, height,
+    plane count and bit count are 16-bit fields, and there is no compression or color-count field.
   */
   byte buf[26];
   if (io_->read(buf, sizeof(buf)) == sizeof(buf)) {
-    pixelWidth_ = getULong(buf + 18, littleEndian);
-    pixelHeight_ = getULong(buf + 22, littleEndian);
+    const uint32_t headerSize = getULong(buf + 14, littleEndian);
+    if (headerSize == 12) {
+      pixelWidth_ = getUShort(buf + 18, littleEndian);
+      pixelHeight_ = getUShort(buf + 20, littleEndian);
+
+      // Rows are padded to a multiple of four bytes. Bound the copy so a huge
+      // bitmap is not pulled in just to discover its geometry.
+      const uint16_t bitCount = getUShort(buf + 24, littleEndian);
+      const uint32_t offBits = getULong(buf + 10, littleEndian);
+      const uint32_t stride = ((pixelWidth_ * bitCount + 31) / 32) * 4;
+      const uint32_t pixelBytes = stride * pixelHeight_;
+      if (bitCount > 0 && pixelBytes > 0 && pixelBytes <= 16u * 1024u * 1024u && offBits < io_->size()) {
+        const uint64_t rowsBytes = static_cast<uint64_t>(stride) * pixelHeight_;
+        const size_t available = io_->size() - static_cast<size_t>(offBits);
+        const uint64_t toRead = available < rowsBytes ? static_cast<uint64_t>(available) : rowsBytes;
+        if (toRead > 0 && io_->seek(static_cast<int64_t>(offBits), BasicIo::beg) == 0) {
+          DataBuf pixels(pixelBytes);
+          io_->read(pixels.data(), static_cast<size_t>(toRead));
+        }
+      }
+    } else {
+      pixelWidth_ = getULong(buf + 18, littleEndian);
+      pixelHeight_ = getULong(buf + 22, littleEndian);
+    }
   }
 }
 
