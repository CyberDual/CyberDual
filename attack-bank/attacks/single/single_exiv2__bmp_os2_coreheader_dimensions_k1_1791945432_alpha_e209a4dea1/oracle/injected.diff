+TEST(BmpImage, readMetadataReadsCoreHeaderDimensions) {
+  // BITMAPCOREHEADER is 12 bytes: width and height are 16-bit, so a 32-bit
+  // read would fold the following fields into the reported geometry.
+  const std::array<unsigned char, 26> header{
+      'B',  'M',               // Signature
+      0x1A, 0x00, 0x00, 0x00,  // Size of the BMP file in bytes
+      0x00, 0x00,              // Reserved
+      0x00, 0x00,              // Reserved
+      0x1A, 0x00, 0x00, 0x00,  // Pixel data follows the 26-byte headers
+      0x0C, 0x00, 0x00, 0x00,  // BITMAPCOREHEADER size
+      0x40, 0x01,              // Width 320
+      0xC8, 0x00,              // Height 200
+      0x01, 0x00,              // Planes
+      0x18, 0x00,              // Bit count 24
+  };
+
+  auto memIo = std::make_unique<MemIo>(header.data(), header.size());
+  BmpImage bmp(std::move(memIo), defaultImageCtorParams(false));
+  ASSERT_NO_THROW(bmp.readMetadata());
+  ASSERT_EQ(320u, bmp.pixelWidth());
+  ASSERT_EQ(200u, bmp.pixelHeight());
+}
+
+TEST(BmpImage, readMetadataReadsCoreHeaderWhenPixelArrayHasTrailingBytes) {
+  // 1x1 24-bit core bitmap: one DWORD-padded row, plus trailing bytes that
+  // bfSize accounts for but that are not part of the pixel array.
+  std::vector<unsigned char> header{
+      'B',  'M',               // Signature
+      0x00, 0x00, 0x00, 0x00,  // bfSize, patched below
+      0x00, 0x00,              // Reserved
+      0x00, 0x00,              // Reserved
+      0x1A, 0x00, 0x00, 0x00,  // bfOffBits = 26
+      0x0C, 0x00, 0x00, 0x00,  // BITMAPCOREHEADER size
+      0x01, 0x00,              // Width 1
+      0x01, 0x00,              // Height 1
+      0x01, 0x00,              // Planes
+      0x18, 0x00,              // Bit count 24
+  };
+  header.insert(header.end(), 4, 0x7f);   // padded pixel row
+  header.insert(header.end(), 32, 0x00);  // trailing padding
+  header[2] = static_cast<unsigned char>(header.size() & 0xff);
+  header[3] = static_cast<unsigned char>((header.size() >> 8) & 0xff);
+  header[4] = static_cast<unsigned char>((header.size() >> 16) & 0xff);
+  header[5] = static_cast<unsigned char>((header.size() >> 24) & 0xff);
+
+  auto memIo = std::make_unique<MemIo>(header.data(), header.size());
+  BmpImage bmp(std::move(memIo), defaultImageCtorParams(false));
+  ASSERT_NO_THROW(bmp.readMetadata());
+  ASSERT_EQ(1u, bmp.pixelWidth());
+  ASSERT_EQ(1u, bmp.pixelHeight());
+}
+
+TEST(BmpImage, readMetadataReadsImageDimensionsForInfoHeader) {
+  const std::array<unsigned char, 26> header{
+      'B',  'M',               // Signature
+      0x4E, 0x47, 0x0D, 0x0A,  // Size of the BMP file in bytes
+      0x1A, 0x0A,              // Reserved
+      0x00, 0x00,              // Reserved
+      0x00, 0x00, 0x00, 0x00,  // Offset of the bitmap bits
+      0x28, 0x00, 0x00, 0x00,  // BITMAPINFOHEADER size (40)
+      0x00, 0x05, 0x00, 0x00,  // Width 1280
+      0x20, 0x03, 0x00, 0x00,  // Height 800
+  };
+
+  auto memIo = std::make_unique<MemIo>(header.data(), header.size());
+  BmpImage bmp(std::move(memIo), defaultImageCtorParams(false));
+  ASSERT_NO_THROW(bmp.readMetadata());
+  ASSERT_EQ(1280u, bmp.pixelWidth());
+  ASSERT_EQ(800u, bmp.pixelHeight());
+}
