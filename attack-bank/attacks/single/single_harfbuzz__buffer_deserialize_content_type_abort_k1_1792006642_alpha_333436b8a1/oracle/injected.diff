+static bool
+_hb_buffer_serialize_format_is_supported (hb_buffer_serialize_format_t format)
+{
+  if (unlikely (format == HB_BUFFER_SERIALIZE_FORMAT_INVALID))
+    return false;
+
+  for (unsigned int i = 0; i <= ARRAY_LENGTH (_hb_buffer_serialize_formats); i++)
+    if (format == hb_buffer_serialize_format_from_string (_hb_buffer_serialize_formats[i], -1))
+      return true;
+
+  return false;
+}
