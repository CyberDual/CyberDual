+/* If the host is a legacy numerical IPv4 address, rewrite it to dotted
+   decimal the same way full URL parsing does. Non-numerical names are left
+   untouched. *done is set when encp was replaced with the canonical form. */
+static CURLUcode host_canon_ipv4(struct dynbuf *encp, const char *host,
+                                size_t hostlen, bool *done)
+{
+  struct dynbuf norm;
+  char buf[256];
+  CURLcode result;
+  int type;
+
+  *done = FALSE;
+  if(!hostlen || !ISDIGIT(*host))
+    return CURLUE_OK;
+
+  /* ipv4_normalize consumes a C string. Ordinary hosts fit in a scratch
+     buffer; longer values (leading zeroes) are appended by length. */
+  curlx_dyn_init(&norm, CURL_MAX_INPUT_LENGTH);
+  if(hostlen <= sizeof(buf)) {
+    memcpy(buf, host, hostlen);
+    buf[hostlen] = 0;
+    result = curlx_dyn_add(&norm, buf);
+  }
+  else
+    result = curlx_dyn_addn(&norm, host, hostlen);
+  if(result) {
+    curlx_dyn_free(&norm);
+    curlx_dyn_free(encp);
+    return cc2cu(result);
+  }
+
+  type = ipv4_normalize(&norm);
+  if(type == HOST_IPV4) {
+    curlx_dyn_reset(encp);
+    result = curlx_dyn_add(encp, curlx_dyn_ptr(&norm));
+    curlx_dyn_free(&norm);
+    if(result) {
+      curlx_dyn_free(encp);
+      return cc2cu(result);
+    }
+    *done = TRUE;
+    return CURLUE_OK;
+  }
+  curlx_dyn_free(&norm);
+  if(type == HOST_ERROR) {
+    curlx_dyn_free(encp);
+    return CURLUE_OUT_OF_MEMORY;
+  }
+  return CURLUE_OK;
+}
