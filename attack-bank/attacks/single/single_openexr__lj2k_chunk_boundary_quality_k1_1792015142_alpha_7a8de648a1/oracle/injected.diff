diff --git a/src/lib/OpenEXRCore/internal_ht.cpp b/src/lib/OpenEXRCore/internal_ht.cpp
index 6e3cf25d94f257c63157605ef3ccec744efa9dc3..fa8fc11413232a5a196c783dfdc489ca93f2e879 100644
--- a/src/lib/OpenEXRCore/internal_ht.cpp
+++ b/src/lib/OpenEXRCore/internal_ht.cpp
@@ -23,6 +23,27 @@
 #include "internal_ht_quality.h"
 #include "internal_legacy_structs.h"
 
+// Samples of symmetric extension kept around every lossy LJ2K chunk so the
+// 9/7 synthesis boundary falls outside the stored image. 32 covers the
+// finest-level filter and most of the coarser-level support at 5
+// decompositions. The codestream image is this much larger on each side;
+// the OpenEXR chunk geometry is unchanged.
+static constexpr int LJ2K_BOUNDARY_GUARD = 32;
+
+static int
+reflect_sample (int i, int n)
+{
+    if (n <= 1) return 0;
+    while (i < 0 || i >= n)
+    {
+        if (i < 0)
+            i = -i - 1;
+        else
+            i = n + n - i - 1;
+    }
+    return i;
+}
+
 /**
  * OpenJPH output file that is backed by a fixed-size memory buffer
  */
@@ -286,19 +307,43 @@ ht_undo_impl (
     ojph::ui32 image_width =
         siz.get_image_extent ().x - siz.get_image_offset ().x;
 
-    if (decode->chunk.width != image_width
-        || decode->chunk.height != image_height
-        || decode->channel_count != siz.get_num_components())
+    if (decode->channel_count != siz.get_num_components ())
+        return EXR_ERR_CORRUPT_CHUNK;
+
+    // Lossy LJ2K codestreams may carry a reflected guard band. Legacy
+    // chunks (and lossless HTJ2K) match the chunk dimensions exactly.
+    int boundary_guard = 0;
+    if (image_width ==
+            (ojph::ui32) decode->chunk.width + (ojph::ui32) (2 * LJ2K_BOUNDARY_GUARD) &&
+        image_height ==
+            (ojph::ui32) decode->chunk.height + (ojph::ui32) (2 * LJ2K_BOUNDARY_GUARD))
+    {
+        boundary_guard = LJ2K_BOUNDARY_GUARD;
+    }
+    else if (
+        decode->chunk.width != (int32_t) image_width ||
+        decode->chunk.height != (int32_t) image_height)
+    {
         return EXR_ERR_CORRUPT_CHUNK;
+    }
 
     for (int cs_i = 0; cs_i < decode->channel_count; cs_i++)
     {
         int file_i = cs_to_file_ch[cs_i].file_index;
-
-        if (decode->channels[file_i].height != siz.get_recon_height (cs_i) ||
-            decode->channels[file_i].width != siz.get_recon_width (cs_i) ||
-            decode->channels[file_i].height != image_height / siz.get_downsampling (cs_i).y ||
-            decode->channels[file_i].width != image_width / siz.get_downsampling (cs_i).x)
+        int xs     = decode->channels[file_i].x_samples;
+        int ys     = decode->channels[file_i].y_samples;
+        if (xs < 1) xs = 1;
+        if (ys < 1) ys = 1;
+
+        const int exp_w =
+            decode->channels[file_i].width + (boundary_guard * 2) / xs;
+        const int exp_h =
+            decode->channels[file_i].height + (boundary_guard * 2) / ys;
+
+        if (exp_h != (int) siz.get_recon_height (cs_i) ||
+            exp_w != (int) siz.get_recon_width (cs_i) ||
+            exp_h != (int) (image_height / siz.get_downsampling (cs_i).y) ||
+            exp_w != (int) (image_width / siz.get_downsampling (cs_i).x))
             return EXR_ERR_CORRUPT_CHUNK;
     }
 
@@ -318,6 +363,8 @@ ht_undo_impl (
 
     cs.create ();
 
+    if (boundary_guard && cs.is_planar ()) return EXR_ERR_CORRUPT_CHUNK;
+
     ojph::param_cod cod = cs.access_cod ();
     assert (sizeof (uint16_t) == 2);
     assert (sizeof (uint32_t) == 4);
@@ -393,15 +440,23 @@ ht_undo_impl (
