+/* The version number of an XML declaration must match production
+   VersionNum, i.e. "1." followed by one or more digits.  The value is
+   restricted to ASCII by parsePseudoAttribute, so convert it once and
+   check the characters directly. */
+static int
+checkXmlDeclVersionNum(const ENCODING *enc, const char *ptr, const char *end) {
+  char buf[64];
+  size_t len = 0;
+  size_t i;
+  for (; ptr != end; ptr += enc->minBytesPerChar) {
+    const int c = toAscii(enc, ptr, end);
+    if (c == -1)
+      return 0;
+    buf[len++] = (char)c;
+  }
+  if (len < 3 || buf[0] != ASCII_1 || buf[1] != ASCII_PERIOD)
+    return 0;
+  for (i = 2; i < len; i++) {
+    if (! (ASCII_0 <= buf[i] && buf[i] <= ASCII_9))
+      return 0;
+  }
+  return 1;
+}
