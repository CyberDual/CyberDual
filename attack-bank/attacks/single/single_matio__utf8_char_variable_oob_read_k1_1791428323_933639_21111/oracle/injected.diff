+static int
+ValidateUtf8Data(const mat_uint8_t *data, size_t nbytes, size_t nelems)
+{
+    size_t i = 0, count = 0;
+
+    while ( i < nbytes ) {
+        size_t j, width;
+        const mat_uint8_t c = data[i];
+        if ( c < 0x80 )
+            width = 1;
+        else if ( (c & 0xe0) == 0xc0 )
+            width = 2;
+        else if ( (c & 0xf0) == 0xe0 )
+            width = 3;
+        else if ( (c & 0xf8) == 0xf0 )
+            width = 4;
+        else
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+
+        if ( width > nbytes - i )
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+        for ( j = 1; j < width; j++ ) {
+            if ( (data[i + j] & 0xc0) != 0x80 )
+                return MATIO_E_FILE_FORMAT_VIOLATION;
+        }
+        if ( width == 4 && i + width <= nbytes && (data[i + width] & 0xc0) == 0x80 )
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+        i += width;
+        count++;
+    }
+
+    return count == nelems ? MATIO_E_NO_ERROR : MATIO_E_FILE_FORMAT_VIOLATION;
+}
