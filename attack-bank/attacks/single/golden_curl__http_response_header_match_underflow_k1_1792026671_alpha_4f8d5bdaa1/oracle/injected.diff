--- a/lib/http.c
+++ b/lib/http.c
@@ -1440,6 +1440,15 @@ bool Curl_compareheader(const char *headerline, /* line to check */
       do
         curlx_str_passblanks(&p);
       while(!curlx_str_single(&p, ','));
+      /* trailing blanks may move the parsing point past the value end */
+      if((size_t)(p - o) > len) {
+        if((p[clen] == ',') || ISBLANK(p[clen]) || ISNEWLINE(p[clen]) ||
+           !p[clen]) {
+          if(curl_strnequal(p, content, clen))
+            return TRUE;
+        }
+        break;
+      }
       len -= (p - o);
     }
