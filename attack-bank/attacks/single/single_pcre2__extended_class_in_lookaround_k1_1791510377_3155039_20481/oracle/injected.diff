diff --git a/src/pcre2_compile.c b/src/pcre2_compile.c
index 8393640a60b5f9afcbe8394d7f1efcb2fdbd3ba5..a6e7bf0704a3caa9cdb9a52c6fcd814b0452231e 100644
--- a/src/pcre2_compile.c
+++ b/src/pcre2_compile.c
@@ -9663,8 +9663,33 @@ for (;; pptr++)
     case META_CLASS:
     case META_CLASS_NOT:
     itemlength = itemminlength = 1;
-    pptr = parsed_skip(pptr, PSKIP_CLASS);
-    if (pptr == NULL) goto PARSED_SKIP_FAILED;
+
+    /* An extended class may contain nested classes, so a single scan to the
+    first META_CLASS_END is not sufficient; we must balance the nesting to find
+    the terminator of this class. A plain class has no nesting and ends at its
+    first META_CLASS_END. */
+
+    if ((*pptr & CLASS_IS_ECLASS) != 0)
+      {
+      uint32_t nest = 1;
+      for (;;)
+        {
+        uint32_t cc;
+        pptr++;
+        cc = META_CODE(*pptr);
+        if (cc == META_CLASS_END)
+          {
+          if (--nest == 0) break;
+          }
+        else if (cc >= META_CLASS && cc <= META_CLASS_NOT)
+          nest++;
+        }
+      }
+    else
+      {
+      pptr = parsed_skip(pptr, PSKIP_CLASS);
+      if (pptr == NULL) goto PARSED_SKIP_FAILED;
+      }
     break;
 
     case META_CLASS_EMPTY_NOT:
