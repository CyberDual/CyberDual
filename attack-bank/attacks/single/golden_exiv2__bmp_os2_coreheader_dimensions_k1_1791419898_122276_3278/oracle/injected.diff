-  byte buf[26];
+  byte buf[18];
   if (io_->read(buf, sizeof(buf)) == sizeof(buf)) {
-    pixelWidth_ = getULong(buf + 18, littleEndian);
-    pixelHeight_ = getULong(buf + 22, littleEndian);
+    const uint32_t headerSize = getULong(buf + 14, littleEndian);
+    // Read the rest of the DIB header (the 4-byte header size field was already
+    // consumed above) so the width and height fields can be read at the offsets
+    // that match the header layout.
+    DataBuf header = io_->read(headerSize - 4);
+    if (headerSize == 12) {
+      pixelWidth_ = getUShort(header.c_data(), littleEndian);
+      pixelHeight_ = getUShort(header.c_data() + 2, littleEndian);
+    } else {
+      pixelWidth_ = getULong(header.c_data(), littleEndian);
+      pixelHeight_ = getULong(header.c_data() + 4, littleEndian);
+    }
   }
 }
 
