diff --git a/lib/urlapi.c b/lib/urlapi.c
index 1c4db04e46388df390e037b5147724b62e40d809..4ee4f99555062e4df2d7f8467bf7c4a0446ff453 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -2056,10 +2056,26 @@ static CURLUcode url_sethost(CURLU *u, struct dynbuf *encp,
     CURLcode result = Curl_urldecode(newp, n, &decoded, &dlen, REJECT_CTRL);
     if(result || hostname_check6(u, decoded, dlen))
       bad = TRUE;
+    else {
+      /* a legacy numerical IPv4 address is stored in its canonical dot
+         decimal form, like when the host is parsed as part of a full URL */
+      struct dynbuf dbuf;
+      curlx_dyn_init(&dbuf, CURL_MAX_INPUT_LENGTH);
+      if(curlx_dyn_addn(&dbuf, decoded, dlen))
+        bad = TRUE;
+      else if(ipv4_normalize(&dbuf) == HOST_IPV4) {
+        size_t nlen = curlx_dyn_len(&dbuf);
+        memcpy(newp, curlx_dyn_ptr(&dbuf), nlen + 1);
+        curlx_dyn_setlen(encp, nlen);
+      }
+      curlx_dyn_free(&dbuf);
+    }
     curlx_free(decoded);
   }
   else if(hostname_check6(u, newp, n))
     bad = TRUE;
+  else if(ipv4_normalize(encp) == HOST_ERROR)
+    bad = TRUE;
   if(bad) {
     curlx_dyn_free(encp);
     return CURLUE_BAD_HOSTNAME;
