diff --git a/src/mcos.c b/src/mcos.c
index 5b7582866920c4b9ada50d1488fe8312baaab62a..da5b00179dc4c01d1ded13e299f80a3728c393a1 100644
--- a/src/mcos.c
+++ b/src/mcos.c
@@ -1559,6 +1559,8 @@ static int
 IsEnumStruct(const matvar_t *matvar)
 {
     const matvar_t *tag;
+    const mat_uint32_t *u32;
+    size_t n = 1, navail, i;
 
     if ( matvar == NULL || matvar->class_type != MAT_C_STRUCT )
         return 0;
@@ -1567,7 +1569,33 @@ IsEnumStruct(const matvar_t *matvar)
     if ( tag == NULL || tag->class_type != MAT_C_UINT32 || tag->data == NULL )
         return 0;
 
-    return ((const mat_uint32_t *)tag->data)[0] == MCOS_REF_VALUE;
+    if ( Mat_MulDims(tag, &n) )
+        return 0;
+
+    /* Empty and truncated tags cannot hold the reference marker. */
+    navail = tag->nbytes / sizeof(mat_uint32_t);
+    if ( n < 1 || navail < 1 )
+        return 0;
+    if ( n > navail )
+        n = navail;
+
+    u32 = (const mat_uint32_t *)tag->data;
+    if ( u32[0] != MCOS_REF_VALUE )
+        return 0;
+
+    /* A tag longer than a scalar uses the MCOS reference header: word 1 is a
+     * dimension count and the following words are sizes. */
+    if ( n > 1 ) {
+        mat_uint32_t ndims = u32[1];
+        if ( (size_t)ndims + 2 > n )
+            return 0;
+        for ( i = 0; i <= ndims; i++ ) {
+            if ( u32[2 + i] > (mat_uint32_t)matvar->rank )
+                return 0;
+        }
+    }
+
+    return 1;
 }
 
 /** @brief Recursively check for a nested enumeration instance struct
