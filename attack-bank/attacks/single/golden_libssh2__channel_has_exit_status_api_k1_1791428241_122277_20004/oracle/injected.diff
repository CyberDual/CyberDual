index 0000000000000000000000000000000000000000..0682ed461ff819f73979e3af6a2ff89e7c3b9b7d
--- /dev/null
+++ b/docs/libssh2_channel_has_exit_status.md
@@ -0,0 +1,34 @@
+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - check whether the remote end sent an exit
+status
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+~~~
+
+# DESCRIPTION
+
+*channel* - Closed channel stream to check for a received exit status.
+
+libssh2_channel_get_exit_status(3) returns 0 both for a real exit status of
+0 and for a channel that never received an exit-status request, for example
+because the server force-closed the session. This function tells those two
+cases apart.
+
+# RETURN VALUE
+
+Returns 1 if the channel received an exit-status request, 0 otherwise.
