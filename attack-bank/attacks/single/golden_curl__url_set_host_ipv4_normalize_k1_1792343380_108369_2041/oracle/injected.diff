index 1c4db04e46388df390e037b5147724b62e40d809..a73502424beb78fb47430b7df49db22404d7abbd 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -2038,6 +2038,34 @@ nomem:
   return CURLUE_OK;
 }
 
+static bool normalize_ipv4_host(struct dynbuf *host,
+                                const char *hostname, size_t length)
+{
+  struct dynbuf normalized;
+  bool bad = FALSE;
+
+  curlx_dyn_init(&normalized, CURL_MAX_INPUT_LENGTH);
+  if(curlx_dyn_addn(&normalized, hostname, length))
+    bad = TRUE;
+  else {
+    int type = ipv4_normalize(&normalized);
+
+    if(type == HOST_ERROR)
+      bad = TRUE;
+    else if(type == HOST_IPV4) {
+      CURLcode result;
+
+      curlx_dyn_reset(host);
+      result = curlx_dyn_addn(host, curlx_dyn_ptr(&normalized),
+                              curlx_dyn_len(&normalized));
+      if(result == CURLE_OUT_OF_MEMORY)
+        bad = TRUE;
+    }
+  }
+  curlx_dyn_free(&normalized);
+  return bad;
+}
+
 static CURLUcode url_sethost(CURLU *u, struct dynbuf *encp,
                              bool urlencode,
                              unsigned int flags)
@@ -2054,11 +2082,13 @@ static CURLUcode url_sethost(CURLU *u, struct dynbuf *encp,
     size_t dlen;
     char *decoded = NULL;
     CURLcode result = Curl_urldecode(newp, n, &decoded, &dlen, REJECT_CTRL);
-    if(result || hostname_check6(u, decoded, dlen))
+    if(result || hostname_check6(u, decoded, dlen) ||
+       normalize_ipv4_host(encp, decoded, dlen))
       bad = TRUE;
     curlx_free(decoded);
   }
-  else if(hostname_check6(u, newp, n))
