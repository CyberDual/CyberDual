@@ -406,10 +406,9 @@ static size_t encoder_base64_read(char *buffer, size_t size, bool ateof,
         i |= (st->buf[st->bufbeg] & 0xFF) << 16;
         ptr[0] = curlx_base64encdec[(i >> 18) & 0x3F];
