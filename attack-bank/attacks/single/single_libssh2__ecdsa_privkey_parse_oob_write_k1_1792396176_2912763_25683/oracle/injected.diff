diff --git a/src/knownhost.c b/src/knownhost.c
index 077aeda7346f27eb199abd63d7c25ce1cd3ebfb3..eb616f511dfb66e36dfd88458f7812b51686c6b0 100644
--- a/src/knownhost.c
+++ b/src/knownhost.c
@@ -667,24 +667,31 @@ static int knownhost_line_legacy(LIBSSH2_KNOWNHOSTS *hosts,
         if(name == host || *(name - 1) == ',') {
 
             char hostbuf[256];
-
-            /* make sure we do not overflow the buffer */
-            if(namelen >= sizeof(hostbuf) - 1)
-                return ssh2_err(hosts->session,
-                                LIBSSH2_ERROR_METHOD_NOT_SUPPORTED,
-                                "Failed to parse known_hosts line "
-                                "(unexpected length)");
+            char *hostptr = hostbuf;
+
+            /* keep short names on the stack, allocate longer ones */
+            if(namelen >= sizeof(hostbuf)) {
+                hostptr = SSH2_ALLOC(hosts->session, namelen);
+                if(!hostptr)
+                    return ssh2_err(hosts->session,
+                                    LIBSSH2_ERROR_ALLOC,
+                                    "Unable to allocate memory for hostname");
+            }
 
             /* copy hostname to the temp buffer and null-terminate */
-            memcpy(hostbuf, name, namelen);
-            hostbuf[namelen] = '\0';
+            memcpy(hostptr, name, namelen);
+            hostptr[namelen] = '\0';
 
-            rc = knownhost_add(hosts, hostbuf, NULL,
+            rc = knownhost_add(hosts, hostptr, NULL,
                                key_type_name, key_type_len,
                                key, keylen,
                                comment, commentlen,
                                key_type | LIBSSH2_KNOWNHOST_TYPE_PLAIN |
                                LIBSSH2_KNOWNHOST_KEYENC_BASE64, NULL);
+
+            if(hostptr != hostbuf)
+                SSH2_FREE(hosts->session, hostptr);
+
             if(rc)
                 return rc;
 
diff --git a/src/openssl.c b/src/openssl.c
index ad67f5cba9cb304771ced217d2ff8b2c46ea51b3..eb578361e7b7284b365b0019045fb4a4befdc65c 100644
--- a/src/openssl.c
+++ b/src/openssl.c
@@ -183,6 +183,10 @@ static SSH2_INLINE void ossl_swap_bytes(unsigned char *buf, size_t len)
 {
 #if !defined(WORDS_BIGENDIAN) || !WORDS_BIGENDIAN
     size_t i, j;
+
+    if(len < 2)
+        return;
+
     for(i = 0, j = len - 1; i < j; i++, j--) {
         unsigned char temp = buf[i];
         buf[i] = buf[j];
@@ -2593,7 +2597,8 @@ static int ossl_ecdsa_openssh_priv_to_pubkey(LIBSSH2_SESSION *session,
         return -1;
     }
 
-    if(ssh2_get_bignum_bytes(decrypted, &exponent, &exponent_len)) {
+    if(ssh2_get_bignum_bytes(decrypted, &exponent, &exponent_len) ||
+       !exponent_len) {
         ssh2_err(session, LIBSSH2_ERROR_PROTO, "ECDSA no exponent");
         return -1;
     }
