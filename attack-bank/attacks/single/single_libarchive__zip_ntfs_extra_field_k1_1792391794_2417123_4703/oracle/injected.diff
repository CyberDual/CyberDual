+/*
+ * A Windows FILETIME is a 64-bit count of 100-nanosecond intervals
+ * since 1601-01-01T00:00:00Z, which is 11644473600 seconds before the
+ * Unix epoch.  Convert one to a time_t, returning the sub-second part
+ * as nanoseconds.
+ */
+static time_t
+ntfs_filetime_to_time_t(uint64_t filetime, long *nsec)
+{
+	const uint64_t epoch_difference = UINT64_C(11644473600);
+	uint64_t sec = filetime / 10000000;
+
+	*nsec = (long)(filetime % 10000000) * 100;
+	if (sec >= epoch_difference)
+		return (time_t)(sec - epoch_difference);
+	else
+		return -(time_t)(epoch_difference - sec);
+}
