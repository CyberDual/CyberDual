+      extents->x_bearing = hb_clamp_to<hb_position_t> (new_x1);
+      extents->width = hb_clamp_to<hb_position_t> (new_x2 - new_x1);
     }
 
     /* Embolden. */
@@ -234,15 +245,15 @@ struct hb_font_t
