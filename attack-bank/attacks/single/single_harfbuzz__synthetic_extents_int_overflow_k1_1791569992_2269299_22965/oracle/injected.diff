       if (embolden_in_place)
-	extents->x_bearing -= x_shift / 2;
-      extents->width += x_shift;
+	extents->x_bearing = hb_saturate_sub (extents->x_bearing, x_shift / 2);
+      extents->width = hb_saturate_add (extents->width, x_shift);
     }
   }
 
