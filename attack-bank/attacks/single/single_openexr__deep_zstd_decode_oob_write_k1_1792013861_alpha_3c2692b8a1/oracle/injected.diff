diff --git a/src/lib/OpenEXRCore/internal_zstd.c b/src/lib/OpenEXRCore/internal_zstd.c
index 670b92a73c768ebf3b5cc4cec26d92c90fe23b79..56e7ef53113a195babb40b139c5fa8105e9cb2e4 100644
--- a/src/lib/OpenEXRCore/internal_zstd.c
+++ b/src/lib/OpenEXRCore/internal_zstd.c
@@ -858,6 +858,35 @@ exr_zstd_fill_channel_sample_count_grid (
     }
 }
 
+/** Total packed bytes described by a (line, channel) sample grid.
+ *  Returns -1 if a count would overflow or a channel width is not 2 or 4. */
+static int
+exr_zstd_grid_packed_bytes (
+    const uint64_t*                  num_samples_grid,
+    int                              height,
+    const exr_coding_channel_info_t* channels,
+    int                              channelsSize,
+    uint64_t*                        out_bytes)
+{
+    uint64_t total = 0;
+
+    for (int h = 0; h < height; ++h)
+    {
+        for (int i = 0; i < channelsSize; ++i)
+        {
+            int const bpe = channels[i].bytes_per_element;
+            if (bpe != 2 && bpe != 4) return -1;
+            uint64_t const n = num_samples_grid[h * channelsSize + i];
+            if (n > (UINT64_MAX / (uint64_t) bpe)) return -1;
+            uint64_t const bytes = n * (uint64_t) bpe;
+            if (total > UINT64_MAX - bytes) return -1;
+            total += bytes;
+        }
+    }
+    *out_bytes = total;
+    return 0;
+}
+
 /* --- Main Pipeline Implementation --- */
 
 /** Store raw packed payload as the chunk (no ZSTD); used only when ZSTD
@@ -1298,6 +1327,22 @@ exr_undo_zstd_v1 (
         sorting_lookup,
         pack_channels);
 
+    /* The inverse sort copies grid-sized spans into a buffer of
+     * uncompressed_size. A deep sample-count table can describe more
+     * bytes than that buffer; reject it before the copy. */
+    uint64_t grid_bytes = uncompressed_size;
+    if (grid_scenario == EXR_ZSTD_GRID_DEEP_PIXELS)
+    {
+        if (exr_zstd_grid_packed_bytes (
+                channel_sample_count_grid,
+                chunk_line_count,
+                pack_channels,
+                pack_channel_count,
+                &grid_bytes) != 0 ||
+            grid_bytes > uncompressed_size)
+            return EXR_ERR_CORRUPT_CHUNK;
+    }
+
     exr_zstd_pack_pipeline pipe;
     exr_zstd_build_decode_pipeline (fr.format, fr.flags, &pipe);
 
@@ -1361,6 +1406,16 @@ exr_undo_zstd_v1 (
         (char*) uncompressed_data,
         sorting_lookup);
 
+    if (grid_scenario == EXR_ZSTD_GRID_DEEP_PIXELS &&
+        grid_bytes < uncompressed_size)
+    {
+        size_t const prefix = (size_t) grid_bytes;
+        memset (
+            (uint8_t*) uncompressed_data + prefix,
+            0,
+            (size_t) uncompressed_size);
+    }
+
     return EXR_ERR_SUCCESS;
 }
 
