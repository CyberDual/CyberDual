@@ -183,6 +183,11 @@ static SSH2_INLINE void ossl_swap_bytes(unsigned char *buf, size_t len)
 {
 #if !defined(WORDS_BIGENDIAN) || !WORDS_BIGENDIAN
     size_t i, j;
+
+    /* A zero length underflows j and walks off the buffer. */
+    if(len < 2)
+        return;
+
     for(i = 0, j = len - 1; i < j; i++, j--) {
         unsigned char temp = buf[i];
         buf[i] = buf[j];
@@ -2576,6 +2581,8 @@ static int ossl_ecdsa_openssh_priv_to_pubkey(LIBSSH2_SESSION *session,
     OSSL_PARAM params[4];
     const char *n = EC_curve_nid2nist(curve);
     char *group_name = NULL;
+    unsigned char *x_buf = NULL;
+    size_t xlen_max = 0;
 #else
     BIGNUM *bn_exponent;
 #endif
@@ -2602,6 +2609,26 @@ static int ossl_ecdsa_openssh_priv_to_pubkey(LIBSSH2_SESSION *session,
     if(!n)
         return -1;
 
+    if(!exponent_len) {
+        ssh2_err(session, LIBSSH2_ERROR_PROTO, "ECDSA empty exponent");
+        return -1;
+    }
+
+    if(curve == SSH2_EC_CURVE_NISTP256)
+        xlen_max = 32;
+    else if(curve == SSH2_EC_CURVE_NISTP384)
+        xlen_max = 48;
+    else if(curve == SSH2_EC_CURVE_NISTP521)
+        xlen_max = 66;
+    else
+        xlen_max = exponent_len;
+
+    /* mpint may include one leading sign byte past the curve order */
+    if(exponent_len > xlen_max + 1) {
+        ssh2_err(session, LIBSSH2_ERROR_PROTO, "ECDSA exponent too large");
+        return -1;
+    }
+
