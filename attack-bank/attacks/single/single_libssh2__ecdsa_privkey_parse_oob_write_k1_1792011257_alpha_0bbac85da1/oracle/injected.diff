-    params[2] = OSSL_PARAM_construct_BN(OSSL_PKEY_PARAM_PRIV_KEY, exponent,
+    params[2] = OSSL_PARAM_construct_BN(OSSL_PKEY_PARAM_PRIV_KEY, x_buf,
                                         exponent_len);
     params[3] = OSSL_PARAM_construct_end();
 
@@ -2627,8 +2664,14 @@ static int ossl_ecdsa_openssh_priv_to_pubkey(LIBSSH2_SESSION *session,
     rc = EVP_PKEY_fromdata(fromdata_ctx, &ctx, EVP_PKEY_KEYPAIR, params);
     rc = rc != 1;
 
-    if(group_name)
+    if(group_name) {
         OPENSSL_clear_free(group_name, strlen(n) + 1);
+        group_name = NULL;
+    }
+    if(x_buf) {
