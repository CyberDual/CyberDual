 }
 
+/*
+ * Match a key type name that is not NUL-terminated within the line
+ * against the known key types.
+ */
+static int knownhost_key_type(const char *name, size_t namelen)
+{
+    char buf[20];
+
+    if(namelen > sizeof(buf))
+        return LIBSSH2_KNOWNHOST_KEY_UNKNOWN;
+
+    memcpy(buf, name, namelen);
+    buf[namelen] = '\0';
+
+    if(!strcmp(buf, "ssh-ed25519"))
+        return LIBSSH2_KNOWNHOST_KEY_ED25519;
+    if(!strcmp(buf, "ecdsa-sha2-nistp256"))
+        return LIBSSH2_KNOWNHOST_KEY_ECDSA_256;
+    if(!strcmp(buf, "ecdsa-sha2-nistp384"))
+        return LIBSSH2_KNOWNHOST_KEY_ECDSA_384;
+    if(!strcmp(buf, "ecdsa-sha2-nistp521"))
+        return LIBSSH2_KNOWNHOST_KEY_ECDSA_521;
+    if(!strcmp(buf, "ssh-rsa"))
+        return LIBSSH2_KNOWNHOST_KEY_SSHRSA;
+#if LIBSSH2_DSA && !defined(LIBSSH2_NO_DEPRECATED)
+    if(!strcmp(buf, "ssh-dss"))
+        return LIBSSH2_KNOWNHOST_KEY_SSHDSS;
+#endif
+    return LIBSSH2_KNOWNHOST_KEY_UNKNOWN;
+}
