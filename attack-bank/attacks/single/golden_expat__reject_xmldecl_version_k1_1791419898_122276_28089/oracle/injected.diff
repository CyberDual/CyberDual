 static const char KW_no[] = {ASCII_n, ASCII_o, '\0'};
 
+/* Checks a version pseudo-attribute value against the VersionNum
+   production.  Expat only implements XML 1.0 itself, but accepts the
+   Fifth Edition's laxer "1." followed by one or more digits so that
+   values such as "1.1" are not rejected now only to be allowed again
+   once Expat tracks the newer edition.  val/valEnd bound the value;
+   returns true for a value matching "1.[0-9]+". */
+static bool
+checkXmlDeclVersionNum(const ENCODING *enc, const char *val,
+                       const char *valEnd) {
+  char num[16];
+  int len = 0;
+  for (; val != valEnd; val += enc->minBytesPerChar)
+    num[len++] = (char)toAscii(enc, val, valEnd);
+  if (len < 3 || num[0] != ASCII_1 || num[1] != ASCII_PERIOD)
+    return false;
+  for (int i = 2; i < len; i++) {
+    if (num[i] < ASCII_0 || num[i] > ASCII_9)
+      return false;
+  }
+  return true;
+}
