@@ -3723,6 +3723,26 @@ START_TEST(test_negative_len_parse_buffer) {
 }
 END_TEST
 
+/* Test XML_ParseBuffer rejects an oversized buffer */
+START_TEST(test_parse_buffer_exceeds_buffer) {
+  XML_Parser parser = XML_ParserCreate(NULL);
+  if (parser == NULL)
+    fail("Parser allocation failed.");
+
+  void *const buffer = XML_GetBuffer(parser, 10);
+  if (buffer == NULL)
+    fail("XML_GetBuffer failed.");
+
+  const enum XML_Status status = XML_ParseBuffer(parser, 10000, XML_TRUE);
+  if (status != XML_STATUS_ERROR)
+    fail("Oversized XML_ParseBuffer was expected to fail.");
+  if (XML_GetErrorCode(parser) != XML_ERROR_INVALID_ARGUMENT)
+    fail("Expected XML_ERROR_INVALID_ARGUMENT.");
+
+  XML_ParserFree(parser);
+}
+END_TEST
