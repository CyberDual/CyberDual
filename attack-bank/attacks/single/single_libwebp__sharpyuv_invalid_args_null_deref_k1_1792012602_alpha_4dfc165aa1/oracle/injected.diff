+// Rescale one matrix row into yuv_bit_depth. Slopes use 64-bit multiply so a
+// wide coefficient cannot overflow int32; the offset is shifted in 64-bit for
+// the same reason. Returns 0 if a result does not fit in int.
+static int ScaleMatrixRow(const int in[4], int out[4], int same_depth,
+                          int yuv_max, int rgb_max, int rgb_round, int sfix) {
+  int i;
+  for (i = 0; i < 3; ++i) {
+    const int64_t scaled =
+        same_depth ? (int64_t)in[i]
+                   : ((int64_t)in[i] * yuv_max + rgb_round) / rgb_max;
+    if (scaled > INT_MAX || scaled < INT_MIN) return 0;
+    out[i] = (int)scaled;
+  }
+  {
+    int64_t shifted;
+    if (sfix >= 0) {
+      if (sfix >= 63) return 0;
+      shifted = (int64_t)((uint64_t)in[3] << (unsigned)sfix);
+    } else {
+      if (sfix <= -63) return 0;
+      shifted = (int64_t)in[3] >> (unsigned)(-sfix);
+    }
+    if (shifted > INT_MAX || shifted < INT_MIN) return 0;
+    out[3] = (int)shifted;
+  }
+  return 1;
+}
+
+static int BuildScaledMatrix(const SharpYuvConversionMatrix* in,
+                             SharpYuvConversionMatrix* out, int rgb_bit_depth,
+                             int yuv_bit_depth) {
+  const int same = (rgb_bit_depth == yuv_bit_depth);
+  const int rgb_max = (1 << rgb_bit_depth) - 1;
+  const int rgb_round = 1 << (rgb_bit_depth - 1);
+  const int yuv_max = (1 << yuv_bit_depth) - 1;
+  const int sfix = GetPrecisionShift(rgb_bit_depth);
+  if (!ScaleMatrixRow(in->rgb_to_y, out->rgb_to_y, same, yuv_max, rgb_max,
+                      rgb_round, sfix) ||
+      !ScaleMatrixRow(in->rgb_to_u, out->rgb_to_u, same, yuv_max, rgb_max,
+                      rgb_round, sfix) ||
+      !ScaleMatrixRow(in->rgb_to_v, out->rgb_to_v, same, yuv_max, rgb_max,
+                      rgb_round, sfix)) {
+    return 0;
+  }
+  return 1;
+}
+
+// Rewrite a bottom-up plane (negative rgb_stride) into a top-down buffer so
+// the row iterator's 2 * stride add cannot overflow int32.
+static int NormalizeNegativeStride(const uint8_t** r_ptr, const uint8_t** g_ptr,
+                                   const uint8_t** b_ptr, int* rgb_stride,
+                                   int height, uint8_t** storage) {
+  const int64_t stride64 = *rgb_stride;
+  const uint64_t abs_stride = (uint64_t)(-stride64);
+  const uint64_t plane_bytes64 = (uint64_t)height * abs_stride;
+  uint8_t* buf;
+  const uint8_t* srcs[3];
+  int p;
+  if (abs_stride > (uint64_t)INT_MAX || plane_bytes64 != (size_t)plane_bytes64 ||
+      plane_bytes64 > SIZE_MAX / 3) {
+    return 0;
+  }
+  buf = (uint8_t*)malloc((size_t)plane_bytes64 * 3);
+  if (buf == NULL) return 0;
+  srcs[0] = *r_ptr;
+  srcs[1] = *g_ptr;
+  srcs[2] = *b_ptr;
+  for (p = 0; p < 3; ++p) {
+    const int64_t base_off = (int64_t)height * stride64;
+    const uint8_t* const base = srcs[p] + (ptrdiff_t)base_off;
+    uint8_t* const dst = buf + (size_t)p * (size_t)plane_bytes64;
+    memcpy(dst, base, (size_t)plane_bytes64);
+  }
+  *r_ptr = buf;
+  *g_ptr = buf + (size_t)plane_bytes64;
+  *b_ptr = buf + 2 * (size_t)plane_bytes64;
+  *rgb_stride = (int)abs_stride;
+  *storage = buf;
+  return 1;
+}
