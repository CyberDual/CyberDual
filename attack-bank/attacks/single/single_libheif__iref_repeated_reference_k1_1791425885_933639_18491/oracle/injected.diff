-    echo "Example:"
-    echo "  mkdir buildjs"
-    echo "  cd buildjs"
-    echo "  USE_WASM=0 ../build-emscripten.sh .."
-    echo
-    echo "This should generate a libheif.js and (optionally, without the USE_WASM=0) a libheif.wasm"
