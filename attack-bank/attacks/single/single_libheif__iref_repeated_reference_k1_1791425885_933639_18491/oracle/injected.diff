-
-        emmake make -j${CORES}
-
-        cd ..
-    fi
-
-    AOM_DIR="$(pwd)/aom-${AOM_VERSION}"
-    CONFIGURE_ARGS_AOM="-DAOM_INCLUDE_DIR=${AOM_DIR}/aom-source -DAOM_LIBRARY=-L${AOM_DIR}"
