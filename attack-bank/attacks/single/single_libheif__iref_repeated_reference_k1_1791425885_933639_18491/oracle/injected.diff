-
-# Webcodecs is not on by default b/c asyncify increases the binary size considerably
-ENABLE_WEBCODECS="${ENABLE_WEBCODECS:-0}"
-
-ENABLE_UNCOMPRESSED="${ENABLE_UNCOMPRESSED:-0}"
