-            -DAOM_TARGET_CPU=generic \
-            -DENABLE_APPS=0 \
-            -DENABLE_DOCS=0 \
-            -DENABLE_TESTS=0 \
-            -DENABLE_EXAMPLES=0 \
-            -DENABLE_TESTDATA=0 \
-            -DENABLE_TOOLS=0 \
