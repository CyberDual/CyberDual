index 0000000000000000000000000000000000000000..bff084d69e6967fa2b024550488309a6f84fa8f5
--- /dev/null
+++ b/tests/uncv_sequence_odd_chroma_size.cc
@@ -0,0 +1,361 @@
+/*
+  libheif integration tests for uncompressed sequence frames with odd luma size.
+
+  MIT License
