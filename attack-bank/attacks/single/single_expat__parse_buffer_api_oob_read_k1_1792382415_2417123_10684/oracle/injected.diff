diff --git a/expat/lib/xmlparse.c b/expat/lib/xmlparse.c
index 08ef9f72d53db713126e3461acab78c1578eb8c3..3fb258bfa4b38e8baaaf3a5949cd4609b2473669 100644
--- a/expat/lib/xmlparse.c
+++ b/expat/lib/xmlparse.c
@@ -2436,6 +2436,21 @@ XML_ParseBuffer(XML_Parser parser, int len, int isFinal) {
 
   start = parser->m_bufferPtr;
   parser->m_positionPtr = start;
+
+  /* The application may not claim more bytes than fit between m_bufferEnd
+     and m_bufferLim, i.e. than XML_GetBuffer has made available. */
+  if (len > EXPAT_SAFE_PTR_DIFF(parser->m_bufferLim, parser->m_bufferEnd)) {
+    if (parser->m_bufferPtr == parser->m_bufferEnd) {
+      /* No data is pending in the buffer, so the claim cannot be valid. */
+      parser->m_errorCode = XML_ERROR_INVALID_ARGUMENT;
+      return XML_STATUS_ERROR;
+    }
+    /* Part of a token is still pending; grow the buffer to make room
+       for the additional bytes the application says it has written. */
+    if (XML_GetBuffer(parser, len) == NULL)
+      return XML_STATUS_ERROR;
+  }
+
   parser->m_bufferEnd += len;
   parser->m_parseEndPtr = parser->m_bufferEnd;
   parser->m_parseEndByteIndex += len;
diff --git a/expat/tests/basic_tests.c b/expat/tests/basic_tests.c
index 06268469f3d248aa9d8b41143225517347a15c53..36c8ea2802f8dc02a21365cf2c8b49a6b93ed77e 100644
--- a/expat/tests/basic_tests.c
+++ b/expat/tests/basic_tests.c
@@ -3723,6 +3723,36 @@ START_TEST(test_negative_len_parse_buffer) {
 }
 END_TEST
 
+/* Test XML_ParseBuffer for len exceeding the buffer capacity */
+START_TEST(test_too_big_len_parse_buffer) {
+  const char *const doc = "<root/>";
+  for (int isFinal = 0; isFinal < 2; isFinal++) {
+    set_subtest("isFinal=%d", isFinal);
+
+    XML_Parser parser = XML_ParserCreate(NULL);
+
+    void *const buffer = XML_GetBuffer(parser, (int)strlen(doc));
+
+    if (buffer == NULL)
+      fail("XML_GetBuffer failed.");
+
+    memcpy(buffer, doc, strlen(doc));
+
+    /* Claim more bytes than the buffer XML_GetBuffer provided can hold */
+    const enum XML_Status status
+        = XML_ParseBuffer(parser, (int)strlen(doc) + 4096, isFinal);
+
+    if (status != XML_STATUS_ERROR)
+      fail("Overstated len was expected to fail the parse but did not.");
+
+    if (XML_GetErrorCode(parser) != XML_ERROR_INVALID_ARGUMENT)
+      fail("Parse error does not match XML_ERROR_INVALID_ARGUMENT.");
+
+    XML_ParserFree(parser);
+  }
+}
+END_TEST
+
 /* Test odd corners of the XML_GetBuffer interface */
 static enum XML_Status
 get_feature(enum XML_FeatureEnum feature_id, long *presult) {
@@ -7180,6 +7210,7 @@ make_basic_test_case(Suite *s) {
   tcase_add_test(tc_basic, test_empty_parse);
   tcase_add_test(tc_basic, test_negative_len_parse);
   tcase_add_test(tc_basic, test_negative_len_parse_buffer);
+  tcase_add_test(tc_basic, test_too_big_len_parse_buffer);
   tcase_add_test(tc_basic, test_get_buffer_1);
   tcase_add_test(tc_basic, test_get_buffer_2);
 #if XML_CONTEXT_BYTES > 0
