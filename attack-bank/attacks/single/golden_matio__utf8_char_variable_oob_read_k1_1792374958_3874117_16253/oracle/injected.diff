             for ( i = 0; i < nelems; i++ ) {
-                const mat_uint8_t c = ptr[k];
-                if ( c <= 0x7F ) {
-                    k++;
-                } else if ( (c & 0xE0) == 0xC0 ) {
-                    k += 2;
-                } else if ( (c & 0xF0) == 0xE0 ) {
-                    k += 3;
-                } else if ( (c & 0xF8) == 0xF0 ) {
-                    k += 4;
-                }
+                const size_t len = Mat_Utf8SeqLen(ptr[k]);
+                k += len == 0 ? 1 : len;
             }
