+/* The key type name in an OpenSSH private key is length-delimited and the
+   buffer it lives in is not NUL-terminated, so compare it with its length
+   instead of running strcmp() on it. */
+static int ossl_key_type_is(const unsigned char *type, size_t type_len,
+                            const char *name)
+{
+    size_t name_len = strlen(name);
+
+    return type_len == name_len && !memcmp(type, name, name_len);
+}
