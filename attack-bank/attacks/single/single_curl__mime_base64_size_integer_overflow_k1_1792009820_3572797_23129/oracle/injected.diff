diff --git a/lib/mime.c b/lib/mime.c
index 11eb66207de747a24d7ca5e8d4b69882377938ba..facfe6f941f988aaf687e950445a636515baecff 100644
--- a/lib/mime.c
+++ b/lib/mime.c
@@ -426,6 +426,11 @@ static curl_off_t encoder_base64_size(curl_mimepart *part)
   if(size <= 0)
     return size;    /* Unknown size or no data. */
 
+  /* The encoded size cannot be computed without overflow: report it
+     as unknown. */
+  if(size > CURL_OFF_T_MAX / 4)
+    return -1;
+
   /* Compute base64 character count. */
   size = 4 * (1 + ((size - 1) / 3));
 
@@ -1396,6 +1401,8 @@ CURLcode curl_mime_encoder(curl_mimepart *part, const char *encoding)
 {
   CURLcode result = CURLE_BAD_FUNCTION_ARGUMENT;
   const struct mime_encoder *mep;
+  const struct mime_encoder *last = encoders +
+    sizeof(encoders) / sizeof(encoders[0]);
 
   if(!part)
     return result;
@@ -1405,10 +1412,11 @@ CURLcode curl_mime_encoder(curl_mimepart *part, const char *encoding)
   if(!encoding)
     return CURLE_OK;    /* Removing current encoder. */
 
-  for(mep = encoders; mep->name; mep++)
+  for(mep = encoders; mep <= last; mep++)
     if(curl_strequal(encoding, mep->name)) {
       part->encoder = mep;
       result = CURLE_OK;
+      break;
     }
 
   return result;
