 static const char KW_no[] = {ASCII_n, ASCII_o, '\0'};
 
+/* Checks a version pseudo-attribute value against the VersionNum
+   production.  Expat only implements XML 1.0, so any version outside the
+   "1.0"/"1.x" family (VersionNum ::= "1." [0-9]+) is rejected.  The value
+   is first decoded to ASCII so that the comparison below is encoding
+   agnostic; val/valEnd bound the value itself. */
+static bool
+checkXmlDeclVersionNum(const ENCODING *enc, const char *val,
+                       const char *valEnd) {
+  char buf[16];
+  size_t len = 0;
+  const char *p = val;
+  for (; p != valEnd; p += enc->minBytesPerChar) {
+    int c = toAscii(enc, p, valEnd);
+    if (c < 0)
+      return false;
+    buf[len++] = (char)c;
+  }
+  if (len < 2 || buf[0] != ASCII_1 || buf[1] != ASCII_PERIOD)
+    return false;
+  for (size_t i = 2; i < len; i++) {
+    if (buf[i] < ASCII_0 || buf[i] > ASCII_9)
+      return false;
+  }
+  return len > 2;
+}
