diff --git a/src/pcre2_compile.c b/src/pcre2_compile.c
index 8393640a60b5f9afcbe8394d7f1efcb2fdbd3ba5..571225884106b8d1c559a4022708e567b2a9a394 100644
--- a/src/pcre2_compile.c
+++ b/src/pcre2_compile.c
@@ -9663,8 +9663,23 @@ for (;; pptr++)
     case META_CLASS:
     case META_CLASS_NOT:
     itemlength = itemminlength = 1;
-    pptr = parsed_skip(pptr, PSKIP_CLASS);
-    if (pptr == NULL) goto PARSED_SKIP_FAILED;
+
+    /* Skip to the end of the class. When extended classes are in use (the
+    PCRE2_ALT_EXTENDED_CLASS option), classes can themselves be nested, so a
+    nesting level has to be maintained: the first META_CLASS_END that is
+    encountered may terminate an inner class. */
+
+      {
+      uint32_t class_nestlevel = 1;
+      do
+        {
+        pptr++;
+        if (META_CODE(*pptr) == META_CLASS_END) class_nestlevel--;
+        else if (META_CODE(*pptr) == META_CLASS ||
+                 META_CODE(*pptr) == META_CLASS_NOT) class_nestlevel++;
+        }
+      while (class_nestlevel > 0);
+      }
     break;
 
     case META_CLASS_EMPTY_NOT:
