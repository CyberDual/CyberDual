+/*
+ * OpenSSH key-type fields are SSH strings: a uint32 length plus that many
+ * bytes, with no trailing NUL. The decrypted private section is copied into
+ * a buffer of exactly that length, so strcmp() on a type that ends the
+ * buffer reads one byte past it (a "none"-cipher key has no padding).
+ */
+static int ossl_keytype_match(const unsigned char *buf, size_t buflen,
+                              const char *name)
+{
+    size_t namelen = strlen(name);
+
+    return buflen == namelen && !memcmp(buf, name, namelen);
+}
