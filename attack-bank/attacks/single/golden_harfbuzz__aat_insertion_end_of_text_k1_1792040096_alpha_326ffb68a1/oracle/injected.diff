index 1a35363c7a3fd4dc37265a8d78a42a328c283c2f..04e4f42849b56304491105d62b45213ba2a2ef38 100644
--- a/src/hb-aat-layout-common.hh
+++ b/src/hb-aat-layout-common.hh
@@ -182,6 +182,36 @@ struct hb_aat_apply_context_t :
       buffer_glyph_set->add_array (glyphs, count);
     for (unsigned int i = 0; i < count; i++)
     {
+      /* End-of-text has no current input glyph. Copy the previous output
+       * glyph into a newly reserved slot and apply insertion metadata there. */
+      if (buffer->idx == buffer->len)
+      {
+	hb_glyph_info_t *base = buffer->out_len ? &buffer->prev () : nullptr;
+	if (unlikely (!buffer->make_room_for (0, 1))) return false;
+
+	hb_glyph_info_t &slot = buffer->out_info[buffer->out_len];
+	if (base)
+	  slot = *base;
+	else
+	  hb_memset (&slot, 0, sizeof (slot));
+	slot.codepoint = glyphs[i];
+	if (glyphs[i] == DELETED_GLYPH)
+	{
+	  buffer->scratch_flags |= HB_BUFFER_SCRATCH_FLAG_AAT_HAS_DELETED;
+	  _hb_glyph_info_set_aat_deleted (&slot);
+	}
+	else
+	{
+#ifndef HB_NO_OT_LAYOUT
+	  if (has_glyph_classes)
+	    _hb_glyph_info_set_glyph_props (&slot,
+					    gdef.get_glyph_props (glyphs[i]));
+#endif
+	}
+	buffer->out_len++;
+	continue;
+      }
+
       if (glyphs[i] == DELETED_GLYPH)
       {
         buffer->scratch_flags |= HB_BUFFER_SCRATCH_FLAG_AAT_HAS_DELETED;
