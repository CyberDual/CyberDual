-      fromLim -= 2;                                                            \
-      res = XML_CONVERT_INPUT_INCOMPLETE;                                      \
-    }                                                                          \
+    /* Avoid copying the first half only of a surrogate pair */                \
+    if (fromLim - *fromP > ((toLim - *toP) << 1)) {                           \
+      const unsigned char hi = GET_HI(fromLim - 2);                           \
+      /* is this the high surrogate half of a pair? (0xD800-0xDBFF) */        \
