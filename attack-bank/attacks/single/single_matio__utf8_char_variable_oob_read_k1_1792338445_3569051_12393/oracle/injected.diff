@@ -3453,6 +3453,50 @@ Mat_VarReadNumeric5(mat_t *mat, matvar_t *matvar, void *data, size_t N)
     return err;
 }
 
+static int
+FileHasBytes(FILE *fp, size_t nbytes)
+{
+    mat_off_t data_pos, end_pos;
+
+    data_pos = ftello(fp);
+    end_pos = data_pos;
+    if ( data_pos != -1L && fseeko(fp, 0, SEEK_END) == 0 )
+        end_pos = ftello(fp);
+    if ( fseeko(fp, data_pos, SEEK_SET) != 0 )
+        return 0;
+
+    return end_pos >= data_pos && (mat_uint64_t)(end_pos - data_pos) >= (mat_uint64_t)nbytes;
+}
+
+static int
+ValidateUtf8(const mat_uint8_t *data, size_t nbytes)
+{
+    size_t i, length;
+
+    for ( i = 0; i < nbytes; i += length ) {
+        const mat_uint8_t value = data[i];
+        size_t j;
+
+        if ( value <= 0x7F ) {
+            length = 1;
+        } else if ( (value & 0xE0) == 0xC0 ) {
+            length = 2;
+        } else if ( (value & 0xF0) == 0xE0 ) {
+            length = 3;
+        } else if ( (value & 0xF8) == 0xF0 ) {
+            length = 4;
+        } else {
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+        }
+        for ( j = 1; j < length; j++ ) {
+            if ( (data[i + j] & 0xC0) != 0x80 )
+                return MATIO_E_FILE_FORMAT_VIOLATION;
+        }
+    }
+
+    return MATIO_E_NO_ERROR;
+}
