@@ -1632,6 +1632,18 @@ int libssh2_channel_flush_ex(LIBSSH2_CHANNEL *channel, int streamid)
     return rc;
 }
 
+/*
+ * Tell whether the peer delivered an exit status for the channel. Returns
+ * zero if the channel is NULL or no exit status has arrived yet.
+ */
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+{
+    if(!channel)
+        return 0;
+
+    return channel->exit_status_set ? 1 : 0;
+}
