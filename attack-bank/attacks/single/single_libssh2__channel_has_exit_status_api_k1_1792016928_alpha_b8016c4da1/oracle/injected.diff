@@ -0,0 +1,37 @@
+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+  - libssh2_channel_get_exit_status(3)
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - tell whether the peer reported an exit
+status
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+~~~
+
+# DESCRIPTION
+
+*channel* - Channel stream to check.
+
+Reports whether the remote host has delivered an exit status for the named
+channel. An exit status of zero is a valid value, so
+libssh2_channel_get_exit_status(3) alone cannot distinguish a process that
+exited with status zero from one whose exit status has not been received
+yet.
+
+# RETURN VALUE
+
+Returns 1 if an exit status has been received for the channel, 0 if it has
+not (or if *channel* is NULL).
