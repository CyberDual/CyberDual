+TEST(ATimeValue, canBeReadFromExtendedStringWithTimeZoneDesignatorNegativeZeroHour) {
+  TimeValue value;
+  std::string hms("23:55:02-00:30");
+  ASSERT_EQ(0, value.read(hms));
+  ASSERT_EQ(23, value.getTime().hour);
+  ASSERT_EQ(55, value.getTime().minute);
+  ASSERT_EQ(2, value.getTime().second);
+  ASSERT_EQ(0, value.getTime().tzHour);
+  ASSERT_EQ(-30, value.getTime().tzMinute);
+
+  value = TimeValue();
+  hms = "23:44:03-00:45";
+  ASSERT_EQ(0, value.read(hms));
+  ASSERT_EQ(23, value.getTime().hour);
+  ASSERT_EQ(44, value.getTime().minute);
+  ASSERT_EQ(3, value.getTime().second);
+  ASSERT_EQ(0, value.getTime().tzHour);
+  ASSERT_EQ(-45, value.getTime().tzMinute);
+}
+
