+	if (unlikely (!has_current))
+	{
+	  /* There's no current glyph to pivot the insertion around, which
+	   * happens when this action fires on the end-of-text transition.
+	   * The copy/skip dance below needs a current glyph to work with,
+	   * so just emit the intended run of inserted glyphs directly. */
+	  HBGlyphID16 run[16];
+	  for (unsigned int i = 0; i < count; i++)
+	    run[i] = glyphs[i];
+	  if (unlikely (!c->output_glyphs (count, run))) return;
+	  ret = true;
+	}
+	else
+	{
+	  if (!before)
+	    if (unlikely (!buffer->copy_glyph ())) return;
+	  /* TODO We ignore KashidaLike setting. */
+	  if (unlikely (!c->output_glyphs (count, glyphs))) return;
+	  ret = true;
+	  if (!before)
+	    buffer->skip_glyph ();
+	}
 
