diff --git a/libarchive/archive_read.c b/libarchive/archive_read.c
index 8f913c8e1a3ac418155311af97ae8397d75ba011..21078cc4b5b7ee386e8c83b91e1883a48df8d22f 100644
--- a/libarchive/archive_read.c
+++ b/libarchive/archive_read.c
@@ -527,8 +527,25 @@ archive_read_open1(struct archive *_a)
 
 	a->archive.state = ARCHIVE_STATE_HEADER;
 
-	/* Ensure libarchive starts from the first node in a multivolume set */
-	client_switch_proxy(a->filter, 0);
+	/*
+	 * Ensure libarchive starts from the first node in a multivolume
+	 * set.  Format bidding may have switched to a later volume, and
+	 * switching back releases the client buffer of that volume.  Any
+	 * data the bottom filter still holds from it must be discarded;
+	 * the reader fetches it again from the freshly opened volume.
+	 */
+	if (a->client.cursor != 0) {
+		client_switch_proxy(a->filter, 0);
+		f = a->filter;
+		while (f->upstream != NULL)
+			f = f->upstream;
+		f->avail = 0;
+		f->next = f->buffer;
+		f->client_avail = 0;
+		f->client_total = 0;
+		f->client_next = f->client_buff = NULL;
+		f->end_of_file = 0;
+	}
 	return (e);
 }
 
