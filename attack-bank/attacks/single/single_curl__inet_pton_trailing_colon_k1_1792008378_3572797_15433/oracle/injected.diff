diff --git a/lib/curlx/inet_pton.c b/lib/curlx/inet_pton.c
index 3b611890f9c7b4f98bcbb5e390170604464c1208..0fc1ac400e30bdd6ad47853eda7125936d5898a8 100644
--- a/lib/curlx/inet_pton.c
+++ b/lib/curlx/inet_pton.c
@@ -142,6 +142,9 @@ static int inet_pton6(const char *src, unsigned char *dst)
         colonp = tp;
         continue;
       }
+      else if(*src == '\0')
+        /* a single colon cannot terminate a group */
+        return 0;
       if(tp + INT16SZ > endp)
         return 0;
       *tp++ = (unsigned char)((val >> 8) & 0xff);
@@ -159,7 +162,7 @@ static int inet_pton6(const char *src, unsigned char *dst)
     return 0;
   }
   if(saw_xdigit) {
-    if(tp + INT16SZ > endp)
+    if(tp + INT16SZ > endp && !colonp)
       return 0;
     *tp++ = (unsigned char)((val >> 8) & 0xff);
     *tp++ = (unsigned char)(val & 0xff);
