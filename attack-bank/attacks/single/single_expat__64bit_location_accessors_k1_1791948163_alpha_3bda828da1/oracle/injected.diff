index bf94e9db56165189abcd7df837f55d610538d872..fcc236b301343aa63a53728bc079a1f0cf8ace93 100644
--- a/expat/Changes
+++ b/expat/Changes
@@ -21,6 +21,15 @@
 !!                                   Sebastian Pipping -- Berlin, 2026-09-22 !!
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 
+Unreleased
+        New functions:
+           #1323  Add 64-bit location accessors for inputs larger than 2GiB:
+                    XML_GetCurrentByteIndex64, XML_GetCurrentByteCount64,
+                    XML_GetCurrentLineNumber64, XML_GetCurrentColumnNumber64
+                    and XML_GetInputContext64. They mirror the existing
+                    accessors but do not wrap. The original functions remain
+                    for ABI compatibility and still truncate.
+
 Release 2.8.5 Tue September 22 2026
         Security fixes:
            #1282  CVE-2026-93990 -- Reject high surrogates not followed by a
diff --git a/expat/lib/expat.h b/expat/lib/expat.h
index 4c3851d50a5fdf3c86854d5805d54ab429a124a1..fe6d7f8f7f80cff2ee2eb090c40c36564d50446d 100644
--- a/expat/lib/expat.h
+++ b/expat/lib/expat.h
@@ -963,17 +963,46 @@ XML_GetErrorCode(XML_Parser parser);
    Note: XML_GetCurrentLineNumber and XML_GetCurrentColumnNumber
    return 0 to indicate an error.
    Note: XML_GetCurrentByteIndex returns -1 to indicate an error.
+
+   XML_GetCurrentLineNumber, XML_GetCurrentColumnNumber and
+   XML_GetCurrentByteIndex truncate to XML_Size / XML_Index. On platforms
+   where those types are 32 bits wide (and whenever XML_LARGE_SIZE is not
+   defined), positions past 2GiB (byte index) or 4GiB (line and column)
+   wrap. Use the *64 variants, which do not wrap, for large inputs.
 */
 XMLPARSEAPI(XML_Size) XML_GetCurrentLineNumber(XML_Parser parser);
 XMLPARSEAPI(XML_Size) XML_GetCurrentColumnNumber(XML_Parser parser);
 XMLPARSEAPI(XML_Index) XML_GetCurrentByteIndex(XML_Parser parser);
 
+/* Same information as XML_GetCurrentLineNumber, XML_GetCurrentColumnNumber
+   and XML_GetCurrentByteIndex, but as a full 64-bit count so values are
+   not truncated for inputs larger than 2GiB / 4GiB.
+   XML_GetCurrentLineNumber64 and XML_GetCurrentColumnNumber64 return 0
+   to indicate an error. XML_GetCurrentByteIndex64 returns -1 to indicate
+   an error.
+   Added in Expat 2.9.0.
+*/
+XMLPARSEAPI(uint64_t)
+XML_GetCurrentLineNumber64(XML_Parser parser);
+XMLPARSEAPI(uint64_t)
+XML_GetCurrentColumnNumber64(XML_Parser parser);
+XMLPARSEAPI(int64_t)
+XML_GetCurrentByteIndex64(XML_Parser parser);
+
 /* Return the number of bytes in the current event.
    Returns 0 if the event is in an internal entity.
 */
 XMLPARSEAPI(int)
 XML_GetCurrentByteCount(XML_Parser parser);
 
+/* Same information as XML_GetCurrentByteCount, but as a 64-bit count so
+   the length of a single event is not truncated to int.
+   Returns 0 if the event is in an internal entity, or if parser is NULL.
+   Added in Expat 2.9.0.
+*/
+XMLPARSEAPI(uint64_t)
+XML_GetCurrentByteCount64(XML_Parser parser);
+
 /* If XML_CONTEXT_BYTES is >=1, returns the input buffer, sets
    the integer pointed to by offset to the offset within this buffer
    of the current parse position, and sets the integer pointed to by size
@@ -987,6 +1016,14 @@ XML_GetCurrentByteCount(XML_Parser parser);
 XMLPARSEAPI(const char *)
 XML_GetInputContext(XML_Parser parser, int *offset, int *size);
 
+/* Same information as XML_GetInputContext. offset and size are 64-bit so
+   they are not truncated when the retained buffer is larger than 2GiB.
+   offset may be NULL. size may be NULL.
+   Added in Expat 2.9.0.
+*/
+XMLPARSEAPI(const char *)
+XML_GetInputContext64(XML_Parser parser, int64_t *offset, uint64_t *size);
+
 /* For backwards compatibility with previous versions. */
 #  define XML_GetErrorLineNumber XML_GetCurrentLineNumber
 #  define XML_GetErrorColumnNumber XML_GetCurrentColumnNumber
