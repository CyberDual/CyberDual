diff --git a/lib/urlapi.c b/lib/urlapi.c
index 1c4db04e46388df390e037b5147724b62e40d809..cb8731d94a79a946e0a7d8db5e86027bf6e0fe9d 100644
--- a/lib/urlapi.c
+++ b/lib/urlapi.c
@@ -2056,10 +2056,29 @@ static CURLUcode url_sethost(CURLU *u, struct dynbuf *encp,
     CURLcode result = Curl_urldecode(newp, n, &decoded, &dlen, REJECT_CTRL);
     if(result || hostname_check6(u, decoded, dlen))
       bad = TRUE;
+    else {
+      struct dynbuf dbuf;
+      curlx_dyn_init(&dbuf, CURL_MAX_INPUT_LENGTH);
+      if(curlx_dyn_addn(&dbuf, decoded, dlen))
+        bad = TRUE;
+      else if(ipv4_normalize(&dbuf) == HOST_IPV4) {
+        /* store the normalized address, unless the host already was in
+           canonical form */
+        if((curlx_dyn_len(&dbuf) != dlen) ||
+           memcmp(decoded, curlx_dyn_ptr(&dbuf), n)) {
+          curlx_dyn_reset(encp);
+          if(curlx_dyn_addn(encp, curlx_dyn_ptr(&dbuf), curlx_dyn_len(&dbuf)))
+            bad = TRUE;
+        }
+      }
+      curlx_dyn_free(&dbuf);
+    }
     curlx_free(decoded);
   }
   else if(hostname_check6(u, newp, n))
     bad = TRUE;
+  else if(ipv4_normalize(encp) == HOST_ERROR)
+    bad = TRUE;
   if(bad) {
     curlx_dyn_free(encp);
     return CURLUE_BAD_HOSTNAME;
@@ -2143,7 +2162,9 @@ CURLUcode curl_url_set(CURLU *u, CURLUPart what,
     const char *newp = NULL;
     struct dynbuf enc;
     CURLUcode status;
-    curlx_dyn_init(&enc, (nalloc * 3) + 1 + leadingslash);
+    curlx_dyn_init(&enc, (what == CURLUPART_HOST) ?
+                   CURLMAX((nalloc * 3) + 1 + leadingslash, 16) :
+                   (nalloc * 3) + 1 + leadingslash);
 
     if(leadingslash && (part[0] != '/')) {
       CURLcode result = curlx_dyn_addn(&enc, "/", 1);
