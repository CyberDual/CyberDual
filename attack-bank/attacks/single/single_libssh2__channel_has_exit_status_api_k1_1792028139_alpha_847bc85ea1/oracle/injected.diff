diff --git a/docs/libssh2_channel_has_exit_status.md b/docs/libssh2_channel_has_exit_status.md
new file mode 100644
index 0000000000000000000000000000000000000000..12a53c883a8a71c9235852b353e531bb652d1849
--- /dev/null
+++ b/docs/libssh2_channel_has_exit_status.md
@@ -0,0 +1,43 @@
+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+  - libssh2_channel_get_exit_status(3)
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - tell whether an exit status was received
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+~~~
+
+# DESCRIPTION
+
+*channel* - Channel stream to check.
+
+Reports whether the remote host has delivered an exit status for the
+channel. libssh2_channel_get_exit_status(3) returns zero both when the
+remote process exited with a status of zero and when no exit status has
+been received yet, so this function is the way to tell the two cases
+apart.
+
+An exit status is normally delivered once the program running on the
+remote host has finished, before the channel is closed.
+
+# RETURN VALUE
+
+Returns 1 if an exit status has been received for the channel, 0 if none
+has been received, and 0 if channel is NULL.
+
+# AVAILABILITY
+
+Added in 1.11.2
