diff --git a/src/channel.c b/src/channel.c
index e3ab8bfebd1774d07f1207fd2e731f4a66eb2b66..5fb203975a36e37eeb8105a087e15d7adc6e3b03 100644
--- a/src/channel.c
+++ b/src/channel.c
@@ -1646,6 +1646,21 @@ int libssh2_channel_get_exit_status(LIBSSH2_CHANNEL *channel)
     return channel->exit_status;
 }
 
+/*
+ * Tell whether the remote side has delivered an exit status for the
+ * channel. Note that libssh2_channel_get_exit_status() returns zero both
+ * when the peer reported an exit status of zero and when no exit status
+ * was delivered at all, so this is the only way to tell the cases apart.
+ * We return zero also if channel is NULL.
+ */
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+{
+    if(!channel)
+        return 0;
+
+    return channel->exit_status_set ? 1 : 0;
+}
+
