-/*                                                                         */
-/*  ftmac.c                                                                */
-/*                                                                         */
-/*    Mac FOND support.  Written by just@letterror.com.                    */
-/*  Heavily Fixed by mpsuzuki, George Williams and Sean McBride            */
-/*                                                                         */
-/*  Copyright (C) 1996-2026 by                                             */
-/*  Just van Rossum, David Turner, Robert Wilhelm, and Werner Lemberg.     */
