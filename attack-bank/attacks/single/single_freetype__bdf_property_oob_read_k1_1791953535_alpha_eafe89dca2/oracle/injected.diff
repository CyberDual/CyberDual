-ftoption_set()
-{
-  regexp="-e \\\"s|.*#.*def.*$1 .*|#define $1|\\\" \
-          -e \\\"s|.*#.*def.*$1\$|#define $1|\\\""
-  FTOPTION_H_SED="$FTOPTION_H_SED $regexp"
-}
-
-ftoption_unset()
-{
-  regexp="-e \\\"s|.*#.*def.*$1 .*|/* #undef $1 */|\\\" \
-          -e \\\"s|.*#.*def.*$1\$|/* #undef $1 */|\\\""
-  FTOPTION_H_SED="$FTOPTION_H_SED $regexp"
-}
