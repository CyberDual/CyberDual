--- a/lib/mime.c
+++ b/lib/mime.c
@@ -365,7 +365,7 @@ static size_t encoder_base64_read(char *buffer, size_t size, bool ateof,
     }
 
     /* Be sure there is enough space and input data for a base64 group. */
-    if(size < 4) {
