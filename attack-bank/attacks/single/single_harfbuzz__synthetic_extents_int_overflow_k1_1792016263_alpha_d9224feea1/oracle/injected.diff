   hb_test_add (test_fontfuncs_empty);
   hb_test_add (test_fontfuncs_nil);
+  hb_test_add (test_fontfuncs_synthetic_extremes);
   hb_test_add (test_fontfuncs_subclassing);
   hb_test_add (test_fontfuncs_parallels);
 
