diff --git a/test/api/test-font.c b/test/api/test-font.c
index 2a04939fba04a532ab6482c89b2b3a9f79ec4047..7cd10bdab36fb1460397b5288f833c5fb518aab1 100644
--- a/test/api/test-font.c
+++ b/test/api/test-font.c
@@ -280,6 +280,48 @@ test_fontfuncs_nil (void)
   hb_font_funcs_destroy (ffuncs);
 }
 
+static hb_bool_t
+extremes_extents_func (hb_font_t *font HB_UNUSED, void *font_data HB_UNUSED,
+		       hb_codepoint_t glyph HB_UNUSED,
+		       hb_glyph_extents_t *extents,
+		       void *user_data HB_UNUSED)
+{
+  extents->x_bearing = 2000000000;
+  extents->y_bearing = -2000000000;
+  extents->width = 2000000000;
+  extents->height = 2000000000;
+  return TRUE;
+}
+
+static void
+test_fontfuncs_synthetic_extremes (void)
+{
+  hb_font_funcs_t *ffuncs;
+  hb_font_t *font;
+  hb_glyph_extents_t extents;
+
+  ffuncs = hb_font_funcs_create ();
+  hb_font_funcs_set_glyph_extents_func (ffuncs, extremes_extents_func, NULL, NULL);
+
+  font = hb_font_create (hb_face_get_empty ());
+  hb_font_set_funcs (font, ffuncs, NULL, NULL);
+  hb_font_set_scale (font, 1000, 1000);
+
+  hb_font_set_synthetic_slant (font, 0.2f);
+  hb_font_set_synthetic_bold (font, 0.05f, 0.05f, FALSE);
+
+  g_assert_true (hb_font_get_glyph_extents (font, 1, &extents));
+
+  /* Extreme extents saturate instead of overflowing. */
+  g_assert_cmpint (extents.x_bearing, ==, 1600000000);
+  g_assert_cmpint (extents.y_bearing, ==, -1999999950);
+  g_assert_cmpint (extents.width, ==, 547483697);
+  g_assert_cmpint (extents.height, ==, 1999999950);
+
+  hb_font_destroy (font);
+  hb_font_funcs_destroy (ffuncs);
+}
+
 static hb_bool_t
 contour_point_func1 (hb_font_t *font HB_UNUSED, void *font_data HB_UNUSED,
 		     hb_codepoint_t glyph, unsigned int point_index HB_UNUSED,
