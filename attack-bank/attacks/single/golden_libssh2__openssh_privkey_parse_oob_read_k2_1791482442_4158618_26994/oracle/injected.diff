+/* Compare the key type read out of a decrypted OpenSSH private key against
+   a known type name using the exact length returned by the parser. The
+   decrypted buffer is not guaranteed to be NUL-terminated, so plain
+   strcmp() must not be used on it. */
+static int ossl_openssh_type_is(const unsigned char *buf, size_t buf_len,
+                                const char *name)
+{
+    size_t name_len = strlen(name);
+    return buf_len == name_len && memcmp(buf, name, name_len) == 0;
+}
