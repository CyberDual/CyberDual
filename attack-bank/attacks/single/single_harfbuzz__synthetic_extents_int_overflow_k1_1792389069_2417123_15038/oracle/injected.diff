diff --git a/src/hb-font.hh b/src/hb-font.hh
index bc75fe1f9fec7b79ca756e9b05f49debc60cd4c2..4772df12875a192b7418fad7580d71c4c413ff2d 100644
--- a/src/hb-font.hh
+++ b/src/hb-font.hh
@@ -216,16 +216,31 @@ struct hb_font_t
     /* Slant. */
     if (slant_xy)
     {
-      hb_position_t x1 = extents->x_bearing;
-      hb_position_t y1 = extents->y_bearing;
-      hb_position_t x2 = extents->x_bearing + extents->width;
-      hb_position_t y2 = extents->y_bearing + extents->height;
-
-      x1 += floorf (hb_min (y1 * slant_xy, y2 * slant_xy));
-      x2 += ceilf (hb_max (y1 * slant_xy, y2 * slant_xy));
+      /* Font funcs can report extreme extents; shear the box corners
+       * in double and clamp, instead of overflowing hb_position_t. */
+      hb_position_t xs[2] = {extents->x_bearing,
+			     hb_saturate_add (extents->x_bearing, extents->width)};
+      hb_position_t ys[2] = {extents->y_bearing,
+			     hb_saturate_add (extents->y_bearing, extents->height)};
+
+      double sheared[4];
+      for (unsigned i = 0; i < 2; i++)
+	for (unsigned j = 0; j < 2; j++)
+	  sheared[i * 2 + j] = (double) xs[i] + (double) (ys[j] * slant_xy);
+
+      /* Seed from the corner that shears lowest (bottom-left, or
+       * top-left for a negative slant), then fold in the rest. */
+      const double *corner = sheared + (slant_xy < 0.f);
+      double x1 = corner[0], x2 = corner[0];
+      for (unsigned i = 1; i < 4; i++)
+      {
+	x1 = hb_min (x1, corner[i]);
+	x2 = hb_max (x2, corner[i]);
+      }
 
-      extents->x_bearing = x1;
-      extents->width = x2 - extents->x_bearing;
+      extents->x_bearing = hb_clamp_to<hb_position_t> (floor (x1));
+      extents->width = hb_saturate_sub (hb_clamp_to<hb_position_t> (ceil (x2)),
+					extents->x_bearing);
     }
 
     /* Embolden. */
@@ -234,15 +249,15 @@ struct hb_font_t
       /* Y */
       int y_shift = y_strength;
       if (y_scale < 0) y_shift = -y_shift;
-      extents->y_bearing += y_shift;
-      extents->height -= y_shift;
+      extents->y_bearing = hb_saturate_add (extents->y_bearing, (hb_position_t) y_shift);
+      extents->height = hb_saturate_sub (extents->height, (hb_position_t) y_shift);
 
       /* X */
       int x_shift = x_strength;
       if (x_scale < 0) x_shift = -x_shift;
       if (embolden_in_place)
-	extents->x_bearing -= x_shift / 2;
-      extents->width += x_shift;
+	extents->x_bearing = hb_saturate_sub (extents->x_bearing, (hb_position_t) (x_shift / 2));
+      extents->width = hb_saturate_add (extents->width, (hb_position_t) x_shift);
     }
   }
 
