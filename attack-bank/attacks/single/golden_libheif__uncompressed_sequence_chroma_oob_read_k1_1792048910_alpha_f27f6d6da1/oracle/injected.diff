index 0000000000000000000000000000000000000000..97380b6b39c1e2895d1506db44f841901cded68f
--- /dev/null
+++ b/tests/uncompressed_sequence_odd_chroma.cc
@@ -0,0 +1,304 @@
+/*
+  libheif integration test for GHSA-4h82-g446-83fm.
