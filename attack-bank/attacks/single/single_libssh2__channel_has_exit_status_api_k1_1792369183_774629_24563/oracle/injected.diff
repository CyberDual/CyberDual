+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+ - libssh2_channel_get_exit_status(3)
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - check if the remote exit code was received
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+~~~
+
+# DESCRIPTION
+
+*channel* - Channel stream to check for a received exit status.
+
+Returns whether the process running on the remote host at the other end of
+the named channel has reported its exit status. Since a remote exit code of
+zero is indistinguishable from "no status received" when using
+*libssh2_channel_get_exit_status(3)*, this function lets callers tell the
+two cases apart.
+
+# RETURN VALUE
+
+Returns 1 if the peer has delivered an exit-status message for the channel,
+otherwise 0. A NULL channel returns 0.
