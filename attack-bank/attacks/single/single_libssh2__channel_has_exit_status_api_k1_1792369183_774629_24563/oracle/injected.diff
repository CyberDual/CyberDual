+++ b/src/channel.c
@@ -1632,6 +1632,21 @@ int libssh2_channel_flush_ex(LIBSSH2_CHANNEL *channel, int streamid)
     return rc;
 }
 
+/*
+ * Return 1 if the peer has delivered an exit-status message for this
+ * channel, 0 if no exit status has been received (yet).  Since a remote
+ * exit code of zero is indistinguishable from "no status received" via
+ * libssh2_channel_get_exit_status(), this function lets callers tell the
+ * two cases apart.  A NULL channel returns 0.
+ */
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+{
+    if(!channel)
+        return 0;
+
+    return channel->exit_status_received;
+}
