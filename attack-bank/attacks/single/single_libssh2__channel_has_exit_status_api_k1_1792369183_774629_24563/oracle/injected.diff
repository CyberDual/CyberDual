new file mode 100644
index 0000000000000000000000000000000000000000..a9e77c4ac58dd1ee63bf9d8219e62adabe09298f
--- /dev/null
+++ b/tests/test_exit_status.c
@@ -0,0 +1,118 @@
+/* Copyright (C) The libssh2 project and its contributors.
+ *
+ * libssh2 test checking channel exit-status reporting
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "runner.h"
+#include "openssh_fixture.h"
+
+#include <stdlib.h>  /* for getenv() */
+
+/* set in Dockerfile */
+static const char *username = "libssh2";
+static const char *key_file_private = "keys/id_rsa_pem";
+static const char *key_file_public = "keys/id_rsa_pem.pub";
+
+int test(LIBSSH2_SESSION *session)
+{
+    int rc;
+    LIBSSH2_CHANNEL *channel = NULL;
+    const char *userauth_list;
+
+    /* Ignore our hard-wired Dockerfile user when not running under Docker */
+    if(!openssh_fixture_have_docker()) {
+        username = getenv("USER");
+#ifdef _WIN32
+        if(!username)
+            username = getenv("USERNAME");
+#endif
+    }
+
+    if(!username) {
+        fprintf(stderr, "username not set\n");
+        return 1;
+    }
+
+    userauth_list = libssh2_userauth_list(session, username,
+                                          (unsigned int)strlen(username));
+    if(!userauth_list) {
+        print_last_session_error("libssh2_userauth_list");
+        return 1;
+    }
+
+    if(!strstr(userauth_list, "publickey")) {
+        fprintf(stderr, "'publickey' was expected in userauth list: %s\n",
+                userauth_list);
+        return 1;
+    }
+
+    rc = libssh2_userauth_publickey_fromfile_ex(session, username,
+                                                (unsigned int)strlen(username),
+                                                srcdir_path(key_file_public),
+                                                srcdir_path(key_file_private),
+                                                NULL);
+    if(rc) {
+        print_last_session_error("libssh2_userauth_publickey_fromfile_ex");
+        return 1;
+    }
+
+    /* Request a session channel on which to run a command */
+    channel = libssh2_channel_open_session(session);
+    if(!channel) {
+        fprintf(stderr, "Unable to open a session\n");
+        return 1;
+    }
+
+    /* no command has run yet, so no exit status can have arrived */
+    if(libssh2_channel_has_exit_status(channel)) {
+        fprintf(stderr, "Unexpected exit status before command was run\n");
+        goto shutdown;
+    }
+
+    /* Run a command that exits with a specific status */
+    if(libssh2_channel_exec(channel, "exit 42")) {
+        fprintf(stderr, "Unable to request command on channel\n");
+        goto shutdown;
+    }
+
+    /* Drain the channel until the remote end is done */
+    while(!libssh2_channel_eof(channel)) {
+        char buf[1024];
+        ssize_t err = libssh2_channel_read(channel, buf, sizeof(buf));
+        if(err < 0)
+            fprintf(stderr, "Unable to read response: %ld\n", (long)err);
+    }
+
+    if(libssh2_channel_close(channel)) {
+        fprintf(stderr, "Unable to close channel\n");
+        goto shutdown;
+    }
+
+    /* The peer must have delivered the exit status by now */
+    if(!libssh2_channel_has_exit_status(channel)) {
+        fprintf(stderr, "No exit status received for finished command\n");
+        goto shutdown;
+    }
+
+    if(libssh2_channel_get_exit_status(channel) != 42) {
+        fprintf(stderr, "Unexpected exit status %d, expected 42\n",
+                libssh2_channel_get_exit_status(channel));
+        goto shutdown;
+    }
+
+    libssh2_channel_free(channel);
+    return 0;
+
+shutdown:
+
+    if(channel) {
+        if(libssh2_channel_close(channel))
+            fprintf(stderr, "Unable to close channel\n");
+
+        libssh2_channel_free(channel);
+    }
+
+    return 1;  /* error */
+}
