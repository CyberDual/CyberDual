--- a/expat/lib/xmlparse.c
+++ b/expat/lib/xmlparse.c
@@ -7819,6 +7819,11 @@ dtdCopy(XML_Parser oldParser, DTD *newDtd, const DTD *oldDtd,
     if (oldE->prefix)
       newE->prefix = (PREFIX *)lookup(oldParser, &(newDtd->prefixes),
                                       oldE->prefix->name, 0);
+    /* Collect the prefixed default attribute ids so that their prefix
+       links can be validated once the element type is fully copied. */
+    const ATTRIBUTE_ID *prefixedIds[8];
+    size_t nPrefixedIds = 0;
+
     for (size_t i = 0; i < newE->nDefaultAtts; i++) {
       const XML_Char *const attributeName = oldE->defaultAtts[i].id->name;
       newE->defaultAtts[i].id = (ATTRIBUTE_ID *)lookup(
@@ -7832,11 +7837,30 @@ dtdCopy(XML_Parser oldParser, DTD *newDtd, const DTD *oldDtd,
       } else
         newE->defaultAtts[i].value = NULL;
 
-      NAMED *const nameAddedOrFound = lookup(parser, &(newE->defaultAttForName),
