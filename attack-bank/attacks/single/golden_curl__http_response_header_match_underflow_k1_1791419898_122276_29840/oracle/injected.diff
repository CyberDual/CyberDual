-      do
-        curlx_str_passblanks(&p);
-      while(!curlx_str_single(&p, ','));
-      len -= (p - o);
+      len -= (size_t)(comma - p) + 1;
+      p = comma + 1;
+
+      /* move over any blanks that separate the tokens */
+      while(ISBLANK(*p)) {
+        p++;
+        len--;
+      }
     }
   }
   return FALSE; /* no match */
