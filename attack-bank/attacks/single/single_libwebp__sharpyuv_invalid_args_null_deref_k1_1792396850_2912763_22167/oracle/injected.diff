+// Maximum absolute value of a matrix gain coefficient, in 16 bit fixed
+// point. The gains of a RGB->YUV matrix are at most 1.0, but matrices built
+// for higher sample bit depths scale them by the sample range. Cap them at
+// 8.0 so that scaling them by yuv_max below cannot overflow 32 bits; larger
+// matrices are downscaled first.
+static const int kMaxMatrixGain = 8 << 16;
+
+// Returns 1 if a gain coefficient of 'matrix' exceeds kMaxMatrixGain. The
+// offset column is not checked as it is never multiplied.
+static int MatrixNeedsDownscaling(const SharpYuvConversionMatrix* matrix) {
+  const int* const coeffs = matrix->rgb_to_y;
+  int i;
+  for (i = 0; i < 12; ++i) {
+    if ((i & 3) == 3) continue;  // skip the offset column
+    if (coeffs[i] > kMaxMatrixGain || coeffs[i] < -kMaxMatrixGain) return 1;
+  }
+  return 0;
+}
+
+// Scales every coefficient of 'matrix' down by the same power of two so that
+// the largest coefficient fits in kMaxMatrixGain, preserving the component
+// ratios.
+static void DownscaleConversionMatrix(const SharpYuvConversionMatrix* matrix,
+                                      SharpYuvConversionMatrix* dst) {
+  const int* const src = matrix->rgb_to_y;
+  int* const out = dst->rgb_to_y;
+  int64_t max_gain = 0;
+  int shift = 0;
+  int i;
+  for (i = 0; i < 12; ++i) {
+    const int64_t coeff = (src[i] < 0) ? -(int64_t)src[i] : src[i];
+    if (coeff > max_gain) max_gain = coeff;
+  }
+  while ((max_gain >> shift) > kMaxMatrixGain) ++shift;
+  for (i = 0; i <= 12; ++i) {
+    out[i] = (src[i] + (1 << (shift - 1))) >> shift;
+  }
+}
