diff --git a/lib/http.c b/lib/http.c
index 9af3a705147022afebba333c17f4ad8a9053bc09..03f4342aa47196bd09dafe649d9cd477c5510b49 100644
--- a/lib/http.c
+++ b/lib/http.c
@@ -1421,9 +1421,14 @@ bool Curl_compareheader(const char *headerline, /* line to check */
 
   /* find the content string in the rest of the line */
   if(curlx_strlen(&val) >= clen) {
-    size_t len;
-    p = curlx_str(&val);
-    for(len = curlx_strlen(&val); len >= clen;) {
+    char buf[64];
+    size_t len = curlx_strlen(&val);
