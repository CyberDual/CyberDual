+TEST(BmpImage, readMetadataReadsImageDimensionsFromOS2CoreHeader) {
+  const std::array<unsigned char, 26> header{
+      'B',  'M',               // Signature                                                         off:0   size:2
+      0x1A, 0x00, 0x00, 0x00,  // Size of the BMP file in bytes                                     off:2,  size:4
+      0x00, 0x00,              // Reserved                                                          off:6,  size:2
+      0x00, 0x00,              // Reserved                                                          off:8,  size:2
+      0x00, 0x00, 0x00, 0x00,  // Offset of the byte where the bitmap image data can be found       off:10, size:4
+      0x0C, 0x00, 0x00, 0x00,  // Size of this header (12 = OS/2 BITMAPCOREHEADER)                  off:14, size:4
+      0x50, 0x00,              // The bitmap width in pixels (unsigned 16 bit)                      off:18, size:2
+      0x30, 0x00,              // The bitmap height in pixels (unsigned 16 bit)                     off:20, size:2
+      0x01, 0x00,              // Number of color planes                                            off:22, size:2
+      0x18, 0x00,              // Bits per pixel                                                    off:24, size:2
+  };
+
+  auto memIo = std::make_unique<MemIo>(header.data(), header.size());
+  BmpImage bmp(std::move(memIo), defaultImageCtorParams(false));
+  ASSERT_NO_THROW(bmp.readMetadata());
+  ASSERT_EQ(80u, bmp.pixelWidth());
+  ASSERT_EQ(48u, bmp.pixelHeight());
+}
