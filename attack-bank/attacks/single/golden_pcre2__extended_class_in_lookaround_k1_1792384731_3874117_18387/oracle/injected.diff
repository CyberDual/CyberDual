@@ -9484,6 +9479,60 @@ PCRE2_UNREACHABLE(); /* Control never reaches here */
 
 
 
+/*************************************************
+*           Skip to the end of a class           *
+*************************************************/
+
+/* This function is called to skip over a class in the parsed pattern when
+finding the length of a lookbehind branch. Extended classes can be nested;
+each META_CLASS or META_CLASS_NOT that is encountered while skipping must be
+matched by its own META_CLASS_END, so we must count nesting levels and stop
+only at the one that closes the class we started from.
+
+The parsed pattern is well formed by the time this function is called, so the
+terminating META_CLASS_END is guaranteed to be present; there is no need to
+check for the end of the pattern.
+
+Arguments:
+  pptr       points to the META_CLASS or META_CLASS_NOT item
+
+Returns:     updated pptr, pointing to the terminating META_CLASS_END
+*/
+
+static uint32_t *
+parsed_skip_class(uint32_t *pptr)
+{
+uint32_t nestlevel = 1;
+
+while (nestlevel > 0)
+  {
+  uint32_t meta = META_CODE(*++pptr);
+
+  if (meta == META_BIGVALUE) pptr++;   /* Skip literal that follows */
+
+  else switch (meta)
+    {
+    case META_CLASS:                   /* Another nesting level */
+    case META_CLASS_NOT:
+    case META_CLASS_EMPTY:
+    case META_CLASS_EMPTY_NOT:
+    nestlevel++;
+    break;
+
+    case META_CLASS_END:               /* End of a nesting level */
+    nestlevel--;
+    break;
+
+    default:                           /* Contents of the class */
+    break;
+    }
+  }
+
+return pptr;
+}
+
