+/* Locate row @p row_index of channel @p file_c in the packed buffer of a
+   chunk coded as separate planes, following the same layout the packing
+   stage writes.  @p row_index is clamped to the rows the chunk holds for
+   the channel. */
+static const uint8_t*
+planar_channel_row (
+    const exr_encode_pipeline_t* encode, int16_t file_c, int32_t row_index)
+{
+    const uint8_t* row     = static_cast<const uint8_t*> (
+        encode->packed_buffer);
+    const uint8_t* matched = row;
+    int32_t        found   = 0;
+
+    for (int64_t y = encode->chunk.start_y;
+         y < (int64_t) encode->chunk.height + encode->chunk.start_y;
+         y++)
+    {
+        for (int16_t line_c = 0; line_c < encode->channel_count; line_c++)
+        {
+            if (y % encode->channels[line_c].y_samples != 0) continue;
+
+            if (line_c == file_c)
+            {
+                if (found == row_index) return row;
+                matched = row;
+                found++;
+            }
+
+            row += (size_t) encode->channels[line_c].bytes_per_element *
+                   (size_t) encode->channels[line_c].width;
+        }
+    }
+
+    return matched;
+}
