index c4ee9dd9df91db436b95e2d870e189d92689a994..22f87b16a8a0a39cc87ca911a266345667960ec9 100644
--- a/expat/lib/xmltok.c
+++ b/expat/lib/xmltok.c
@@ -1154,6 +1154,32 @@ static const char KW_yes[] = {ASCII_y, ASCII_e, ASCII_s, '\0'};
 
 static const char KW_no[] = {ASCII_n, ASCII_o, '\0'};
 
+/* Returns 1 if the version pseudo-attribute value delimited by
+   version .. versionEnd matches the VersionNum production "1." [0-9]+,
+   0 otherwise.
+*/
+static int
+checkXmlDeclVersionNum(const ENCODING *enc, const char *version,
+                       const char *versionEnd) {
+  char buf[20];
+  int len = 0;
+  int i;
+  const char *p;
+  for (p = version; p < versionEnd; p += enc->minBytesPerChar) {
+    if (len <= (int)sizeof(buf))
+      buf[len++] = (char)toAscii(enc, p, versionEnd);
+  }
+  if (len < 3)
+    return 0;
+  if (buf[0] != ASCII_1 || buf[1] != ASCII_PERIOD)
+    return 0;
+  for (i = 2; i < len; i++) {
+    if (buf[i] < ASCII_0 || buf[i] > ASCII_9)
+      return 0;
+  }
+  return 1;
+}
+
 static int
 doParseXmlDecl(const ENCODING *(*encodingFinder)(const ENCODING *, const char *,
                                                  const char *),
@@ -1181,10 +1207,9 @@ doParseXmlDecl(const ENCODING *(*encodingFinder)(const ENCODING *, const char *,
       *versionPtr = val;
     if (versionEndPtr)
       *versionEndPtr = ptr;
-    /* The version number must not be empty; VersionNum requires at least
-       one character.  The encoding and standalone pseudo-attributes below
-       already reject an empty value, so keep version consistent. */
-    if (val == ptr - enc->minBytesPerChar) {
+    /* The version number must match the VersionNum production "1." [0-9]+;
+       anything else (including an empty value) is rejected here. */
+    if (! checkXmlDeclVersionNum(enc, val, ptr - enc->minBytesPerChar)) {
       *badPtr = val;
       return 0;
     }
