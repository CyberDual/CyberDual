--- a/src/pcre2_dfa_match.c
+++ b/src/pcre2_dfa_match.c
@@ -405,8 +405,8 @@ return (mb->callout)(cb, mb->callout_data);
 
 /* This function is called when internal_dfa_match() is about to be called
 recursively and there is insufficient working space left in the current
-workspace block. If there's an existing next block, use it; otherwise get a new
-block unless the heap limit is reached.
+workspace block. If there's an existing next block large enough for this
+request, use it; otherwise get a new block unless the heap limit is reached.
 
 Arguments:
   rwsptr     pointer to block pointer (updated)
@@ -422,36 +422,68 @@ more_workspace(RWS_anchor **rwsptr, unsigned int ovecsize, dfa_match_block *mb)
 {
 RWS_anchor *rws = *rwsptr;
 RWS_anchor *new;
-
-if (rws->next != NULL)
-  {
-  new = rws->next;
-  }
+uint32_t anchor = (uint32_t)RWS_ANCHOR_SIZE;
+uint32_t minsize;
 
 /* Sizes in the RWS_anchor blocks are in units of sizeof(int), but
-mb->heap_limit and mb->heap_used are in kibibytes. Play carefully, to avoid
-overflow. */
+mb->heap_limit and mb->heap_used are in kibibytes. A cached next block may
+have been sized for a smaller frame, so reuse it only when it can hold this
+request. Otherwise allocate, keeping any existing block on the chain. */
+
+if (ovecsize > UINT32_MAX - (RWS_RSIZE + anchor))
+  return PCRE2_ERROR_NOMEMORY;
+minsize = RWS_RSIZE + ovecsize + anchor;
 
+if (rws->next != NULL && rws->next->size >= minsize)
+  new = rws->next;
 else
   {
-  uint32_t newsize = (rws->size >= UINT32_MAX/(sizeof(int)*2))? UINT32_MAX/sizeof(int) : rws->size * 2;
-  uint32_t newsizeK = newsize/(1024/sizeof(int));
+  uint64_t doubled;
+  uint64_t bytes;
+  uint64_t kib;
+  uint32_t newsize;
+  RWS_anchor *oldnext = rws->next;
+
+  if ((uint64_t)rws->size > UINT32_MAX / 2)
+    doubled = (uint64_t)UINT32_MAX / sizeof(int);
+  else
+    doubled = (uint64_t)rws->size * 2;
+  if (doubled < minsize) doubled = minsize;
+
+  bytes = doubled * sizeof(int);
+  kib = (bytes + 1023) / 1024;
 
-  if (newsizeK + mb->heap_used > mb->heap_limit)
-    newsizeK = (uint32_t)(mb->heap_limit - mb->heap_used);
-  newsize = newsizeK*(1024/sizeof(int));
+  if (mb->heap_used >= mb->heap_limit ||
+      kib > (uint64_t)mb->heap_limit - mb->heap_used)
+    {
+    uint64_t remain;
+    uint64_t max_ints;
+    uint32_t alloc_ints;
+
+    if (mb->heap_used >= mb->heap_limit) return PCRE2_ERROR_HEAPLIMIT;
+    remain = (uint64_t)mb->heap_limit - mb->heap_used;
+    max_ints = (remain * 1024) / sizeof(int);
+    if (max_ints < minsize) return PCRE2_ERROR_HEAPLIMIT;
+
+    newsize = (uint32_t)max_ints;
+    alloc_ints = newsize;
+    if (newsize > ovecsize && ovecsize > newsize - minsize)
+      alloc_ints = newsize - ovecsize;
+    bytes = (uint64_t)alloc_ints * sizeof(int);
+    kib = remain;
+    }
+  else
+    newsize = (uint32_t)doubled;
 
-  if (newsize < RWS_RSIZE + ovecsize + RWS_ANCHOR_SIZE)
-    return PCRE2_ERROR_HEAPLIMIT;
