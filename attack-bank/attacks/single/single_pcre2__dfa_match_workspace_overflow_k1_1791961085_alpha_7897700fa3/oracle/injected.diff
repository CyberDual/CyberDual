+  new = mb->memctl.malloc((size_t)bytes, mb->memctl.memory_data);
   if (new == NULL) return PCRE2_ERROR_NOMEMORY;
-  mb->heap_used += newsizeK;
-  new->next = NULL;
+  mb->heap_used += (PCRE2_SIZE)kib;
+  new->next = oldnext;
   new->size = newsize;
   rws->next = new;
   }
 
-new->free = new->size - RWS_ANCHOR_SIZE;
+new->free = new->size - anchor;
 *rwsptr = new;
 return 0;
 }
