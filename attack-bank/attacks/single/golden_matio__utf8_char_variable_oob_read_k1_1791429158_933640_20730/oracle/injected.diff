+static int
+ValidateUtf8CharData(const mat_uint8_t *data, size_t nbytes, size_t expected)
+{
+    size_t i = 0;
+    size_t nchars = 0;
+
+    while ( i < nbytes ) {
+        const mat_uint8_t c = data[i];
+        size_t len;
+
+        if ( c <= 0x7F )
+            len = 1;
+        else if ( (c & 0xE0) == 0xC0 )
+            len = 2;
+        else if ( (c & 0xF0) == 0xE0 )
+            len = 3;
+        else if ( (c & 0xF8) == 0xF0 )
+            len = 4;
+        else
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+
+        if ( i + len - 1 > nbytes )
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+
+        i += len;
+        nchars++;
+    }
+
+    return nchars == expected ? MATIO_E_NO_ERROR : MATIO_E_FILE_FORMAT_VIOLATION;
+}
