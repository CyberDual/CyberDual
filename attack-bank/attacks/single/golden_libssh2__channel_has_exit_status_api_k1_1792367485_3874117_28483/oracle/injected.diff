index e3ab8bfebd1774d07f1207fd2e731f4a66eb2b66..b2ce36f87c2b87eb3cb100a0c64b7536f9cb85ce 100644
--- a/src/channel.c
+++ b/src/channel.c
@@ -1646,6 +1646,21 @@ int libssh2_channel_get_exit_status(LIBSSH2_CHANNEL *channel)
     return channel->exit_status;
 }
 
+/*
+ * Return 1 if the channel was told how its command ended, 0 if it was
+ * not.  libssh2_channel_get_exit_status() cannot tell these apart: a
+ * channel the peer closed without sending an exit-status request
+ * reports 0, the same value a command that exited cleanly reports.
+ * An exit signal counts as well.  We return a zero if channel is NULL.
+ */
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+{
+    if(!channel)
+        return 0;
+
+    return channel->exit_status_received;
+}
+
