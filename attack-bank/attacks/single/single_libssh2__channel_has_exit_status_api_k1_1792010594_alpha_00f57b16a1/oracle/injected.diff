diff --git a/src/channel.c b/src/channel.c
index e3ab8bfebd1774d07f1207fd2e731f4a66eb2b66..6e833a69261860a953f84f3b673ccb0fcd37cd92 100644
--- a/src/channel.c
+++ b/src/channel.c
@@ -1646,6 +1646,22 @@ int libssh2_channel_get_exit_status(LIBSSH2_CHANNEL *channel)
     return channel->exit_status;
 }
 
+/*
+ * libssh2_channel_get_exit_status() returns 0 both when the remote process
+ * exited with status 0 and when no exit-status request has arrived. This
+ * reports whether the peer actually delivered one.
+ *
+ * Returns 1 if an exit-status request was received, 0 otherwise (including
+ * when channel is NULL).
+ */
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+{
+    if(!channel)
+        return 0;
+
+    return channel->exit_status_received ? 1 : 0;
+}
