diff --git a/docs/libssh2_channel_has_exit_status.md b/docs/libssh2_channel_has_exit_status.md
new file mode 100644
index 0000000000000000000000000000000000000000..634348370657d83bc1cd4f2ec82405d414e5a5a7
--- /dev/null
+++ b/docs/libssh2_channel_has_exit_status.md
@@ -0,0 +1,44 @@
+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+  - libssh2_channel_get_exit_status(3)
+  - libssh2_channel_get_exit_signal(3)
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - check whether an exit status was received
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel);
+~~~
+
+# DESCRIPTION
+
+*channel* - Channel stream to query.
+
+Returns whether the remote peer has delivered an exit-status request for
+the named channel. libssh2_channel_get_exit_status(3) returns 0 both when
+the remote process exited with status 0 and when no exit status has arrived
+yet; use this function to distinguish those cases.
+
+Some servers close a channel without sending exit-status (for example
+OpenSSH when ChannelTimeout fires). This function returns 0 in that case
+even after the channel is closed.
+
+# RETURN VALUE
+
+Returns 1 if an exit-status request has been received for *channel*,
+otherwise 0. Also returns 0 if *channel* is NULL.
+
+# AVAILABILITY
+
+Added in libssh2 1.12.0
