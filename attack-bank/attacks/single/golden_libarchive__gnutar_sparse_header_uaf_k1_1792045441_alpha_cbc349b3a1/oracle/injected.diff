-			    "memcmp needle has length `%0', but is checked with length `%1'");
-			clang::DiagnosticBuilder db = diag.Report(lenExpr->getLocation(), did);
-			db.AddTaggedVal(needle->getLength(), clang::DiagnosticsEngine::ArgumentKind::ak_uint);
