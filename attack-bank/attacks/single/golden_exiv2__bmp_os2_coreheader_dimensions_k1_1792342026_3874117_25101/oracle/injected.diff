+TEST(BmpImage, readMetadataReadsImageDimensionsForOs2V1Header) {
+  // OS/2 1.x / Windows 2.x BMP files carry the 12-byte BITMAPCOREHEADER, whose width and height
+  // fields are 16-bit instead of the 32-bit fields used by BITMAPINFOHEADER.
+  const std::array<unsigned char, 26> header{
+      'B',  'M',               // Signature                                                         off:0   size:2
+      0x1A, 0x00, 0x00, 0x00,  // Size of the BMP file in bytes                                     off:2   size:4
+      0x00, 0x00,              // Reserved                                                          off:6   size:2
+      0x00, 0x00,              // Reserved                                                          off:8   size:2
+      0x1A, 0x00, 0x00, 0x00,  // Offset of the byte where the bitmap image data can be found       off:10  size:4
+      0x0C, 0x00, 0x00, 0x00,  // Size of this header (12: BITMAPCOREHEADER)                        off:14  size:4
+      0x40, 0x01,              // The bitmap width in pixels (unsigned 16 bit): 320                 off:18  size:2
+      0xC8, 0x00,              // The bitmap height in pixels (unsigned 16 bit): 200                off:20  size:2
+  };
+
+  auto memIo = std::make_unique<MemIo>(header.data(), header.size());
+  BmpImage bmp(std::move(memIo), defaultImageCtorParams(false));
+  ASSERT_NO_THROW(bmp.readMetadata());
+  ASSERT_EQ(320u, bmp.pixelWidth());
+  ASSERT_EQ(200u, bmp.pixelHeight());
+}
+
+TEST(BmpImage, readMetadataReadsImageDimensionsWhenHeaderIsComplete) {
+  // A plain BITMAPINFOHEADER file: the DIB header declared at offset 14 is 40 bytes long and is
+  // fully present in the data.
+  const std::array<unsigned char, 54> header{
+      'B',  'M',               // Signature                                                         off:0   size:2
+      0x36, 0x00, 0x00, 0x00,  // Size of the BMP file in bytes                                     off:2   size:4
+      0x00, 0x00,              // Reserved                                                          off:6   size:2
+      0x00, 0x00,              // Reserved                                                          off:8   size:2
+      0x36, 0x00, 0x00, 0x00,  // Offset of the byte where the bitmap image data can be found       off:10  size:4
+      0x28, 0x00, 0x00, 0x00,  // Size of this header (40: BITMAPINFOHEADER)                        off:14  size:4
+      0x00, 0x05, 0x00, 0x00,  // The bitmap width in pixels (unsigned 32 bit): 1280                off:18  size:4
+      0x20, 0x03, 0x00, 0x00,  // The bitmap height in pixels (unsigned 32 bit): 800                off:22  size:4
+      0x01, 0x00,              // Plane count                                                       off:26  size:2
+      0x18, 0x00,              // Depth                                                             off:28  size:2
+      // Compression, image size, resolutions and colour counts are all zero.
+  };
+
+  auto memIo = std::make_unique<MemIo>(header.data(), header.size());
+  BmpImage bmp(std::move(memIo), defaultImageCtorParams(false));
+  ASSERT_NO_THROW(bmp.readMetadata());
+  ASSERT_EQ(1280u, bmp.pixelWidth());
+  ASSERT_EQ(800u, bmp.pixelHeight());
+}
