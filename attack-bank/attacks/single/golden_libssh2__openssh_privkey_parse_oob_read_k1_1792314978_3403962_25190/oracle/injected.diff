+/* Reads the key type string from the decrypted private key data and
+   copies it into a null-terminated buffer, since the decrypted data
+   itself is not null-terminated. */
+static int ossl_openssh_key_type(LIBSSH2_SESSION *session,
+                                 struct string_buf *decrypted,
+                                 char *keytype, size_t keytype_size)
+{
+    unsigned char *buf = NULL;
+    size_t buf_len = 0;
+
+    if(ssh2_get_string(decrypted, &buf, &buf_len) || !buf)
+        return ssh2_err(session, LIBSSH2_ERROR_PROTO,
+                        "Public key type in decrypted key data not found");
+
+    if(buf_len > keytype_size)
+        return ssh2_err(session, LIBSSH2_ERROR_PROTO,
+                        "Unsupported private key type");
+
+    memcpy(keytype, buf, buf_len);
+    keytype[buf_len] = '\0';
+
+    return 0;
+}
