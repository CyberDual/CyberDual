+/* Prints the opening of a negative character class.
+
+Arguments:
+  out            output context
+  separator      glob separator
+  with_escape    backslash is needed before separator
+  no_wildsep     wildcards may match separator
+*/
+
+static void
+convert_glob_print_negative_class(pcre2_output_context *out,
+  PCRE2_UCHAR separator, BOOL with_escape, BOOL no_wildsep)
+{
+uint32_t length = 0;
+
+out->out_str[length++] = (uint8_t) CHAR_LEFT_SQUARE_BRACKET;
+out->out_str[length++] = (uint8_t) CHAR_CIRCUMFLEX_ACCENT;
+
+if (!no_wildsep)
+  {
+  if (with_escape)
+    out->out_str[length++] = (uint8_t) CHAR_BACKSLASH;
+
+  out->out_str[length++] = (uint8_t) separator;
+  }
+
+if (with_escape)
+  memset(out->out_str + length, 0, sizeof(out->out_str) - length + 1);
+
+convert_glob_write_str(out, length);
+}
+
+
 /* Parse a posix class.
 
