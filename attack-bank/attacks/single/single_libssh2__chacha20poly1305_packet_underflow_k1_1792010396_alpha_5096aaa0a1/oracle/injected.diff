diff --git a/src/crypt.c b/src/crypt.c
index 11efd28a8873f23f1ae2527957e70db3c7efcec8..a95166b992895559148dae89676679a2c2225bc9 100644
--- a/src/crypt.c
+++ b/src/crypt.c
@@ -433,13 +433,28 @@ static int crypt_encrypt_chacha20_poly_buffer(LIBSSH2_SESSION *session,
         else {
             /* buf is full packet including size and auth tag but buf_len
                does not include size */
+            size_t keep;
+
+            /* need the 4-byte length prefix before it can be stripped */
+            if(buf_len < 4)
+                return 1;
+
             ret = chachapoly_crypt(&ctx->chachapoly_ctx, seqno, buf, buf,
                                    buf_len, 4, ctx->encrypt);
 
             /* the api expects the size field to already be removed
                from the decrypted packet so we help it out */
-            if(ret == 0)
-                memmove(buf, buf + 4, buf_len - 4);
+            if(ret == 0) {
+                keep = buf_len - 4;
+                if(keep < 4) {
+                    unsigned char tmp[4];
+
+                    memcpy(tmp, buf + 4, keep + 4);
+                    memcpy(buf, tmp, keep);
+                }
+                else
+                    memmove(buf, buf + 4, keep);
+            }
         }
     }
 
