+                size_t nchars = 1;
+                err = Mat_MulDims(matvar, &nchars);
+                if ( !err )
+                    err = ValidateUtf8CharData((const mat_uint8_t *)matvar->data, matvar->nbytes,
+                                               nchars);
+                if ( err ) {
+                    free(matvar->data);
+                    matvar->data = NULL;
+                    matvar->nbytes = 0;
+                }
+            }
