@@ -713,7 +713,7 @@ lzma_index_append(lzma_index *i, const lzma_allocator *allocator,
 			return LZMA_MEM_ERROR;
 
 		g->last = 0;
-		g->allocated = i->prealloc;
+		g->allocated = i->prealloc + (i->prealloc & 1);
 
 		// Reset prealloc so that if the application happens to
