+static int test_pton6_trailing_colon(void)
+{
+  unsigned char addr[16];
+
+  if(curlx_inet_pton(AF_INET6, "1:2:3:4:5:6:7:8:", addr) != 0)
+    return 1;
+  if(curlx_inet_pton(AF_INET6, "::1:", addr) != 0)
+    return 1;
+  if(curlx_inet_pton(AF_INET6, "::1", addr) != 1)
+    return 1;
+  if(curlx_inet_pton(AF_INET6, "1:2:3:4:5:6:7:8", addr) != 1)
+    return 1;
+
+  return 0;
+}
