+/** @brief Validates UTF-8 character data read from a MAT file
+ *
+ * Walks @c nbytes bytes of UTF-8 data, verifying that every byte is part of a
+ * well-formed multi-byte sequence whose continuation bytes are all present
+ * within the buffer. Truncated sequences (a lead byte whose continuation bytes
+ * extend past the end of the data) and bytes that cannot start a sequence are
+ * rejected, so malformed character data is not handed back to the caller.
+ *
+ * @ingroup mat_internal
+ * @param data pointer to the UTF-8 data
+ * @param nbytes number of bytes in @c data
+ * @retval MATIO_E_NO_ERROR if the data is valid, MATIO_E_FILE_FORMAT_VIOLATION otherwise
+ */
+static int
+ValidateUtf8CharData(const mat_uint8_t *data, size_t nbytes)
+{
+    size_t i = 0;
+
+    while ( i < nbytes ) {
+        const mat_uint8_t c = data[i];
+        size_t len;
+        if ( c <= 0x7F )
+            len = 1;
+        else if ( (c & 0xE0) == 0xC0 )
+            len = 2;
+        else if ( (c & 0xF0) == 0xE0 )
+            len = 3;
+        else if ( (c & 0xF8) == 0xF0 )
+            len = 4;
+        else
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+        if ( i + len > nbytes )
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+        i += len;
+    }
+
+    return MATIO_E_NO_ERROR;
+}
+
