diff --git a/lib/mprintf.c b/lib/mprintf.c
index d4725c905fe1a2e9ddc19516e45f0cb4432325ac..335e6d34787c992fe6dee7362c32b18387d40c68 100644
--- a/lib/mprintf.c
+++ b/lib/mprintf.c
@@ -793,9 +793,12 @@ static bool out_number(void *userp,
     }
   }
 
-  /* Supply a default precision if none was given. */
+  /* Supply a default precision if none was given. There is no point in a
+     precision longer than what the work buffer can hold. */
   if(prec == -1)
     prec = 1;
+  else if(prec > BUFFSIZE)
+    prec = BUFFSIZE;
 
   /* Put the number in WORK. */
   w = workend;
@@ -824,7 +827,7 @@ static bool out_number(void *userp,
 
   if(prec > 0) {
     width -= prec;
-    while(prec-- > 0 && w >= work)
+    while(prec-- > 0)
       *w-- = '0';
   }
 
diff --git a/lib/vdns/doh.c b/lib/vdns/doh.c
index 3b52ed92f3621dd7c33aae26f66c2ab4b168641c..7fdea0968a8684fa3c43010dde592f25b2471761 100644
--- a/lib/vdns/doh.c
+++ b/lib/vdns/doh.c
@@ -584,6 +584,7 @@ static DOHcode doh_rdata(const unsigned char *doh,
                          int index,
                          struct dohentry *d)
 {
+  DOHcode rc = DOH_OK;
   /* RDATA
      - A (TYPE 1): 4 bytes
      - AAAA (TYPE 28): 16 bytes
@@ -600,12 +601,15 @@ static DOHcode doh_rdata(const unsigned char *doh,
     doh_store_aaaa(doh, index, d);
     break;
 #ifdef USE_HTTPSRR
-  case CURL_DNS_TYPE_HTTPS: {
-    DOHcode rc = doh_store_https(doh, index, d, rdlength);
+  case CURL_DNS_TYPE_HTTPS:
+    /* SvcPriority (2 octets) and TargetName (at least the root label) must
+       be present, everything else is a malformed record */
+    if(rdlength < 2 + 1)
+      return DOH_DNS_RDATA_LEN;
+    rc = doh_store_https(doh, index, d, rdlength);
     if(rc)
       return rc;
     break;
-  }
 #endif
   default:
     /* unsupported type, or type we do not store, skip it */
