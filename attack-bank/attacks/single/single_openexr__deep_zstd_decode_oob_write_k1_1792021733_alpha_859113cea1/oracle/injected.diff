+static exr_result_t
+exr_zstd_validate_deep_sample_counts (
+    const exr_decode_pipeline_t*     decode,
+    const exr_coding_channel_info_t* channels,
+    int                              channel_count,
+    uint64_t                         uncompressed_size)
+{
+    uint64_t       total_bytes = 0;
+    const int32_t* row;
+
+    if (!decode->sample_count_table || decode->chunk.width <= 0 ||
+        decode->chunk.height <= 0 || channel_count <= 0)
+        return EXR_ERR_CORRUPT_CHUNK;
+
+    for (int h = 0; h < decode->chunk.height; ++h)
+    {
+        int32_t previous = 0;
+        uint64_t row_bytes = 0;
+
+        row = decode->sample_count_table +
+              (size_t) h * (size_t) decode->chunk.width;
+        for (int x = 0; x < decode->chunk.width; ++x)
+        {
+            if (row[x] < previous) return EXR_ERR_CORRUPT_CHUNK;
+            previous = row[x];
+        }
+
+        if (previous == 0 &&
+            (decode->decode_flags & EXR_DECODE_SAMPLE_COUNTS_AS_INDIVIDUAL) !=
+                0)
+        {
+            size_t total_offset =
+                (size_t) decode->chunk.width * (size_t) decode->chunk.height;
+            uint64_t trailing_total = 0;
+            for (int c = 0; c < channel_count; ++c)
+            {
+                int32_t value = decode->sample_count_table[total_offset + c];
+                trailing_total += (uint64_t) (uint32_t) value;
+            }
+            if (trailing_total != 0) return EXR_ERR_CORRUPT_CHUNK;
+        }
+
+        for (int c = 0; c < channel_count; ++c)
+        {
+            if (channels[c].bytes_per_element != 2 &&
+                channels[c].bytes_per_element != 4)
+                return EXR_ERR_CORRUPT_CHUNK;
+
+            uint64_t channel_bytes = (uint64_t) channels[c].bytes_per_element;
+            uint64_t available = UINT64_MAX - row_bytes;
+            uint64_t samples    = (uint64_t) previous;
+            if (samples > available / channel_bytes)
+                return EXR_ERR_CORRUPT_CHUNK;
+            row_bytes += samples * channel_bytes;
+        }
+
+        if (row_bytes > UINT64_MAX - total_bytes)
+            return EXR_ERR_CORRUPT_CHUNK;
+        total_bytes += row_bytes;
+    }
+
+    if (total_bytes != uncompressed_size) return EXR_ERR_CORRUPT_CHUNK;
+    return EXR_ERR_SUCCESS;
+}
