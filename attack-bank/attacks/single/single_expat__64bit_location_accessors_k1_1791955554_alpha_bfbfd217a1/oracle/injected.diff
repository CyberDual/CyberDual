diff --git a/expat/tests/basic_tests.c b/expat/tests/basic_tests.c
index 8f4f0902d5c78f6cf4b49389cc2184d13e61374d..a986505d9116875c14e8ff8f37b41e3c6ca56651 100644
--- a/expat/tests/basic_tests.c
+++ b/expat/tests/basic_tests.c
@@ -751,6 +751,79 @@ START_TEST(test_column_number_after_error) {
 }
 END_TEST
 
+/* Check the 64-bit variants of the position accessors. */
+START_TEST(test_location_accessors_64bit) {
+  const char *text = "<tag>\n"
+                     "\n"
+                     "\n</tag>";
+  if (_XML_Parse_SINGLE_BYTES(g_parser, text, (int)strlen(text), XML_TRUE)
+      == XML_STATUS_ERROR)
+    xml_failure(g_parser);
+
+  if (XML_GetCurrentLineNumber64(g_parser) != 4) {
+    char buffer[100];
+    snprintf(buffer, sizeof(buffer), "expected 4 lines, saw %llu",
+             (unsigned long long)XML_GetCurrentLineNumber64(g_parser));
+    fail(buffer);
+  }
+  if (XML_GetCurrentLineNumber64(g_parser)
+      != XML_GetCurrentLineNumber(g_parser))
+    fail("64-bit line number does not match line number");
+  if (XML_GetCurrentColumnNumber64(g_parser)
+      != XML_GetCurrentColumnNumber(g_parser))
+    fail("64-bit column number does not match column number");
+  if (XML_GetCurrentByteIndex64(g_parser)
+      != (int64_t)XML_GetCurrentByteIndex(g_parser))
+    fail("64-bit byte index does not match byte index");
+}
+END_TEST
+
+static void XMLCALL
+byte_character_handler_64bit(void *userData, const XML_Char *s, int len) {
+  XML_Parser parser = (XML_Parser)userData;
+  int64_t offset = -1;
+  int64_t size = -1;
+  const char *buffer;
+
+  UNUSED_P(s);
+  buffer = XML_GetInputContext64(parser, &offset, &size);
+  if (buffer == NULL)
+    return; /* i.e. XML_CONTEXT_BYTES == 0 */
+  if (offset != 5)
+    fail("Context offset in unexpected position");
+  if (size != 16)
+    fail("Context size is not full buffer");
+  if (XML_GetCurrentByteIndex64(parser) != offset)
+    fail("64-bit byte index does not match context offset");
+  if (XML_GetCurrentByteCount64(parser) != len)
+    fail("64-bit byte count incorrect");
+  if (XML_GetCurrentLineNumber64(parser) != 1)
+    fail("64-bit line number incorrect");
+  if (XML_GetCurrentColumnNumber64(parser) != 5)
+    fail("64-bit column number incorrect");
+}
+
+/* Check the 64-bit variants of the position accessors inside a handler. */
+START_TEST(test_location_accessors_64bit_in_handler) {
+  const char *text = "<tag>hello</tag>";
+  int64_t index;
+  uint64_t column;
+
+  XML_SetUserData(g_parser, g_parser);
+  XML_SetCharacterDataHandler(g_parser, byte_character_handler_64bit);
+  if (XML_Parse(g_parser, text, (int)strlen(text), XML_TRUE) != XML_STATUS_OK)
+    xml_failure(g_parser);
+
+  /* Check the accessors also after parsing. */
+  index = XML_GetCurrentByteIndex64(g_parser);
+  column = XML_GetCurrentColumnNumber64(g_parser);
+  if (index != (int64_t)XML_GetCurrentByteIndex(g_parser))
+    fail("64-bit byte index does not match byte index after parse");
+  if (column != (uint64_t)XML_GetCurrentColumnNumber(g_parser))
+    fail("64-bit column number does not match column number after parse");
+}
+END_TEST
