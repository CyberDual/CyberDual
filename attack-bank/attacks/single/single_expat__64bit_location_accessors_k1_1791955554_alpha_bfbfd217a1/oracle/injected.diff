diff --git a/expat/lib/xmlparse.c b/expat/lib/xmlparse.c
index 07730f6902888eaaccfef52b61cf22cffa10cca9..14d2f1d825cd525c128d38e064ea0ffcd874f44e 100644
--- a/expat/lib/xmlparse.c
+++ b/expat/lib/xmlparse.c
@@ -2788,6 +2788,88 @@ XML_GetCurrentColumnNumber(XML_Parser parser) {
   return (XML_Size)parser->m_position.columnNumber;
 }
 
+int64_t XMLCALL
+XML_GetCurrentByteIndex64(XML_Parser parser) {
+  if (parser == NULL)
+    return -1;
+  if (parser->m_eventPtr) {
+    return (int64_t)(parser->m_parseEndByteIndex
+                     - (parser->m_parseEndPtr - parser->m_eventPtr));
+  }
+  return -1;
+}
+
+int64_t XMLCALL
+XML_GetCurrentByteCount64(XML_Parser parser) {
+  if (parser == NULL)
+    return 0;
+  if (parser->m_openInternalEntities) {
+    const OPEN_INTERNAL_ENTITY *const openEntity = parser->m_openInternalEntities;
+    if (openEntity->internalEventPtr && openEntity->internalEventEndPtr)
+      return (int64_t)(openEntity->internalEventEndPtr
+                       - openEntity->internalEventPtr);
+    return 0;
+  }
+  if (parser->m_eventPtr && parser->m_eventEndPtr)
+    return (int64_t)(parser->m_eventEndPtr - parser->m_eventPtr);
+  return 0;
+}
+
+const char *XMLCALL
+XML_GetInputContext64(XML_Parser parser, int64_t *offset, int64_t *size) {
+#if XML_CONTEXT_BYTES > 0
+  if (parser == NULL)
+    return NULL;
+  if (parser->m_eventPtr && parser->m_buffer) {
+    if (offset != NULL)
+      *offset = (int64_t)(parser->m_eventPtr - parser->m_buffer);
+    if (size != NULL)
+      *size = (int64_t)(parser->m_bufferEnd - parser->m_buffer);
+    return parser->m_buffer;
+  }
+#else
+  (void)parser;
+  (void)offset;
+  (void)size;
+#endif /* XML_CONTEXT_BYTES > 0 */
+  return NULL;
+}
+
+// NOTE: For an event inside an internal entity, the position relates to
+//       the internal event, not to the entity reference in the document.
+static const char *
+currentEventPtr(XML_Parser parser) {
+  if (parser->m_openInternalEntities)
+    return parser->m_openInternalEntities->internalEventPtr;
+  return parser->m_eventPtr;
+}
+
+uint64_t XMLCALL
+XML_GetCurrentLineNumber64(XML_Parser parser) {
+  if (parser == NULL)
+    return 0;
+  const char *const eventPtr = currentEventPtr(parser);
+  if (eventPtr && eventPtr >= parser->m_positionPtr) {
+    XmlUpdatePosition(parser->m_encoding, parser->m_positionPtr, eventPtr,
+                      &parser->m_position);
+    parser->m_positionPtr = eventPtr;
+  }
+  return parser->m_position.lineNumber + 1;
+}
+
+uint64_t XMLCALL
+XML_GetCurrentColumnNumber64(XML_Parser parser) {
+  if (parser == NULL)
+    return 0;
+  const char *const eventPtr = currentEventPtr(parser);
+  if (eventPtr && eventPtr >= parser->m_positionPtr) {
+    XmlUpdatePosition(parser->m_encoding, parser->m_positionPtr, eventPtr,
+                      &parser->m_position);
+    parser->m_positionPtr = eventPtr;
+  }
+  return parser->m_position.columnNumber;
+}
