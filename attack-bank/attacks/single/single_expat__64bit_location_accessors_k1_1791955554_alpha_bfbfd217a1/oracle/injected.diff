diff --git a/expat/lib/expat.h b/expat/lib/expat.h
index 4c3851d50a5fdf3c86854d5805d54ab429a124a1..f9be5fd9b91c5de86ba3843834c50c9017473087 100644
--- a/expat/lib/expat.h
+++ b/expat/lib/expat.h
@@ -987,6 +987,44 @@ XML_GetCurrentByteCount(XML_Parser parser);
 XMLPARSEAPI(const char *)
 XML_GetInputContext(XML_Parser parser, int *offset, int *size);
 
+/* These functions report the same information as their counterparts
+   above but cover inputs of any size, also where XML_Index and XML_Size
+   are 32-bit, e.g. on 32-bit systems and on 64-bit Windows.
+
+   Note: XML_GetCurrentLineNumber64 and XML_GetCurrentColumnNumber64
+   return 0 to indicate an error.
+   Note: XML_GetCurrentByteIndex64 returns -1 to indicate an error.
+   Note: For an event inside an internal entity, line and column numbers
+   and the byte count relate to the internal event, not to the entity
+   reference in the document.
+*/
+XMLPARSEAPI(uint64_t)
+XML_GetCurrentLineNumber64(XML_Parser parser);
+XMLPARSEAPI(uint64_t)
+XML_GetCurrentColumnNumber64(XML_Parser parser);
+XMLPARSEAPI(int64_t)
+XML_GetCurrentByteIndex64(XML_Parser parser);
+
+/* Return the number of bytes in the current event.
+   Returns 0 if the event is in an internal entity and the number of
+   bytes of that internal event is not available.
+*/
+XMLPARSEAPI(int64_t)
+XML_GetCurrentByteCount64(XML_Parser parser);
+
+/* If XML_CONTEXT_BYTES is >=1, returns the input buffer, sets
+   the integer pointed to by offset to the offset within this buffer
+   of the current parse position, and sets the integer pointed to by size
+   to the size of this buffer (the number of input bytes). Otherwise
+   returns a NULL pointer. Also returns a NULL pointer if a parse isn't
+   active.
+
+   NOTE: The character pointer returned should not be used outside
+   the handler that makes the call.
+*/
+XMLPARSEAPI(const char *)
+XML_GetInputContext64(XML_Parser parser, int64_t *offset, int64_t *size);
+
 /* For backwards compatibility with previous versions. */
 #  define XML_GetErrorLineNumber XML_GetCurrentLineNumber
 #  define XML_GetErrorColumnNumber XML_GetCurrentColumnNumber
