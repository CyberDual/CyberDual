+  if(bad || uc) {
     curlx_dyn_free(encp);
-    return CURLUE_BAD_HOSTNAME;
+    return bad ? CURLUE_BAD_HOSTNAME : uc;
   }
   return CURLUE_OK;
 }
@@ -2159,8 +2309,12 @@ CURLUcode curl_url_set(CURLU *u, CURLUPart what,
 
       if(appendquery && newp)
