+/*
+ * 'host' is the plain host name. If it is a legacy numerical IPv4 address,
+ * like '127.1', '0177.1' or '0x7f.1', 'encp' is replaced with the address
+ * written in normalized dotted decimal form - the same way such addresses
+ * are treated when a full URL is parsed.
+ *
+ * A single dot at the end of the address is accepted and treated as if it
+ * was not there.
+ */
+static CURLUcode urlhost_ipv4(struct dynbuf *encp, const char *host)
+{
+  unsigned int parts[4] = { 0, 0, 0, 0 };
+  const char *c = host;
+  bool done = FALSE;
+  int n = 0;
+
+  if(!ISDIGIT(*c))
+    /* cannot be a numerical IPv4 address */
+    return CURLUE_OK;
+
+  while(!done) {
+    char num[IPV4_NUM_MAX + 1]; /* room for a 32 bit number */
+    const char *p = num;
+    size_t len = 0;
+    curl_off_t val = 0;
+    int base = 10;
+    int rc;
+
+    if((*c == '0') && ((c[1] | 0x20) == 'x')) {
+      /* hexadecimal number */
+      num[len++] = *c++;
+      num[len++] = *c++;
+      p += 2; /* skip the prefix for the number conversion */
+      base = 16;
+    }
+    else if(*c == '0')
+      /* octal number */
+      base = 8;
+
+    while(((base == 16) ? ISXDIGIT(*c) : ISDIGIT(*c)) &&
+          (len < sizeof(num)))
+      num[len++] = *c++;
+
+    num[len] = 0;
+
+    if((base == 16) ? ISXDIGIT(*c) : ISDIGIT(*c))
+      /* more digits than what fits in a 32 bit number */
+      return CURLUE_OK;
+
+    rc = (base == 16) ? curlx_str_hex(&p, &val, UINT_MAX) :
+      (base == 8) ? curlx_str_octal(&p, &val, UINT_MAX) :
+      curlx_str_number(&p, &val, UINT_MAX);
+    if(rc) {
+      if(!n || len || *c)
+        /* not a numerical IPv4 address */
+        return CURLUE_OK;
+      /* an empty last part: the address ends with a dot */
+      n--;
+    }
+    else
+      parts[n] = (unsigned int)val;
+
+    switch(*c) {
+    case '.':
+      if(n == 3) {
+        if(c[1])
+          /* something follows this dot */
+          return CURLUE_OK;
+        done = TRUE;
+      }
+      else {
+        n++;
+        c++;
+      }
+      break;
+
+    case '\0':
+      done = TRUE;
+      break;
+
+    default:
+      /* not a numerical IPv4 address */
+      return CURLUE_OK;
+    }
+  }
+
+  /* a numerical IPv4 address: store it in normalized dotted decimal form */
+  {
+    struct dynbuf plain;
+    CURLcode result;
+
+    curlx_dyn_init(&plain, CURL_MAX_INPUT_LENGTH);
+    switch(n) {
+    case 0: /* a -- 32 bits */
+      result = curlx_dyn_addf(&plain, "%u.%u.%u.%u",
+                              (parts[0] >> 24),
+                              ((parts[0] >> 16) & 0xff),
+                              ((parts[0] >> 8) & 0xff),
+                              (parts[0] & 0xff));
+      break;
+    case 1: /* a.b -- 8.24 bits */
+      if((parts[0] > 0xff) || (parts[1] > 0xffffff))
+        return CURLUE_OK;
+      result = curlx_dyn_addf(&plain, "%u.%u.%u.%u",
+                              parts[0],
+                              ((parts[1] >> 16) & 0xff),
+                              ((parts[1] >> 8) & 0xff),
+                              (parts[1] & 0xff));
+      break;
+    case 2: /* a.b.c -- 8.8.16 bits */
+      if((parts[0] > 0xff) || (parts[1] > 0xff) || (parts[2] > 0xffff))
+        return CURLUE_OK;
+      result = curlx_dyn_addf(&plain, "%u.%u.%u.%u",
+                              parts[0],
+                              parts[1],
+                              ((parts[2] >> 8) & 0xff),
+                              (parts[2] & 0xff));
+      break;
+    case 3: /* a.b.c.d -- 8.8.8.8 bits */
+    default:
+      if((parts[0] > 0xff) || (parts[1] > 0xff) || (parts[2] > 0xff) ||
+         (parts[3] > 0xff))
+        return CURLUE_OK;
+      result = curlx_dyn_addf(&plain, "%u.%u.%u.%u",
+                              parts[0],
+                              parts[1],
+                              parts[2],
+                              parts[3]);
+      break;
+    }
+    if(result)
+      return CURLUE_OUT_OF_MEMORY;
+
+    /* the normalized address only consists of digits and dots so it is fine
+       to store it like this */
+    curlx_dyn_free(encp);
+    *encp = plain;
+  }
+  return CURLUE_OK;
+}
