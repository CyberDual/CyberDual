diff --git a/src/bmpimage.cpp b/src/bmpimage.cpp
index e3377b62895585ac9c1f2ae4780ab52382feaaaf..9bec8edef6999e3cb6c9dc5096d99595061eb64b 100644
--- a/src/bmpimage.cpp
+++ b/src/bmpimage.cpp
@@ -62,7 +62,7 @@ void BmpImage::readMetadata() {
   clearMetadata();
 
   /*
-    The Windows bitmap header goes as follows -- all numbers are in little-endian byte order:
+    The Windows bitmap file header goes as follows -- all numbers are in little-endian byte order:
 
     offset  length   name                   description
     ======  =======  =====================  =======
@@ -70,20 +70,36 @@ void BmpImage::readMetadata() {
      2      4 bytes  bitmap size
      6      4 bytes  reserved
     10      4 bytes  bitmap offset
-    14      4 bytes  header size
-    18      4 bytes  bitmap width
-    22      4 bytes  bitmap height
-    26      2 bytes  plane count
-    28      2 bytes  depth
-    30      4 bytes  compression            0 = none; 1 = RLE, 8 bits/pixel; 2 = RLE, 4 bits/pixel; 3 = bitfield;
-    4 = JPEG; 5 = PNG 34      4 bytes  image size             size of the raw bitmap data, in bytes 38      4
-    bytes  horizontal resolution  (in pixels per meter) 42      4 bytes  vertical resolution    (in pixels per
-    meter) 46      4 bytes  color count 50      4 bytes  important colors       number of "important" colors
+    14      4 bytes  header size            size of the DIB header, which follows immediately
+
+    Two DIB header layouts exist. In a 12-byte BITMAPCOREHEADER (OS/2 1.x and Windows 2.x) the
+    bitmap width and height are stored as 16-bit values right after the header size. In
+    BITMAPINFOHEADER (40 bytes) and all later headers they are 32-bit values at the same place.
   */
-  byte buf[26];
-  if (io_->read(buf, sizeof(buf)) == sizeof(buf)) {
-    pixelWidth_ = getULong(buf + 18, littleEndian);
-    pixelHeight_ = getULong(buf + 22, littleEndian);
+  byte buf[18];
+  if (io_->read(buf, sizeof(buf)) != sizeof(buf)) {
+    return;
+  }
+  const uint32_t headerSize = getULong(buf + 14, littleEndian);
+  if (headerSize < 12) {
+    return;
+  }
+
+  // Read the complete DIB header.
+  byte header[40];
+  io_->seek(-4, BasicIo::cur);
+  // The width and height fields end 12 bytes into the DIB header.
+  if (io_->read(header, headerSize) < 12) {
+    return;
+  }
+  if (headerSize == 12) {
+    // BITMAPCOREHEADER: 16-bit width and height
+    pixelWidth_ = getUShort(header + 4, littleEndian);
+    pixelHeight_ = getUShort(header + 6, littleEndian);
+  } else {
+    // BITMAPINFOHEADER and later: 32-bit width and height
+    pixelWidth_ = getULong(header + 4, littleEndian);
+    pixelHeight_ = getULong(header + 8, littleEndian);
   }
 }
 
