+TEST(BmpImage, readMetadataReadsImageDimensionsFromBitmapCoreHeader) {
+  const std::array<unsigned char, 26> header{
+      'B',  'M',               // Signature                                                         off:0   size:2
+      0x4E, 0x47, 0x0D, 0x0A,  // Size of the BMP file in bytes                                     off:2,  size:4
+      0x1A, 0x0A,              // Reserved                                                          off:6,  size:2
+      0x00, 0x00,              // Reserved                                                          off:8,  size:2
+      0x00, 0x00, 0x00, 0x00,  // Offset of the byte where the bitmap image data can be found       off:10, size:4
+      0x0C, 0x00, 0x00, 0x00,  // Size of this header (12 = BITMAPCOREHEADER)                       off:14, size:4
+      0x00, 0x05,              // The bitmap width in pixels (16 bit)                               off:18, size:2
+      0x20, 0x03,              // The bitmap height in pixels (16 bit)                              off:20, size:2
+      0x01, 0x00,              // The number of color planes                                        off:22, size:2
+      0x18, 0x00,              // The number of bits per pixel                                      off:24, size:2
