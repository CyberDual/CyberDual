diff --git a/src/pcre2_extuni.c b/src/pcre2_extuni.c
index 1b7f04b4b2f38e8896938fa09b18c7147833ae98..541ce48e3f57c447f04842527e2ff31270aff89a 100644
--- a/src/pcre2_extuni.c
+++ b/src/pcre2_extuni.c
@@ -80,7 +80,7 @@ same behaviour.
 Arguments:
   c              the first character
   eptr           pointer to next character
-  start_subject  pointer to start of subject
+  start_subject  earliest subject byte the backwards scan may read
   end_subject    pointer to end of subject
   utf            TRUE if in UTF mode
   xcount         pointer to count of additional characters,
@@ -117,22 +117,33 @@ while (eptr < end_subject)
     {
     int ricount = 0;
     PCRE2_SPTR bptr = eptr - 1;
-    if (utf) BACKCHAR(bptr);
 
-    /* bptr is pointing to the left-hand character */
+    /* bptr is pointing at the previous code unit. Do not walk before
+    start_subject: with PCRE2_MATCH_INVALID_UTF that floor is the start of
+    the checked region, and bytes before it may be continuation units. */
+
+    if (utf)
+      {
+      while (bptr > start_subject && NOT_FIRSTCU(*bptr))
+        bptr--;
+      }
 
     while (bptr > start_subject)
       {
-      bptr--;
+      PCRE2_SPTR prev = bptr - 1;
+
       if (utf)
         {
-        BACKCHAR(bptr);
-        GETCHAR(c, bptr);
+        while (prev > start_subject && NOT_FIRSTCU(*prev))
+          prev--;
+        if (NOT_FIRSTCU(*prev)) break;
+        GETCHAR(c, prev);
         }
       else
-      c = *bptr;
+        c = *prev;
       if (UCD_GRAPHBREAK(c) != ucp_gbRegional_Indicator) break;
       ricount++;
+      bptr = prev;
       }
     if ((ricount & 1) != 0) break;  /* Grapheme break required */
     }
diff --git a/src/pcre2_match.c b/src/pcre2_match.c
index a5a8421f7c219dc66b7fbb87afffe148664bda40..b307262fa623e3888329d1e5877fbb55b6c7bf55 100644
--- a/src/pcre2_match.c
