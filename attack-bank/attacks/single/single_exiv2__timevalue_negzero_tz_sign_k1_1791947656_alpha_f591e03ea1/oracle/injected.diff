+TEST(ATimeValue, keepsSignWhenTimeZoneHourIsNegativeZero) {
+  TimeValue value;
+  ASSERT_EQ(0, value.read("23:55:02-00:30"));
+  ASSERT_EQ(23, value.getTime().hour);
+  ASSERT_EQ(55, value.getTime().minute);
+  ASSERT_EQ(2, value.getTime().second);
+  ASSERT_EQ(0, value.getTime().tzHour);
+  ASSERT_EQ(-30, value.getTime().tzMinute);
+
+  value = TimeValue();
+  ASSERT_EQ(0, value.read("235502-0030"));
+  ASSERT_EQ(23, value.getTime().hour);
+  ASSERT_EQ(55, value.getTime().minute);
+  ASSERT_EQ(2, value.getTime().second);
+  ASSERT_EQ(0, value.getTime().tzHour);
+  ASSERT_EQ(-30, value.getTime().tzMinute);
+
+  value = TimeValue();
+  ASSERT_EQ(0, value.read("23:55:02+00:30"));
+  ASSERT_EQ(0, value.getTime().tzHour);
+  ASSERT_EQ(30, value.getTime().tzMinute);
+
+  value = TimeValue();
+  ASSERT_EQ(0, value.read("235502+0030"));
+  ASSERT_EQ(0, value.getTime().tzHour);
+  ASSERT_EQ(30, value.getTime().tzMinute);
+}
