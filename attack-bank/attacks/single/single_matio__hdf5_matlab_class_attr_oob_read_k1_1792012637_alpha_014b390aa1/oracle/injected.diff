index f9dbfc414f02aad863100456eb614f10d2897ee7..6f411f7766b81bb7ec863cd81cc5a79dc8c05ed3 100644
--- a/src/mat73.c
+++ b/src/mat73.c
@@ -72,6 +72,10 @@ struct ReadGroupInfoIterData
 #define MAX_RANK (3)
 #endif
 
+/* MATLAB_class is a single short name. A larger datatype size is rejected so it
+ * cannot be used as an allocation length. */
+#define MAX_MATLAB_CLASS_LEN (256)
+
 /*===========================================================================
  *  Private functions
  *===========================================================================
@@ -572,7 +576,37 @@ Mat_H5ReadVarInfo(matvar_t *matvar, hid_t dset_id)
         H5Aclose(attr_id);
         return MATIO_E_FAIL_TO_IDENTIFY;
     }
+    /* A variable-length or multi-element MATLAB_class makes H5Tget_size report
+     * only the element width while H5Aread writes the whole attribute. */
+    if ( H5T_STRING != H5Tget_class(type_id) || 0 != H5Tis_variable_str(type_id) ) {
+        H5Tclose(type_id);
+        H5Aclose(attr_id);
+        return MATIO_E_FILE_FORMAT_VIOLATION;
+    }
+    {
+        hid_t space_id;
+        hssize_t npoints;
+
+        space_id = H5Aget_space(attr_id);
+        if ( space_id < 0 ) {
+            H5Tclose(type_id);
+            H5Aclose(attr_id);
+            return MATIO_E_FAIL_TO_IDENTIFY;
+        }
+        npoints = H5Sget_simple_extent_npoints(space_id);
+        H5Sclose(space_id);
+        if ( 1 != npoints ) {
+            H5Tclose(type_id);
+            H5Aclose(attr_id);
+            return MATIO_E_FILE_FORMAT_VIOLATION;
+        }
+    }
     class_len = H5Tget_size(type_id);
+    if ( class_len < 1 || class_len > MAX_MATLAB_CLASS_LEN ) {
+        H5Tclose(type_id);
+        H5Aclose(attr_id);
+        return MATIO_E_FILE_FORMAT_VIOLATION;
+    }
     mem_type_id = H5Tcopy(H5T_C_S1);
     if ( mem_type_id == H5I_INVALID_HID ) {
         H5Tclose(type_id);
@@ -586,7 +620,7 @@ Mat_H5ReadVarInfo(matvar_t *matvar, hid_t dset_id)
         H5Aclose(attr_id);
         return MATIO_E_FAIL_TO_IDENTIFY;
     }
-    class_str = (char *)calloc(class_len + 1, 1);
+    class_str = (char *)calloc(MAX_MATLAB_CLASS_LEN, 1);
     if ( NULL != class_str ) {
         herr_t herr = H5Aread(attr_id, mem_type_id, class_str);
         if ( herr < 0 ) {
