+/* Bytes claimed by a UTF-8 lead. Invalid leads count as a single byte. */
+static size_t
+Utf8SeqLen(mat_uint8_t lead)
+{
+    if ( lead <= 0x7F )
+        return 1;
+    if ( (lead & 0xE0) == 0xC0 )
+        return 2;
+    if ( (lead & 0xF0) == 0xE0 )
+        return 3;
+    if ( (lead & 0xF8) == 0xF0 )
+        return 4;
+    return 1;
+}
+
+/* Reject a UTF-8 payload whose coded sequences run past the stored bytes. */
+static int
+Utf8PayloadStored(const void *data, size_t nbytes)
+{
+    const mat_uint8_t *bytes = (const mat_uint8_t *)data;
+    size_t k = 0;
+
+    if ( bytes == NULL )
+        return MATIO_E_BAD_ARGUMENT;
+
+    while ( k < nbytes ) {
+        size_t need = Utf8SeqLen(bytes[k]);
+        if ( need > 1 ) {
+            size_t i;
+            for ( i = 1; i < need; i++ ) {
+                if ( (bytes[k + i] & 0xC0) != 0x80 || k + i >= nbytes )
+                    return MATIO_E_FILE_FORMAT_VIOLATION;
+            }
+        }
+        k += need;
+    }
+    return MATIO_E_NO_ERROR;
+}
+
+/* Uncompressed bytes still in the file from the current position. */
+static int
+FileBytesRemaining(FILE *fp, size_t *remaining)
+{
+    mat_off_t cur, end;
+
+    cur = ftello(fp);
+    if ( cur < 0 )
+        return MATIO_E_GENERIC_READ_ERROR;
+    if ( fseeko(fp, 0, SEEK_END) != 0 )
+        return MATIO_E_GENERIC_READ_ERROR;
+    end = ftello(fp);
+    if ( fseeko(fp, cur, SEEK_SET) != 0 )
+        return MATIO_E_GENERIC_READ_ERROR;
+    if ( end < cur )
+        return MATIO_E_GENERIC_READ_ERROR;
+    *remaining = (size_t)(end - cur);
+    return MATIO_E_NO_ERROR;
+}
