+/* These functions are variants of the location accessors above that
+   rely on fixed 64bit types rather than XML_Index and XML_Size.  They
+   report correct locations for inputs larger than 2 GiB also on
+   32bit machines and 64bit Windows, i.e. where the types above wrap
+   around unless (non-default and uncommon) XML_LARGE_SIZE is defined.
+
+   Note: XML_GetCurrentLineNumber64 and XML_GetCurrentColumnNumber64
+   return 0 to indicate an error.
+   Note: XML_GetCurrentByteIndex64 returns -1 to indicate an error.
+   Added in Expat 2.9.0.
+*/
+XMLPARSEAPI(long long)
+XML_GetCurrentByteIndex64(XML_Parser parser);
+XMLPARSEAPI(long long)
+XML_GetCurrentByteCount64(XML_Parser parser);
+XMLPARSEAPI(unsigned long long)
+XML_GetCurrentLineNumber64(XML_Parser parser);
+XMLPARSEAPI(unsigned long long)
+XML_GetCurrentColumnNumber64(XML_Parser parser);
+
+/* If XML_CONTEXT_BYTES is >=1, returns the input buffer, sets the
+   integer pointed to by offset to the offset within this buffer of the
+   current parse position, and sets the integer pointed to by size to
+   the size of this buffer (the number of input bytes). Otherwise
+   returns a NULL pointer. Also returns a NULL pointer if a parse isn't
+   active.
+
+   NOTE: The character pointer returned should not be used outside
+   the handler that makes the call.
+   Added in Expat 2.9.0.
+*/
+XMLPARSEAPI(const char *)
+XML_GetInputContext64(XML_Parser parser, long long *offset, long long *size);
+
 /* For backwards compatibility with previous versions. */
 #  define XML_GetErrorLineNumber XML_GetCurrentLineNumber
 #  define XML_GetErrorColumnNumber XML_GetCurrentColumnNumber
