diff --git a/expat/tests/basic_tests.c b/expat/tests/basic_tests.c
index 8f4f0902d5c78f6cf4b49389cc2184d13e61374d..1cefbac539b6552fc354a14446d20c3f40e3391e 100644
--- a/expat/tests/basic_tests.c
+++ b/expat/tests/basic_tests.c
@@ -3965,6 +3965,57 @@ END_TEST
 #undef CDATA_TEXT
 #undef END_ELEMENT
 
+/* Test 64bit position information in handler */
+#define START_ELEMENT_64 "<e>"
+#define CDATA_TEXT_64 "Hello"
+#define END_ELEMENT_64 "</e>"
+static void XMLCALL
+byte_character_handler_64(void *userData, const XML_Char *s, int len) {
+#if XML_CONTEXT_BYTES > 0
+  long long offset, size;
+  const char *buffer;
+  ByteTestData *data = (ByteTestData *)userData;
+
+  UNUSED_P(s);
+  buffer = XML_GetInputContext64(g_parser, &offset, &size);
+  if (buffer == NULL)
+    fail("Failed to get context buffer from 64bit API");
+  if (offset != data->start_element_len)
+    fail("64bit context offset in unexpected position");
+  if (size != data->total_string_len)
+    fail("64bit context size is not full buffer");
+  if (XML_GetCurrentByteIndex64(g_parser) != offset)
+    fail("64bit character byte index incorrect");
+  if (XML_GetCurrentByteCount64(g_parser) != len)
+    fail("64bit character byte count incorrect");
+  if (XML_GetCurrentLineNumber64(g_parser) != 1)
+    fail("64bit character line number incorrect");
+  if (XML_GetCurrentColumnNumber64(g_parser) != data->start_element_len)
+    fail("64bit character column number incorrect");
+#else
+  UNUSED_P(s);
+  UNUSED_P(userData);
+  UNUSED_P(len);
+#endif
+}
+
+START_TEST(test_byte_info_at_cdata_64bit) {
+  const char *text = START_ELEMENT_64 CDATA_TEXT_64 END_ELEMENT_64;
+  ByteTestData data;
+
+  data.start_element_len = (int)strlen(START_ELEMENT_64);
+  data.cdata_len = (int)strlen(CDATA_TEXT_64);
+  data.total_string_len = (int)strlen(text);
+  XML_SetCharacterDataHandler(g_parser, byte_character_handler_64);
+  XML_SetUserData(g_parser, &data);
+  if (XML_Parse(g_parser, text, (int)strlen(text), XML_TRUE) != XML_STATUS_OK)
+    xml_failure(g_parser);
+}
+END_TEST
+#undef START_ELEMENT_64
+#undef CDATA_TEXT_64
+#undef END_ELEMENT_64
+
 /* Test predefined entities are correctly recognised */
 START_TEST(test_predefined_entities) {
   const char *text = "<doc>&lt;&gt;&amp;&quot;&apos;</doc>";
@@ -7191,6 +7242,7 @@ make_basic_test_case(Suite *s) {
   tcase_add_test(tc_basic, test_byte_info_at_end);
