+      <h4 id="XML_GetCurrentByteIndex64">
+        XML_GetCurrentByteIndex64
+      </h4>
+
+      <pre class="fcndec">
+long long XMLCALL
+XML_GetCurrentByteIndex64(XML_Parser p);
+</pre>
+      <div class="fcndef">
+        Return the byte offset of the position. This always corresponds to the values
+        returned by <code><a href=
+        "#XML_GetCurrentLineNumber64">XML_GetCurrentLineNumber64</a></code> and
+        <code><a href=
+        "#XML_GetCurrentColumnNumber64">XML_GetCurrentColumnNumber64</a></code>.
+      </div>
+
+      <p>
+        <strong>Note:</strong> Unlike <code><a href=
+        "#XML_GetCurrentByteIndex">XML_GetCurrentByteIndex</a></code>, this function is
+        not subject to wrapping around on 32bit platforms and 64bit Windows. It has
+        been added in Expat 2.9.0.
+      </p>
+
+      <h4 id="XML_GetCurrentLineNumber64">
+        XML_GetCurrentLineNumber64
+      </h4>
+
+      <pre class="fcndec">
+unsigned long long XMLCALL
+XML_GetCurrentLineNumber64(XML_Parser p);
+</pre>
+      <div class="fcndef">
+        Return the line number of the position. The first line is reported as
+        <code>1</code>.
+      </div>
+
+      <p>
+        <strong>Note:</strong> Unlike <code><a href=
+        "#XML_GetCurrentLineNumber">XML_GetCurrentLineNumber</a></code>, this function
+        is not subject to wrapping around on 32bit platforms and 64bit Windows. It has
+        been added in Expat 2.9.0.
+      </p>
+
+      <h4 id="XML_GetCurrentColumnNumber64">
+        XML_GetCurrentColumnNumber64
+      </h4>
+
+      <pre class="fcndec">
+unsigned long long XMLCALL
+XML_GetCurrentColumnNumber64(XML_Parser p);
+</pre>
+      <div class="fcndef">
+        Return the <em>offset</em>, from the beginning of the current line, of the
+        position. The first column is reported as <code>0</code>.
+      </div>
+
+      <p>
+        <strong>Note:</strong> Unlike <code><a href=
+        "#XML_GetCurrentColumnNumber">XML_GetCurrentColumnNumber</a></code>, this
+        function is not subject to wrapping around on 32bit platforms and 64bit
+        Windows. It has been added in Expat 2.9.0.
+      </p>
+
+      <h4 id="XML_GetCurrentByteCount64">
+        XML_GetCurrentByteCount64
+      </h4>
+
+      <pre class="fcndec">
+long long XMLCALL
+XML_GetCurrentByteCount64(XML_Parser p);
+</pre>
+      <div class="fcndef">
+        Return the number of bytes in the current event. Returns <code>0</code> if the
+        event is inside a reference to an internal entity and for the end-tag event for
+        empty element tags (the later can be used to distinguish empty-element tags from
+        empty elements using separate start and end tags).
+      </div>
+
+      <p>
+        <strong>Note:</strong> Unlike <code><a href=
+        "#XML_GetCurrentByteCount">XML_GetCurrentByteCount</a></code>, this function is
+        not subject to wrapping around for events larger than 2 GiB. It has been added
+        in Expat 2.9.0.
+      </p>
+
+      <h4 id="XML_GetInputContext64">
+        XML_GetInputContext64
+      </h4>
+
+      <pre class="fcndec">
+const char * XMLCALL
+XML_GetInputContext64(XML_Parser p,
+                      long long *offset,
+                      long long *size);
+</pre>
+      <div class="fcndef">
+        <p>
+          Returns the parser's input buffer, sets the integer pointed at by
+          <code>offset</code> to the offset within this buffer of the current parse
+          position, and set the integer pointed at by <code>size</code> to the size of
+          the returned buffer.
+        </p>
+
+        <p>
+          This should only be called from within a handler during an active parse and the
+          returned buffer should only be referred to from within the handler that made
+          the call. This input buffer contains the untranslated bytes of the input.
+        </p>
+
+        <p>
+          Only a limited amount of context is kept, so if the event triggering a call
+          spans over a very large amount of input, the actual parse position may be
+          before the beginning of the buffer.
+        </p>
+
+        <p>
+          If <code>XML_CONTEXT_BYTES</code> is zero, this will always return
+          <code>NULL</code>.
+        </p>
+      </div>
+
+      <p>
+        <strong>Note:</strong> Unlike <code><a href=
+        "#XML_GetInputContext">XML_GetInputContext</a></code>, this function is not
+        subject to wrapping around for buffers larger than 2 GiB. It has been added in
+        Expat 2.9.0.
+      </p>
+
       <h3>
