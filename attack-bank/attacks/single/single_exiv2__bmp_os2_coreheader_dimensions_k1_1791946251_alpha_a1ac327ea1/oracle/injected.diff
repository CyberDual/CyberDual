diff --git a/src/bmpimage.cpp b/src/bmpimage.cpp
index e3377b62895585ac9c1f2ae4780ab52382feaaaf..185e699e8330ead425493ef3d9db7bc598282343 100644
--- a/src/bmpimage.cpp
+++ b/src/bmpimage.cpp
@@ -79,11 +79,29 @@ void BmpImage::readMetadata() {
     4 = JPEG; 5 = PNG 34      4 bytes  image size             size of the raw bitmap data, in bytes 38      4
     bytes  horizontal resolution  (in pixels per meter) 42      4 bytes  vertical resolution    (in pixels per
     meter) 46      4 bytes  color count 50      4 bytes  important colors       number of "important" colors
+
+    OS/2 1.x and Windows 2.x bitmaps use the older 12-byte BITMAPCOREHEADER
+    (a header size of 12), in which the width and the height are 16-bit
+    values and the height follows the width directly.
   */
-  byte buf[26];
+  byte buf[18];
   if (io_->read(buf, sizeof(buf)) == sizeof(buf)) {
-    pixelWidth_ = getULong(buf + 18, littleEndian);
-    pixelHeight_ = getULong(buf + 22, littleEndian);
+    const auto headerSize = getULong(buf + 14, littleEndian);
+    if (headerSize == 12) {
+      // BITMAPCOREHEADER: the dimensions are 16-bit values that follow
+      // the header size field.
+      std::array<byte, 8> core;
+      if (io_->read(core.data(), headerSize) >= core.size()) {
+        pixelWidth_ = getUShort(core.data(), littleEndian);
+        pixelHeight_ = getUShort(core.data() + 2, littleEndian);
+      }
+    } else {
+      std::array<byte, 8> dimensions;
+      if (io_->read(dimensions.data(), dimensions.size()) >= dimensions.size()) {
+        pixelWidth_ = getULong(dimensions.data(), littleEndian);
+        pixelHeight_ = getULong(dimensions.data() + 4, littleEndian);
+      }
+    }
   }
 }
 
