@@ -0,0 +1,35 @@
+---
+c: Copyright (C) The libssh2 project and its contributors.
+SPDX-License-Identifier: BSD-3-Clause
+Title: libssh2_channel_has_exit_status
+Section: 3
+Source: libssh2
+See-also:
+  - libssh2_channel_get_exit_status(3)
+  - libssh2_channel_get_exit_signal(3)
+---
+
+# NAME
+
+libssh2_channel_has_exit_status - tell whether an exit status arrived
+
+# SYNOPSIS
+
+~~~c
+#include <libssh2.h>
+
+int libssh2_channel_has_exit_status(LIBSSH2_CHANNEL *channel)
+~~~
+
+# DESCRIPTION
+
+*channel* - Channel stream to query.
+
+*libssh2_channel_get_exit_status(3)* returns 0 both when the remote
+process exited with status 0 and when the channel never received an
+exit-status request. This function reports whether that request arrived.
+
+# RETURN VALUE
+
+Returns 1 when an exit-status request has been received for *channel*,
+and 0 if it has not or if *channel* is NULL.
