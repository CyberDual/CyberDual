index 79f265050fc0cfac2f514576f9468f857f9da267..e6fbd8ecd6a97d8a647838d940ba9300d288b2c4 100644
--- a/src/hb-ot-cff1-table.hh
+++ b/src/hb-ot-cff1-table.hh
@@ -673,6 +673,7 @@ struct cff1_top_dict_interp_env_t : num_interp_env_t
 
   unsigned int prev_offset;
   unsigned int last_offset;
+  unsigned int arg_offsets[8];  /* start offset of each operand on the arg stack */
 };
 
 struct name_dict_values_t
@@ -773,8 +774,7 @@ struct cff1_top_dict_opset_t : top_dict_opset_t<cff1_top_dict_val_t>
 {
   static void process_op (op_code_t op, cff1_top_dict_interp_env_t& env, cff1_top_dict_values_t& dictval)
   {
-    cff1_top_dict_val_t  val;
-    val.last_arg_offset = (env.last_offset-1) - dictval.opStart;  /* offset to the last argument */
+    cff1_top_dict_val_t  val {};
 
     switch (op) {
       case OpCode_version:
@@ -814,10 +814,16 @@ struct cff1_top_dict_opset_t : top_dict_opset_t<cff1_top_dict_val_t>
 	break;
 
       case OpCode_ROS:
-	dictval.ros_supplement = env.argStack.pop_uint ();
-	dictval.nameSIDs[name_dict_values_t::ordering] = env.argStack.pop_uint ();
-	dictval.nameSIDs[name_dict_values_t::registry] = env.argStack.pop_uint ();
-	env.clear_args ();
+	{
+	  unsigned int nargs = env.argStack.get_count ();
+	  dictval.ros_supplement = env.argStack.pop_uint ();
+	  dictval.nameSIDs[name_dict_values_t::ordering] = env.argStack.pop_uint ();
+	  dictval.nameSIDs[name_dict_values_t::registry] = env.argStack.pop_uint ();
+	  env.clear_args ();
+	  if (unlikely (env.in_error ())) return;
+	  /* offset to the last argument, consumed only when serializing ROS */
+	  val.last_arg_offset = env.arg_offsets[nargs - 1] - dictval.opStart;
+	}
 	break;
 
       case OpCode_Encoding:
@@ -845,6 +851,9 @@ struct cff1_top_dict_opset_t : top_dict_opset_t<cff1_top_dict_val_t>
 
       default:
 	env.last_offset = env.str_ref.get_offset ();
+	/* Track the start offset of the operand about to be pushed. */
+	if (env.argStack.get_count () < hb_array (env.arg_offsets).length)
+	  env.arg_offsets[env.argStack.get_count ()] = env.last_offset - 1;
 	top_dict_opset_t<cff1_top_dict_val_t>::process_op (op, env, dictval);
 	/* Record this operand below if stack is empty, otherwise done */
 	if (!env.argStack.is_empty ()) return;
