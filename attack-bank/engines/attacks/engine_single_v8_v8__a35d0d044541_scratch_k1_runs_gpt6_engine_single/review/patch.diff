@@ -2502,9 +2502,26 @@ bool PerIsolateData::HasRunningSubscribedWorkers() {
 }
 
 void PerIsolateData::RegisterWorker(std::shared_ptr<Worker> worker) {
+  owned_workers_.insert(worker);
   registered_workers_.insert(std::move(worker));
 }
 
+void PerIsolateData::ShutdownWorkers() {
+  std::vector<std::shared_ptr<Worker>> workers(owned_workers_.begin(),
+                                                owned_workers_.end());
+  reinterpret_cast<i::Isolate*>(isolate_)
+      ->main_thread_local_isolate()
+      ->ExecuteMainThreadWhileParked([&workers](const i::ParkedScope& parked) {
+        for (const auto& worker : workers) {
+          worker->TerminateAndWaitForThread(parked);
+        }
+      });
+  for (const auto& worker : workers) worker->DiscardMessages();
+  worker_message_callbacks_.clear();
+  registered_workers_.clear();
+  owned_workers_.clear();
+}
