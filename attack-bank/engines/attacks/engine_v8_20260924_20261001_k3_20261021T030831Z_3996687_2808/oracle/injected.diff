+void Shell::CreateIterableInterceptorObject(
+    const FunctionCallbackInfo<Value>& info) {
+  Isolate* isolate = info.GetIsolate();
+  Local<Context> context = isolate->GetCurrentContext();
+  Local<FunctionTemplate> ctor = FunctionTemplate::New(isolate);
+  Local<ObjectTemplate> templ = ctor->InstanceTemplate();
+  templ->SetHandler(IndexedPropertyHandlerConfiguration(
+      D8IndexedGetter, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
+      nullptr, D8IndexedIterableToListCallback));
+
+  Local<FunctionTemplate> length_getter =
+      FunctionTemplate::New(isolate, &D8LengthGetter);
+  ctor->PrototypeTemplate()->SetAccessorProperty(
+      String::NewFromUtf8Literal(isolate, "bar"), length_getter);
+  ctor->PrototypeTemplate()->Set(String::NewFromUtf8Literal(isolate, "foo"),
+                                  Integer::New(isolate, 42));
+  ctor->PrototypeTemplate()->Set(String::NewFromUtf8Literal(isolate, "answer"),
+                                  Integer::New(isolate, 7));
+  ctor->PrototypeTemplate()->SetIntrinsicDataProperty(
+      Symbol::GetIterator(isolate), Intrinsic::kArrayProto_values);
+  ctor->PrototypeTemplate()->SetAccessorProperty(
+      String::NewFromUtf8Literal(isolate, "length"), length_getter);
+
+  Local<Function> fn;
+  if (!ctor->GetFunction(context).ToLocal(&fn)) return;
+  Local<Object> instance;
+  if (!fn->NewInstance(context).ToLocal(&instance)) return;
+  info.GetReturnValue().Set(instance);
+}
