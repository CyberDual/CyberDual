+void D8IndexedIterableToListCallback(
+    const v8::PropertyCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Value> elements[3] = {
+      v8::Integer::New(isolate, 11), v8::Integer::New(isolate, 22),
+      v8::Integer::New(isolate, 33)};
+  info.GetReturnValue().Set(v8::Array::New(isolate, elements, 3));
+}
+
+void D8LengthGetter(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  info.GetReturnValue().Set(static_cast<uint32_t>(3));
+}
