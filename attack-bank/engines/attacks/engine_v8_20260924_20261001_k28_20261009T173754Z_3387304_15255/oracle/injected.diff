index 2ae70c3fe7e..8d595b8bf00 100644
--- a/src/regexp/regexp-compiler-tonode.cc
+++ b/src/regexp/regexp-compiler-tonode.cc
@@ -1001,7 +1001,14 @@ void Disjunction::RationalizeConsecutiveAtoms(Compiler* compiler) {
       unibrow::uchar new_prefix = alt_atom->data().at(0);
       if (!Equals(ignore_case, canonicalize, new_prefix, common_prefix)) break;
 #endif  // V8_INTL_SUPPORT
-      prefix_length = std::min(prefix_length, alt_atom->length());
+      // The shared prefix cannot be longer than the shortest alternative. When
+      // reading forward we can bound it by the raw atom length right away. The
+      // backward matcher compares case-folded code units from the opposite end
+      // (see TextNode::GetCaseIndependentLetters), so there the common length is
+      // settled by the per-character comparison below instead.
+      if (!compiler->read_backward()) {
+        prefix_length = std::min(prefix_length, alt_atom->length());
+      }
       i++;
     }
     if (i > first_with_prefix + 2) {
@@ -1147,15 +1154,18 @@ Node* Disjunction::ToNodeImpl(Compiler* compiler, Node* on_success) {
   ZoneList<Tree*>* alternatives = this->alternatives();
 
   if (alternatives->length() > 2) {
-    if (!compiler->read_backward() && v8_flags.regexp_optimization) {
-      // We deliberately disable SortConsecutiveAtoms and
-      // RationalizeConsecutiveAtoms in lookbehinds rather than keep
-      // rationalizing already-adjacent runs. Lookbehind disjunctions must keep
-      // source order. The code generator already turns off quick checks,
-      // Boyer-Moore and first-char dispatch when reading backward, so the
-      // passes buy almost nothing there.
-      bool found_consecutive_atoms = SortConsecutiveAtoms(compiler);
