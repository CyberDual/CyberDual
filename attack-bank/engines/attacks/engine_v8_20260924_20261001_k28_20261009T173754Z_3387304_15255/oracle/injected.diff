+    if (v8_flags.regexp_optimization) {
+      // SortConsecutiveAtoms reorders alternatives by first character, which
+      // changes the match result in a lookbehind (where source order is
+      // significant), so sorting stays forward-only. Rationalizing an
+      // already-adjacent run only factors out a shared prefix and preserves the
+      // order of the alternatives, so it is applied in both directions.
+      if (!compiler->read_backward()) {
+        bool found_consecutive_atoms = SortConsecutiveAtoms(compiler);
+        if (found_consecutive_atoms) RationalizeConsecutiveAtoms(compiler);
+      } else {
+        RationalizeConsecutiveAtoms(compiler);
+      }
       TRACE_WITH_NODE("* After rationalizing consecutive atoms: ", this);
     }
     FixSingleCharacterDisjunctions(compiler);
