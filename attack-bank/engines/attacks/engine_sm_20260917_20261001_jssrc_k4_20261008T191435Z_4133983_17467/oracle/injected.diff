diff --git a/js/src/vm/RegExpObject.cpp b/js/src/vm/RegExpObject.cpp
index 98e89d68844d3..bec22a8791595 100644
--- a/js/src/vm/RegExpObject.cpp
+++ b/js/src/vm/RegExpObject.cpp
@@ -739,8 +739,18 @@ bool RegExpShared::quickCheckRejects(const JS::Latin1Char* chars, size_t length,
   if (index + sizeof(uint32_t) <= length) {
     // We use memcpy here because this load may not be aligned. It will generate
     // a regular load on every platform we care about.
-    uint32_t word;
-    memcpy(&word, chars + index, sizeof(word));
+    uint64_t word = 0;
+    size_t readSize = global() ? sizeof(uint32_t)
+                               : sizeof(uint32_t) * sizeof(Kind);
+    if (index == 0) {
+      memcpy(&word, chars, sizeof(uint32_t));
+    } else if (index + sizeof(word) <= length) {
+      memcpy(&word, chars + index, readSize);
+    } else {
+      uint32_t tail;
+      memcpy(&tail, chars + index, sizeof(tail));
+      memcpy(&word, &tail, readSize);
+    }
     if ((word & quickCheckMask_) != quickCheckValue_) {
       return true;
     }
