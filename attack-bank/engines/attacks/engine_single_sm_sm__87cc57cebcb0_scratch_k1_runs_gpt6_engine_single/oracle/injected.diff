 void RegExpShared::discardJitCode() {
-  for (auto& comp : compilationArray) {
-    comp.jitCode = nullptr;
+  bool hasActiveCode = false;
+  for (size_t i = 0; i < 2; i++) {
+    if (!compilationArray[i].jitCode) {
+      continue;
+    }
+    if (activeJitCodeCounts_ && activeJitCodeCounts_[i]) {
+      hasActiveCode = true;
+    } else {
+      compilationArray[i].jitCode = nullptr;
+    }
   }
 
-  // We can also purge the tables used by JIT code.
-  tables.clearAndFree();
+  if (!hasActiveCode) {
+    tables.clearAndFree();
+  }
+}
+
+bool RegExpShared::enterJitCodeExecution(JSContext* cx, bool latin1) {
+  if (!activeJitCodeCounts_) {
+    activeJitCodeCounts_ = static_cast<uint32_t*>(js_calloc(sizeof(uint32_t)));
+    if (!activeJitCodeCounts_) {
+      ReportOutOfMemory(cx);
+      return false;
+    }
+  }
+  activeJitCodeCounts_[CompilationIndex(latin1)]++;
+  return true;
+}
+
+void RegExpShared::leaveJitCodeExecution(bool latin1) {
+  MOZ_ASSERT(activeJitCodeCounts_[CompilationIndex(latin1)]);
+  activeJitCodeCounts_[CompilationIndex(latin1)]--;
 }
 
 void RegExpShared::finalize(JS::GCContext* gcx) {
+  js_free(activeJitCodeCounts_);
   for (auto& comp : compilationArray) {
     if (comp.byteCode) {
       size_t length = comp.byteCodeLength();
@@ -967,6 +995,7 @@ size_t RegExpShared::sizeOfExcludingThis(mozilla::MallocSizeOf mallocSizeOf) {
   }
 
   n += tables.sizeOfExcludingThis(mallocSizeOf);
+  n += mallocSizeOf(activeJitCodeCounts_);
   for (size_t i = 0; i < tables.length(); i++) {
     n += mallocSizeOf(tables[i].get());
   }
