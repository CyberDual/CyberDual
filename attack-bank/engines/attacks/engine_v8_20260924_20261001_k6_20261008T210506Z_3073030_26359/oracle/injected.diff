+  if (atom->length() == 1) return true;
+  return IsEitherUnicode(flags) && atom->length() == 2 &&
+         unibrow::Utf16::IsLeadSurrogate(atom->data().at(0)) &&
+         unibrow::Utf16::IsTrailSurrogate(atom->data().at(1));
