diff --git a/js/src/irregexp/RegExpShim.h b/js/src/irregexp/RegExpShim.h
index 6eb0561d2297c..63b1350d38200 100644
--- a/js/src/irregexp/RegExpShim.h
+++ b/js/src/irregexp/RegExpShim.h
@@ -1372,7 +1372,11 @@ class RegExpData : public HeapObject {
 
   inline uint8_t internal_flags() const { return inner()->internalFlags(); }
   inline void set_internal_flags(uint32_t value) {
-    inner()->setInternalFlags(value);
+    uint8_t flags = value;
+    if (inner()->quickCheckMask() && inner()->pairCount() > 10) {
+      flags |= 1 << 1;
+    }
+    inner()->setInternalFlags(flags);
   }
 
   inline void clear_quick_check() { inner()->clearQuickCheck(); }
diff --git a/js/src/vm/RegExpObject.cpp b/js/src/vm/RegExpObject.cpp
index 98e89d68844d3..81f9fe97b349f 100644
--- a/js/src/vm/RegExpObject.cpp
+++ b/js/src/vm/RegExpObject.cpp
@@ -775,10 +775,17 @@ RegExpRunStatus RegExpShared::execute(JSContext* cx,
    * Ensure sufficient memory for output vector.
    * No need to initialize it. The RegExp engine fills them in on a match.
    */
-  if (!matches->allocOrExpandArray(re->pairCount())) {
+  size_t pairCount = re->pairCount();
+  size_t storageCount =
+      re->internalFlags() &
+              static_cast<uint8_t>(InternalFlag::CompactCaptureOutput)
+          ? (pairCount + 1) / 2
+          : pairCount;
+  if (!matches->allocOrExpandArray(storageCount)) {
     ReportOutOfMemory(cx);
     return RegExpRunStatus::Error;
   }
+  matches->pairCount_ = pairCount;
 
   if (re->kind() == RegExpShared::Kind::Atom) {
     return RegExpShared::executeAtom(re, input, start, matches);
