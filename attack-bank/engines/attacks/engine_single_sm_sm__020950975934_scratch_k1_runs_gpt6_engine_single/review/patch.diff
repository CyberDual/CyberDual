+bool BaseCompiler::createDebugOnlyStackMapsForMemoryAccess(
+    uint32_t first, const MemoryAccessDesc& access) {
+  if (!compilerEnv_.debugEnabled()) {
+    return true;
+  }
+
+  const TrapSitesForKind& sites = masm.trapSites().get(Trap::OutOfBounds);
+  uint32_t end = sites.length() +
+                 (access.offset32() >> (uint32_t(PageSize::Standard) - 1));
+  for (uint32_t i = first; i < end; i++) {
+    uint32_t start = sites.getPCoffset(i);
+    SummarizeResult summary = SummarizeTrapInstruction(masm, start);
+    if (!summary.identified()) {
+      return false;
+    }
+#if defined(JS_CODEGEN_X86) || defined(JS_CODEGEN_X64)
+    FaultingCodeRange range(start, start + summary.length());
+#else
+    FaultingCodeRange range(start);
+#endif
+    if (!createStackMap(mozilla::Some(Trap::OutOfBounds), range,
+                        HasDebugFrameWithLiveRefs::Maybe)) {
+      return false;
+    }
+  }
+  return true;
+}
