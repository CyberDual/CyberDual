 static bool WasmParsedNameSection(JSContext* cx, unsigned argc, Value* vp) {
-  return WasmReturnFlag(cx, argc, vp, Flag::ParsedNameSection);
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (!args.get(1).isBoolean() || !args[1].toBoolean()) {
+    return WasmReturnFlag(cx, argc, vp, Flag::ParsedNameSection);
+  }
+
+  if (!args.get(0).isObject()) {
+    JS_ReportErrorASCII(cx, "argument is not an object");
+    return false;
+  }
+  Rooted<WasmModuleObject*> module(
+      cx, args[0].toObject().maybeUnwrapIf<WasmModuleObject>());
+  if (!module) {
+    JS_ReportErrorASCII(cx, "argument is not a WebAssembly.Module");
+    return false;
+  }
+
+  const auto& meta = module->module().codeMeta();
+  if (!meta.nameSection) {
+    args.rval().setUndefined();
+    return true;
+  }
+
+  const auto& name = meta.nameSection->moduleName;
+  const auto& payload =
+      module->module().code().codeTailMeta().nameSectionPayload->vector;
+  JSString* str = JS_NewStringCopyN(
+      cx, reinterpret_cast<const char*>(payload.begin()) +
+              name.offsetInNamePayload,
+      name.length);
+  if (!str) {
+    return false;
+  }
+  args.rval().setString(str);
+  return true;
 }
 
